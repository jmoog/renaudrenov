---
// En-tête (design modèle artisan) : fin bandeau d'accent orange en haut,
// en-tête blanc épuré avec filet séparateur, logo circulaire + marque à
// gauche, navigation à séparateurs verticaux, utilitaires à droite
// (téléphone + bouton Devis). Menu tiroir sur mobile.
// Nav desktop réduite aux pages principales ; le tiroir mobile liste tout.
import { SITE } from '../data/site.ts';
import services from '../data/services.json';
import FlecheRonde from './FlecheRonde.astro';

// Menu desktop : 4 prestations phares avec leur libellé d'origine
// (labelNav de services.json) ; le tiroir mobile liste les 6.
const menuServices = services.filter((s) =>
  ['nettoyage-demoussage-toiture', 'reparation-toiture', 'renovation-toiture', 'zinguerie'].includes(s.slug)
);
---
<div class="entete-accent" aria-hidden="true"></div>
<header class="entete">
  <div class="conteneur entete__int">
    <a href="/" class="entete__marque" aria-label={`${SITE.nom} — retour à l'accueil`}>
      <img
        class="entete__logo"
        src="/images/logo/logo-renaud-renov-256.webp"
        width="256"
        height="256"
        alt={`Logo ${SITE.nom} — ${SITE.slogan}`}
        fetchpriority="high"
      />
    </a>

    <nav class="entete__nav" aria-label="Navigation principale">
      <ul class="entete__liens">
        {menuServices.map((s) => (
          <li><a href={s.href}>{s.labelNav}</a></li>
        ))}
        <li><a href="/a-propos/">À propos</a></li>
      </ul>
    </nav>

    <div class="entete__actions">
      <a href={SITE.telHref} class="entete__tel">
        <svg class="icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 3.5h-2A1.5 1.5 0 0 0 3 5.2C3.4 13 11 20.6 18.8 21a1.5 1.5 0 0 0 1.7-1.5v-2a1.5 1.5 0 0 0-1.3-1.5l-2.5-.35a1.5 1.5 0 0 0-1.4.6l-.7.95a11.5 11.5 0 0 1-4.9-4.9l.95-.7a1.5 1.5 0 0 0 .6-1.4l-.35-2.5a1.5 1.5 0 0 0-1.5-1.3Z"/><path d="M14.5 3.6a5.5 5.5 0 0 1 4.9 4.9"/><path d="M14 7a2.4 2.4 0 0 1 2 2"/></svg>
        <span>{SITE.tel}</span>
      </a>
      <span class="entete__sep" aria-hidden="true"></span>
      <a href="/devis-gratuit/" class="btn btn--rouge entete__devis">Devis gratuit<FlecheRonde /></a>
    </div>

    <button class="entete__burger" type="button" aria-expanded="false" aria-controls="menu-mobile">
      <span class="visuallyhidden">Ouvrir le menu</span>
      <svg class="icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
  </div>

  <div class="entete__drawer" id="menu-mobile" hidden>
    <a href="/">Accueil</a>
    {services.map((s) => (
      <a href={s.href}>{s.labelNav}</a>
    ))}
    <a href="/a-propos/">À propos</a>
    <a href={SITE.telHref} class="entete__drawer-tel">
      <svg class="icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 3.5h-2A1.5 1.5 0 0 0 3 5.2C3.4 13 11 20.6 18.8 21a1.5 1.5 0 0 0 1.7-1.5v-2a1.5 1.5 0 0 0-1.3-1.5l-2.5-.35a1.5 1.5 0 0 0-1.4.6l-.7.95a11.5 11.5 0 0 1-4.9-4.9l.95-.7a1.5 1.5 0 0 0 .6-1.4l-.35-2.5a1.5 1.5 0 0 0-1.5-1.3Z"/><path d="M14.5 3.6a5.5 5.5 0 0 1 4.9 4.9"/><path d="M14 7a2.4 2.4 0 0 1 2 2"/></svg>
      {SITE.tel}
    </a>
    <a href={SITE.telUrgenceHref} class="entete__drawer-urgence">Urgence : {SITE.telUrgence}</a>
    <a href="/devis-gratuit/" class="btn btn--rouge">Devis gratuit<FlecheRonde /></a>
  </div>
</header>

<style>
  /* Fin bandeau d'accent — l'orange du logo */
  .entete-accent { height: 5px; background: var(--rouge); }

  .entete {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--blanc);
    border-bottom: 1px solid var(--gris-200);
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }
  .entete--cachee { transform: translateY(-100%); }

  .entete__int {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-block: 0.65rem;
  }

  /* Logo circulaire (il porte déjà le nom de la marque) */
  .entete__marque {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }
  .entete__logo { display: block; height: 68px; width: 68px; }

  /* Navigation à séparateurs verticaux */
  .entete__nav { display: flex; margin-left: auto; }
  .entete__liens {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .entete__liens li + li { border-left: 1px solid var(--gris-200); }
  .entete__liens a {
    display: block;
    padding: 0.35rem 0.95rem;
    color: var(--bleu);
    font-weight: 500;
    font-size: var(--fs-sm);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--transition);
  }
  .entete__liens a:hover { color: var(--rouge-fonce); }

  /* Utilitaires à droite */
  .entete__actions {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }
  .entete__tel {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    color: var(--bleu);
    font-weight: 600;
    font-size: var(--fs-base);
    text-decoration: none;
    white-space: nowrap;
  }
  .entete__tel .icone { color: var(--rouge); width: 1.15rem; height: 1.15rem; }
  .entete__tel:hover { color: var(--rouge-fonce); }
  .entete__sep { width: 1px; height: 28px; background: var(--gris-200); }
  .entete__devis { padding: 0.6em 1.3em; white-space: nowrap; }

  /* Resserrement intermédiaire */
  @media (max-width: 1300px) and (min-width: 1101px) {
    .entete__liens a { padding-inline: 0.7rem; font-size: var(--fs-sm); }
    .entete__int { gap: 1rem; }
    .entete__actions { gap: 0.8rem; }
  }

  /* Burger (mobile) */
  .entete__burger {
    display: none;
    margin-left: auto;
    background: none;
    border: none;
    color: var(--bleu);
    padding: 0.4rem;
    cursor: pointer;
  }
  .entete__burger .icone { width: 1.9rem; height: 1.9rem; }

  /* Tiroir mobile */
  .entete__drawer { display: none; }
  .entete__drawer:not([hidden]) {
    display: flex;
    flex-direction: column;
    padding: 0.5rem 1rem 1.3rem;
    border-top: 1px solid var(--gris-200);
  }
  .entete__drawer a:not(.btn) {
    padding: 0.95em 0.2em;
    color: var(--bleu);
    font-weight: 600;
    font-size: var(--fs-base);
    text-decoration: none;
    border-bottom: 1px solid var(--gris-100);
  }
  .entete__drawer-tel { display: flex; align-items: center; gap: 0.5em; }
  .entete__drawer-tel .icone { color: var(--rouge); width: 1.15rem; height: 1.15rem; }
  .entete__drawer a.entete__drawer-urgence { font-size: var(--fs-base); color: var(--gris-700); }
  .entete__drawer .btn { margin-top: 1rem; width: auto; align-self: center; padding-inline: 2em; }

  /* Bascule desktop / mobile */
  @media (max-width: 1100px) {
    .entete__nav,
    .entete__actions { display: none; }
    .entete__burger { display: inline-flex; }
    .entete__logo { height: 56px; width: 56px; }
  }
</style>

<script>
  const burger = document.querySelector('.entete__burger');
  const drawer = document.getElementById('menu-mobile');
  burger?.addEventListener('click', () => {
    const ouvert = drawer?.hasAttribute('hidden');
    if (ouvert) drawer?.removeAttribute('hidden');
    else drawer?.setAttribute('hidden', '');
    burger.setAttribute('aria-expanded', String(Boolean(ouvert)));
  });

  const entete = document.querySelector('.entete');
  const mobile = window.matchMedia('(max-width: 1100px)');
  let tick = false;
  window.addEventListener('scroll', () => {
    if (tick) return;
    tick = true;
    requestAnimationFrame(() => {
      const cacher = mobile.matches && window.scrollY > 900 && drawer?.hasAttribute('hidden');
      entete?.classList.toggle('entete--cachee', Boolean(cacher));
      tick = false;
    });
  }, { passive: true });
</script>
