---
// Footer (design modèle artisan) : 4 blocs — marque + labels officiels,
// services, zones d'intervention (toutes les pages villes), contact avec
// boutons — et mention légale. À la place des badges SVG du modèle : les
// deux logos officiels (Artisan CMA 28 lié à cma28.fr + Garantie décennale).
import { SITE } from '../data/site.ts';
import services from '../data/services.json';
import villes from '../data/villes.json';
import reviews from '../data/reviews.json';
import LogoGoogle from './LogoGoogle.astro';
import FlecheRonde from './FlecheRonde.astro';

// Villes dont la page dédiée existe : elles s'affichent en lien cliquable.
const villesPubliees = villes.map((v) => v.slug);
// Les horaires cassaient en fin de ligne au milieu de « 20 h 00 » : on rend
// insécables les espaces internes des heures.
const horairesInsecables = SITE.horaires.replace(/(\d+)\s*h\s*(\d+)/g, '$1\u00a0h\u00a0$2');
---
<footer class="pied">
  <div class="conteneur pied__grille">
    <div class="pied__bloc pied__marque">
      <img
        class="pied__logo"
        src="/images/logo/logo-renaud-renov-256.webp"
        width="96"
        height="96"
        alt={`Logo ${SITE.nom} — ${SITE.slogan}`}
        loading="lazy"
      />
      <p><strong>{SITE.nom}</strong><br />{SITE.slogan}</p>
      <p>{SITE.rue}<br />{SITE.cp} {SITE.ville}</p>
      <p class="pied__note">
        <LogoGoogle taille={18} />
        <span class="pied__etoiles" aria-hidden="true">★★★★★</span> {reviews.note.toLocaleString('fr-FR')}/5 · {reviews.nombre} avis Google
      </p>
      <p class="pied__note-lien">
        <a href={SITE.googleAvis} rel="noopener" target="_blank">Lire les avis Google</a>
      </p>

      <ul class="pied__badges">
        <li class="pied__badge">
          <a href="https://www.cma28.fr/" target="_blank" rel="noopener" aria-label="Chambre de Métiers et de l'Artisanat d'Eure-et-Loir">
            <img src="/images/labels/artisan-cma28.webp" alt="Artisan — Chambre de Métiers et de l'Artisanat d'Eure-et-Loir" width="320" height="228" class="pied__badge-img pied__badge-img--artisan" loading="lazy" />
          </a>
        </li>
        <li class="pied__badge">
          <img src="/images/labels/garantie-decennale-10-ans.webp" alt="Garantie décennale 10 ans" width="220" height="220" class="pied__badge-img" loading="lazy" />
        </li>
      </ul>
    </div>

    <nav class="pied__bloc" aria-label="Services">
      <h2>Services</h2>
      <ul>
        {services.map((s) => (
          <li><a href={s.href}>{s.labelNav}</a></li>
        ))}
        {/* Le nettoyage de façade ne figure pas dans services.json (liste des
            6 prestations arrêtée avec le client), mais la page existe : on
            l'ajoute ici pour que le footer couvre bien tous les services. */}
        <li><a href="/nettoyage-facade-28/">Nettoyage de façade</a></li>
      </ul>
    </nav>

    <nav class="pied__bloc" aria-label="Zones d'intervention">
      <h2>Zones d’intervention</h2>
      <ul>
        {villes.map((v) => (
          <li>
            {villesPubliees.includes(v.slug)
              ? <a href={`/villes/${v.slug}/`}>{v.nom}</a>
              : v.nom}
          </li>
        ))}
      </ul>
    </nav>

    <nav class="pied__bloc pied__contact" aria-label="Contact">
      <h2>Contact</h2>
      <ul class="pied__coords">
        <li>
          <svg class="icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          <span>{horairesInsecables}</span>
        </li>
        <li>
          <svg class="icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 7 8.5 6 8.5-6"/></svg>
          <a class="pied__mail" href={`mailto:${SITE.email}`}>{SITE.email.split('@')[0]}<wbr />@{SITE.email.split('@')[1]}</a>
        </li>
        <li>
          <svg class="icone" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 9h3l.4-3H14V4.3c0-.9.3-1.3 1.3-1.3H17.5V0.2C17.1.1 16 0 14.8 0 12.2 0 10.6 1.5 10.6 4v2H8v3h2.6v11H14V9Z"/></svg>
          <a href={SITE.facebook} rel="noopener" target="_blank">Facebook</a>
        </li>
      </ul>
      <div class="pied__actions">
        <a href="/devis-gratuit/" class="btn btn--rouge pied__btn-intervention">Demander une intervention<FlecheRonde /></a>
        <a href={SITE.telHref} class="btn btn--blanc">
          <svg class="icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 3.5h-2A1.5 1.5 0 0 0 3 5.2C3.4 13 11 20.6 18.8 21a1.5 1.5 0 0 0 1.7-1.5v-2a1.5 1.5 0 0 0-1.3-1.5l-2.5-.35a1.5 1.5 0 0 0-1.4.6l-.7.95a11.5 11.5 0 0 1-4.9-4.9l.95-.7a1.5 1.5 0 0 0 .6-1.4l-.35-2.5a1.5 1.5 0 0 0-1.5-1.3Z"/><path d="M14.5 3.6a5.5 5.5 0 0 1 4.9 4.9"/><path d="M14 7a2.4 2.4 0 0 1 2 2"/></svg>
          {SITE.tel}
        </a>
      </div>
    </nav>
  </div>

  <div class="pied__legal">
    <p><span>{SITE.nomLegal} — {SITE.slogan}.</span> <span>Garantie décennale.</span></p>
    <ul class="pied__legal-liens">
      <li><a href="/plan-du-site/">Plan du site</a></li>
      <li><a href="/mentions-legales/">Mentions légales</a></li>
    </ul>
  </div>
</footer>

<style>
  .pied {
    background: var(--bleu-fonce);
    color: rgba(255, 255, 255, 0.85);
    margin-top: auto;
    font-size: var(--fs-sm);
    border-top: 3px solid var(--rouge);
  }

  .pied__grille {
    display: grid;
    gap: 2.5rem;
    padding-block: 3rem;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }
  .pied__logo {
    display: block;
    height: 84px;
    width: 84px;
    margin-bottom: 0.6rem;
    border-radius: 50%;
    background: var(--blanc);
  }
  .pied__bloc h2 {
    color: var(--blanc);
    font-size: var(--fs-lg);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 1rem;
  }
  .pied__bloc ul { list-style: none; padding: 0; display: grid; gap: 0.4rem; }
  .pied a:not(.btn) { color: rgba(255, 255, 255, 0.85); text-decoration: none; }
  .pied a:not(.btn):hover { color: var(--rouge); text-decoration: underline; }
  .pied__marque p { margin-block: 0.5rem; }
  .pied__etoiles { color: var(--etoile); letter-spacing: 0.1em; }
  .pied__note { font-weight: 600; color: var(--blanc); }
  .pied__note-lien { margin-top: 0.25rem !important; }
  .pied__note-lien a { text-decoration: underline !important; }

  /* Labels officiels (à la place des badges SVG du modèle) :
     chaque logo sur sa pastille blanche */
  .pied__badges {
    list-style: none;
    padding: 0;
    margin-top: 1.2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem;
  }
  .pied__badge a { display: inline-flex; }
  .pied__badge a:hover { opacity: 0.85; }
  .pied__badge-img {
    display: block;
    width: auto;
    height: 64px;
    background: var(--blanc);
    border-radius: var(--rayon);
    padding: 0.45rem 0.7rem;
  }
  .pied__badge-img--artisan { height: 60px; }

  /* Colonne contact : chaque coordonnée sur une ligne icône + texte,
     interlignage resserré (le rythme par défaut aérait trop la colonne). */
  .pied__coords { gap: 0.7rem !important; }
  .pied__coords li {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 0.6rem;
    line-height: 1.4;
  }
  .pied__coords .icone {
    width: 1.05em;
    height: 1.05em;
    margin-top: 0.15em;
    color: var(--rouge);
  }
  .pied__mail { overflow-wrap: anywhere; }

  /* Boutons de contact : LARGEUR NATURELLE, jamais étirés.
     Règle client absolue — aucun bouton du site ne prend toute la largeur.
     `justify-items` (et non `width: 100%`) commande l'alignement : les
     boutons se dimensionnent sur leur libellé et se centrent sur mobile. */
  .pied__actions {
    display: grid;
    justify-items: start;
    gap: 0.6rem;
    margin-top: 1.3rem;
    max-width: 18rem;
  }
  .pied__actions .btn {
    width: auto;
    justify-content: center;
    text-align: center;
    text-wrap: balance;
  }
  .pied__btn-intervention { font-size: var(--fs-sm); }

  .pied__legal {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    text-align: center;
    padding: 1.2rem 1rem;
    font-size: var(--fs-xs);
    color: rgba(255, 255, 255, 0.78);
  }
  .pied__legal p { margin: 0; text-align: center; }
  .pied__legal span { display: inline-block; }
  .pied__legal-liens {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 1.2rem;
  }

  @media (max-width: 800px) {
    .pied__grille { text-align: center; }
    .pied__grille p { text-align: center; }
    .pied__bloc h2 { text-align: center; }
    .pied__bloc ul { justify-items: center; }
    .pied__logo { margin-inline: auto; }
    .pied__badges { justify-content: center; }
    .pied__actions { justify-items: center; max-width: 100%; margin-inline: auto; }
    .pied__coords li { justify-content: center; text-align: left; }
  }
</style>
