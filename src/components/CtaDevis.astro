---
// Bandeau CTA devis : photo de l'artisan à gauche, panneau marine à droite.
import { SITE } from '../data/site.ts';
import FlecheRonde from './FlecheRonde.astro';

export interface Props {
  titre?: string;
  texte?: string;
  puces?: string[];
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
}
const {
  titre = 'Contactez votre artisan couvreur',
  texte = `Une toiture à nettoyer, des tuiles à remplacer ou un projet de rénovation ? J'interviens à ${SITE.ville} et dans toute l'${SITE.departement} (${SITE.departementNum}), rapidement et même en urgence. Déplacement, conseil et devis détaillé gratuits, sans engagement.`,
  puces = [
    'Entreprise familiale, père & fils.',
    "Un travail d'artisan, mené avec exigence et passion.",
    'Garantie décennale.',
  ],
  image = '/images/photos/artisan-sur-toit.webp',
  imageAlt = 'Artisan Renaud Rénov au travail sur une toiture en tuiles en Eure-et-Loir',
  imageWidth = 1500,
  imageHeight = 2000,
} = Astro.props;
---
<section class="cta-devis">
  <div class="conteneur cta-devis__grille">
    <img
      class="cta-devis__photo"
      src={image}
      alt={imageAlt}
      loading="lazy"
      width={imageWidth}
      height={imageHeight}
    />
    <div class="cta-devis__panneau">
      <h2>{titre}</h2>
      <p class="cta-devis__texte">{texte}</p>
      <ul>
        {puces.map((p) => <li>{p}</li>)}
      </ul>
      <div class="cta-devis__actions">
        <a href={SITE.telHref} class="btn btn--rouge">
          <svg class="icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 3.5h-2A1.5 1.5 0 0 0 3 5.2C3.4 13 11 20.6 18.8 21a1.5 1.5 0 0 0 1.7-1.5v-2a1.5 1.5 0 0 0-1.3-1.5l-2.5-.35a1.5 1.5 0 0 0-1.4.6l-.7.95a11.5 11.5 0 0 1-4.9-4.9l.95-.7a1.5 1.5 0 0 0 .6-1.4l-.35-2.5a1.5 1.5 0 0 0-1.5-1.3Z"/><path d="M14.5 3.6a5.5 5.5 0 0 1 4.9 4.9"/><path d="M14 7a2.4 2.4 0 0 1 2 2"/></svg>
          {SITE.tel}
        </a>
        <a href="/devis-gratuit/" class="btn btn--blanc">Devis gratuit<FlecheRonde /></a>
      </div>
      <p class="cta-devis__urgence">
        Urgence (fuite, sinistre, bâchage) ?
        <a href={SITE.telUrgenceHref}>{SITE.telUrgence}</a>
      </p>
    </div>
  </div>
</section>

<style>
  .cta-devis { padding-block: clamp(2.5rem, 5vw, 4rem); }
  .cta-devis__grille {
    display: grid;
    border-radius: var(--rayon);
    overflow: hidden;
    box-shadow: var(--ombre-forte);
  }
  .cta-devis__photo { width: 100%; height: 100%; object-fit: cover; }
  .cta-devis__panneau {
    background: var(--bleu);
    color: var(--blanc);
    padding: clamp(2rem, 5vw, 4rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    text-align: left;
    gap: 1.4rem;
  }
  .cta-devis__panneau h2 { color: var(--blanc); }
  .cta-devis__texte { max-width: var(--mesure-etroite); margin: 0; }
  .cta-devis__panneau ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.4rem;
    font-size: var(--fs-md);
    text-align: left;
  }
  .cta-devis__panneau li::before {
    content: "•";
    color: var(--rouge);
    font-weight: 800;
    margin-right: 0.6em;
  }
  .cta-devis__actions { display: flex; flex-wrap: wrap; justify-content: flex-start; gap: 0.9rem; }
  .cta-devis__urgence { margin: 0; font-size: var(--fs-sm); opacity: 0.9; }
  .cta-devis__urgence a { color: var(--blanc); font-weight: 700; text-decoration: underline; }
  @media (max-width: 800px) {
    .cta-devis__actions { justify-content: center; width: 100%; }
  }
  @media (min-width: 900px) {
    .cta-devis__grille { grid-template-columns: 1fr 1fr; }
  }
</style>
