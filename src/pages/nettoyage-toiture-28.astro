---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site.ts';
import villes from '../data/villes.json';
import reviews from '../data/reviews.json';
import FilAriane from '../components/FilAriane.astro';
import LogoGoogle from '../components/LogoGoogle.astro';
import CtaDevis from '../components/CtaDevis.astro';
import FlecheRonde from '../components/FlecheRonde.astro';
import PrestationsConnexes from '../components/PrestationsConnexes.astro';

// ── Balises : brief pilier du 12/08/2026 (angles différenciés) ──────────
// Title → mot-clé + dept + co-requête ; H1 → tête différente du title ;
// Meta → prestations + matériaux + « Tarifs » (différenciant SERP).
// Balises dictées par le client le 12/08/2026.
const title = 'Lavage et démoussage professionnel de toiture dans le 28';
const description =
  "Devis gratuit pour le nettoyage de votre toit en Eure-et-Loir. Brossage manuel, démoussage en profondeur et traitements. Renaud Rénov, votre spécialiste.";

// ── Bloc 8 : la porte du cocon — les 14 satellites /nettoyage-toiture-{ville}/.
// Ancres alignées sur le H1 de chaque satellite (règle du cocon, 13/08/2026).
const zoneEnrichie = [
  { slug: 'villiers-le-morhier', ancre: 'le démoussage et lavage de toiture à Villiers-le-Morhier' },
  { slug: 'maintenon', ancre: 'le nettoyage et démoussage de toiture à Maintenon' },
  { slug: 'nogent-le-roi', ancre: 'le démoussage de toiture à Nogent-le-Roi' },
  { slug: 'epernon', ancre: 'faire nettoyer sa toiture à Épernon' },
  { slug: 'hanches', ancre: 'le lavage et traitement de toiture à Hanches' },
  { slug: 'gallardon', ancre: 'le démoussage et traitement de toiture à Gallardon' },
  { slug: 'pierres', ancre: 'le nettoyage de toiture à Pierres' },
  { slug: 'saint-piat', ancre: 'le démoussage de toit à Saint-Piat' },
  { slug: 'bouglainval', ancre: 'le nettoyage et traitement de toiture à Bouglainval' },
  { slug: 'chartres', ancre: 'le démoussage et lavage de toiture à Chartres' },
  { slug: 'dreux', ancre: 'le nettoyage de toiture à Dreux' },
  { slug: 'auneau', ancre: 'le démoussage de toiture à Auneau' },
  { slug: 'rambouillet', ancre: 'le nettoyage et traitement de toiture à Rambouillet' },
  { slug: 'houdan', ancre: 'le démoussage de toit à Houdan' },
];
const villeParSlug = Object.fromEntries(villes.map((v) => [v.slug, v]));

// ── Bloc 3 : deux avis réels ciblés (un démoussage sur tuile, un hydrofuge),
// signés « Prénom N. (Ville) » — la ville uniquement quand l'avis la cite. ──
const avisNettoyage = [
  { auteur: 'Jean-Michel Hanon', signature: 'Jean-Michel H.' },
  { auteur: 'Dominique Ndiaye', signature: 'Dominique N. (Bouglainval)' },
]
  .map((s) => {
    const a = reviews.avis.find((r) => r.auteur === s.auteur);
    return a && { ...a, signature: s.signature };
  })
  .filter(Boolean);

// ── Bloc 7 : fourchettes de prix (marché — à valider par Jordy) ──────────
const prix = [
  { presta: 'Démoussage simple', fourchette: '15 à 25 €/m²' },
  { presta: 'Démoussage + hydrofuge', fourchette: '25 à 45 €/m²' },
  { presta: 'Nettoyage de gouttières', fourchette: '5 à 12 €/ml' },
];

// ── Bloc 6 : le protocole en 4 étapes ────────────────────────────────────
const protocole = [
  {
    titre: 'Le traitement curatif',
    texte:
      "Tout commence par l'application d'un biocide à base de sels d'ammoniums quaternaires, en gamme professionnelle (type Sika ou équivalent). Le produit pénètre les végétaux et les dessèche sous 48 à 72 h : mousses, algues et lichens meurent à la racine, y compris sur tuile plate petit moule et sur ardoise naturelle.",
  },
  {
    titre: 'La phase de nettoyage',
    texte:
      "Une fois les végétaux desséchés, je lave la couverture en basse pression à 2-3 bars, complétée d'un brossage manuel des zones récalcitrantes : pureaux, arêtiers, noues et coyaux. Le rinçage se fait méthodiquement de haut en bas, dans le sens de l'écoulement, pour ne jamais faire remonter d'eau sous les rangs.",
  },
  {
    titre: 'Le traitement préventif rémanent',
    texte:
      "J'applique ensuite un traitement fongicide et algicide rémanent (formulation type Dalep — dont je suis applicateur certifié — ou Algimouss). Sa résistance au lessivage lui permet de rester actif sur la couverture et de retarder de plusieurs années la réinstallation des spores.",
  },
  {
    titre: 'La protection finale',
    texte:
      "En option, je termine par un hydrofuge de surface (gamme type Zolpan ou ProtectGuard) : une barrière invisible qui fait perler l'eau tout en maintenant la respirabilité du matériau — indispensable pour la tuile plate petit moule comme pour l'ardoise naturelle.",
  },
];

// ── Bloc 9 : FAQ (6 questions du brief) ─────────────────────────────────
const faq = [
  {
    q: 'Pourquoi faire nettoyer ma toiture ?',
    r: "Parce que les tuiles plates petit moule et les ardoises naturelles sont des matériaux poreux : les mousses y retiennent l'eau en permanence, ce qui accélère leur usure et finit par provoquer des fuites. Une couverture encrassée garde aussi l'humidité au-dessus des combles et dégrade leur isolation. Un nettoyage régulier préserve l'étanchéité et repousse de nombreuses années les grosses réparations.",
  },
  {
    q: 'À quelle fréquence faut-il démousser ?',
    r: "Tout dépend de l'environnement de votre maison. Dans les communes très arborées comme Maintenon, Saint-Piat, Villiers-le-Morhier ou Nogent-le-Roi, les toits se rechargent vite en mousses : un traitement tous les 5 ans environ est conseillé. Dans les secteurs plus urbains et dégagés de Chartres, de Dreux, d'Épernon ou de Gallardon, un passage tous les 8 à 10 ans suffit généralement.",
  },
  {
    q: 'Le nettoyage haute pression abîme-t-il les tuiles et les ardoises ?',
    r: "Oui. La haute pression décape la surface des tuiles plates et des ardoises, augmente leur porosité et altère les pureaux importants de nos couvertures. C'est pour cela que je travaille exclusivement en basse pression à 2-3 bars, complétée d'un brossage : le toit est propre, le matériau est intact.",
  },
  {
    q: "Quel est le prix d'un démoussage ?",
    r: "Comptez de 15 à 25 €/m² pour un démoussage simple et de 25 à 45 €/m² avec traitement hydrofuge, selon la surface, la pente et l'encrassement de la couverture. Le détail figure dans la section tarifs de cette page, et le devis est gratuit, précis et sans engagement.",
  },
  {
    q: 'Quelle est la meilleure période pour nettoyer sa toiture ?',
    r: "Les produits de traitement ont besoin d'un support sec pour bien pénétrer : j'interviens donc par temps sec, hors gel et hors forte chaleur. En pratique, le printemps, l'été et le début de l'automne offrent les meilleures conditions d'application.",
  },
  {
    q: 'Que faire en cas de lichens tenaces ?',
    r: "Les lichens incrustés demandent un protocole renforcé : un biocide professionnel surdosé pour l'usage, un brossage manuel adapté au support — tuile plate petit moule ou ardoise naturelle — puis un hydrofuge haute performance qui prive les lichens de l'humidité dont ils ont besoin pour se réinstaller.",
  },
];

// ── Schémas : Service rattaché au LocalBusiness + FAQPage ───────────────
const businessId = `${SITE.url}/#localbusiness`;
const schemaService = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${SITE.url}/nettoyage-toiture-28/#service`,
  serviceType: 'Nettoyage et démoussage de toiture',
  name: 'Nettoyage de toiture en Eure-et-Loir',
  description:
    "Démoussage, brossage manuel, traitement hydrofuge et nettoyage de gouttières sur tuiles plates petit moule et ardoises naturelles, par un artisan couvreur du 28.",
  provider: { '@id': businessId },
  areaServed: {
    '@type': 'AdministrativeArea',
    name: `${SITE.departement} (${SITE.departementNum})`,
  },
  offers: { '@type': 'Offer', priceCurrency: 'EUR', availability: 'https://schema.org/InStock' },
};

const schemaFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.r },
  })),
};
---
<BaseLayout title={title} description={description} extraSchemas={[schemaService, schemaFaq]}>
  <!-- ── Bloc 1 · Hero : design de la home (titre / photo / coches) ───── -->
  <section class="section section--sans-bas">
    <div class="conteneur">
      <FilAriane items={[{ label: 'Accueil', href: '/' }, { label: 'Nettoyage de toiture' }]} />
    </div>
  </section>
  <section class="hx">
    <div class="conteneur hx__grid">
      <div class="hx__head">
        <h1 class="hx__title">Nettoyage et démoussage de toiture en Eure-et-Loir&nbsp;(28)</h1>
        <p class="hx__marque">RENAUD RÉNOV</p>
      </div>

      <div class="hx__right">
        <img
          class="hx__photo"
          src="/images/photos/nettoyage-demoussage-toiture.webp"
          alt="M. Renaud, artisan couvreur, nettoyant et démoussant une toiture en Eure-et-Loir"
          fetchpriority="high"
          width="2000"
          height="1500"
        />
        <div class="hx__note">
          <div class="hx__note-top">
            <LogoGoogle taille={26} />
            <span class="hx__note-stars" aria-label={`${reviews.note} étoiles sur 5`}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg>
            </span>
          </div>
          <p class="hx__note-txt">Noté <strong>{reviews.note.toLocaleString('fr-FR')}/5</strong> sur Google · {reviews.nombre} avis</p>
        </div>
      </div>

      <div class="hx__body">
        <p class="hx__chapo">
          Votre toiture est envahie par les mousses et les lichens, elle est salie par des traînées
          noires, des traces de pollution, et vous souhaitez la nettoyer&nbsp;? Vous avez besoin d'un
          professionnel capable de laver votre toit et de retirer les mousses sans abîmer la
          toiture ni polluer votre environnement. Je suis M.&nbsp;Renaud et, avec mon entreprise de
          couverture <strong>Renaud Rénov</strong>, je suis l'expert du
          <strong>nettoyage et du démoussage de toiture</strong> en <strong>Eure-et-Loir</strong>.
        </p>

        <ul class="hx__points">
          <li>
            <span class="hx__check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M8 12.5l2.5 2.5 5-6"/></svg></span>
            15 années d'expérience en entretien de toitures
          </li>
          <li>
            <span class="hx__check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M8 12.5l2.5 2.5 5-6"/></svg></span>
            Démoussage professionnel des toitures
          </li>
          <li>
            <span class="hx__check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M8 12.5l2.5 2.5 5-6"/></svg></span>
            Applicateur de solutions Dalep pour les toitures et les façades
          </li>
          <li>
            <span class="hx__check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M8 12.5l2.5 2.5 5-6"/></svg></span>
            Devis gratuit et sans engagement
          </li>
        </ul>

        <div class="hx__badges">
          <img src="/images/labels/applicateur-dalep.webp" alt="Applicateur de solutions DALEP certifié" width="240" height="240" loading="lazy" />
        </div>

        <div class="hx__actions">
          <a href="/devis-gratuit/" class="btn btn--rouge">Devis gratuit<FlecheRonde /></a>
          <a href={SITE.telHref} class="btn btn--bleu">
            <svg class="icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 3.5h-2A1.5 1.5 0 0 0 3 5.2C3.4 13 11 20.6 18.8 21a1.5 1.5 0 0 0 1.7-1.5v-2a1.5 1.5 0 0 0-1.3-1.5l-2.5-.35a1.5 1.5 0 0 0-1.4.6l-.7.95a11.5 11.5 0 0 1-4.9-4.9l.95-.7a1.5 1.5 0 0 0 .6-1.4l-.35-2.5a1.5 1.5 0 0 0-1.5-1.3Z"/><path d="M14.5 3.6a5.5 5.5 0 0 1 4.9 4.9"/><path d="M14 7a2.4 2.4 0 0 1 2 2"/></svg>
            {SITE.tel}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Bloc 2 · H2 services + 4 H3 techniques ───────────────────────── -->
  <section class="section section--gris">
    <div class="conteneur">
      <div class="section__entete">
        <h2>Une gamme de services pour un toit propre et sans mousses</h2>
      </div>

      <div class="savoir">
        <!-- 1 · Démoussage de toitures -->
        <article class="savoir-carte">
          <div class="savoir-carte__media">
            <img
              src="/images/photos/demoussage-28.webp"
              alt="Maison aux volets bleus avec sa toiture en tuiles propre après démoussage par Renaud Rénov en Eure-et-Loir (28)"
              loading="lazy" width="2000" height="1500"
            />
          </div>
          <div class="savoir-carte__texte">
            <h3>Nettoyage de toiture</h3>
            <p>
              L'objectif est de retrouver une toiture propre, sans présence de végétaux sur la
              toiture. Il peut s'agir de mousses, de lichens, de tout un ensemble de micro-organismes
              qui abîment les matériaux de couverture — essentiellement les tuiles et les ardoises.
              Avec leurs micro-racines, ils pénètrent les matériaux et les rendent poreux, le toit
              n'est plus étanche et la toiture devient fragile. Je retire les mousses et les lichens
              en utilisant des techniques adaptées aux matériaux de couverture&nbsp;: un lavage basse
              pression, l'application d'antimousses professionnels adaptés aux toitures, parfois le
              lavage haute pression pour des toitures en tuiles béton. L'objectif est de garantir un
              nettoyage efficace qui n'abîme pas votre toiture.
            </p>
          </div>
        </article>

        <!-- 2 · Traitement hydrofuge (carte marine, image à droite) -->
        <article class="savoir-carte savoir-carte--inverse savoir-carte--marine">
          <div class="savoir-carte__media">
            <img
              src="/images/photos/toiture-apres-hydrofuge-resine-28.webp"
              alt="Toiture en tuiles ravivée après application d'une résine hydrofuge colorée par Renaud Rénov en Eure-et-Loir"
              loading="lazy" width="2000" height="1500"
            />
          </div>
          <div class="savoir-carte__texte">
            <h3>Application de traitement hydrofuge</h3>
            <p>
              Il s'agit de produits adaptés spécifiquement aux toitures, qui permettent d'en
              renforcer la résistance et l'étanchéité. Ils créent un effet déperlant en maintenant la
              microporosité&nbsp;: le produit empêche l'humidité de pénétrer, tout en permettant aux
              tuiles plates et à l'ardoise naturelle de respirer. Ces
              <a href="/traitement-hydrofuge-28/">traitements hydrofuges</a> sont adaptés à
              des toitures anciennes dont les tuiles sont devenues plus fragiles, mais qui ne sont
              pas pour autant abîmées. Il s'agit d'un renfort, couplé à un antimousse. Ils empêchent
              également les végétaux de s'installer sur la toiture.
            </p>
          </div>
        </article>

        <!-- 3 · Brossage manuel tuiles & ardoises : le bloc expertise -->
        <article class="savoir-carte">
          <div class="savoir-carte__media">
            <img
              src="/images/photos/brossage-manuel-tuiles-anciennes-28.webp"
              alt="Artisan couvreur Renaud Rénov brossant à la main les mousses d'une toiture ancienne en tuiles plates en Eure-et-Loir"
              loading="lazy" width="1500" height="2000"
              style="object-position: center 62%;"
            />
          </div>
          <div class="savoir-carte__texte">
            <h3>Brossage manuel des toitures</h3>
            <p>
              Certaines toitures sont recouvertes de tuiles ou d'ardoises fragiles. Généralement, on
              parle de tuiles plates petit moule&nbsp;: leurs teintes vont du rouge orangé au brun
              violacé. Au sud de la Beauce, on va retrouver de l'ardoise naturelle, notamment sur
              certains édifices. Pour être certain de ne pas abîmer ces matériaux de couverture, on
              va utiliser le brossage manuel&nbsp;: on aura ainsi la garantie de ne pas abîmer la
              toiture, et on conserve le calcin des tuiles plates et la surface des ardoises.
            </p>
          </div>
        </article>

        <!-- 4 · Nettoyage de gouttières -->
        <article class="savoir-carte savoir-carte--inverse">
          <div class="savoir-carte__media">
            <img
              src="/images/photos/gouttiere-descente.webp"
              alt="Descente de gouttière et zinguerie entretenues par Renaud Rénov sur une maison d'Eure-et-Loir"
              loading="lazy" width="2000" height="1500"
            />
          </div>
          <div class="savoir-carte__texte">
            <h3>Nettoyage des gouttières</h3>
            <p>
              En général, à l'issue d'un nettoyage de toiture, on procède au nettoyage des
              gouttières. C'est une prestation simple et efficace pour garantir le bon fonctionnement
              des systèmes d'évacuation des eaux de pluie. J'interviens sur les chéneaux, les noues
              et les descentes d'eau de pluie. On évite ainsi les débordements et les infiltrations,
              pour être certain d'avoir des <a href="/prestations/pose-gouttiere/">gouttières en bon
              état</a>, avec des toitures qui ne souffrent pas d'accumulation d'eau de pluie.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ── Bloc 3 · Deux avis clients : photo à gauche, avis à droite ───── -->
  <section class="section">
    <div class="conteneur">
      <div class="temoins">
        <img
          class="temoins__photo"
          src="/images/photos/renaud-renov-couvreur-28.webp"
          alt="M. Renaud, artisan couvreur Renaud Rénov, devant une toiture nettoyée en Eure-et-Loir"
          loading="lazy"
          width="1024"
          height="768"
        />
        <div class="temoins__liste">
          <div class="temoins__entete">
            <h2>Ils m'ont confié l'entretien de leur toiture</h2>
            <p class="avis-note-google">
              <LogoGoogle taille={20} />
              <span class="avis-note-google__etoiles" aria-hidden="true">★★★★★</span>
              Noté <strong>{reviews.note.toLocaleString('fr-FR')}/5</strong> sur Google · {reviews.nombre} avis
            </p>
          </div>
          {avisNettoyage.map((a) => (
            <article class="temoin">
              <p class="temoin__note">
                <span class="temoin__etoiles" aria-hidden="true">★★★★★</span>
                <span class="visuallyhidden">{a.note} étoiles sur 5</span>
              </p>
              <p class="temoin__texte">{a.texte}</p>
              <p class="temoin__auteur">{a.signature}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── Bloc 4 · Pourquoi choisir : 3 atouts nettoyage ───────────────── -->
  <section class="section section--bleute">
    <div class="conteneur">
      <div class="section__entete">
        <h2>Pourquoi choisir Renaud Rénov pour nettoyer votre toit&nbsp;?</h2>
      </div>

      <div class="atouts atouts--trois">
        <article class="atout">
          <h3>Une véritable expertise en nettoyage de toiture</h3>
          <p>
            Implanté en Eure-et-Loir, travailler avec moi, c'est bénéficier d'une solide expérience
            et du savoir-faire d'un <a href="/">couvreur du 28</a>&nbsp;: je connais les matériaux
            utilisés ici, dans le département, et leur bonne utilisation.
          </p>
        </article>

        <article class="atout">
          <h3>Des techniques respectueuses</h3>
          <p>
            Utilisation de techniques qui protègent votre toit&nbsp;: pas de produits chlorés
            dangereux pour le calcin des tuiles et pour les ardoises naturelles, pas de haute
            pression sur des toitures fragiles. Brossage manuel ou jets basse pression pour une
            toiture propre.
          </p>
        </article>

        <article class="atout">
          <h3>Des tarifs transparents</h3>
          <p>
            Avant toute intervention, vous recevez un devis détaillé et gratuit&nbsp;: surface,
            prestations, produits appliqués, prix ferme. Vous savez exactement ce que vous payez, et
            pourquoi.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ── Bloc 5 · CTA intermédiaire ───────────────────────────────────── -->
  <section class="section cta-nettoyage">
    <div class="conteneur cta-nettoyage__grille">
      <img
        class="cta-nettoyage__photo"
        src="/images/photos/nettoyage-toiture-pavillon-eure-et-loir-28.webp"
        alt="Toiture en tuiles à moitié nettoyée en Eure-et-Loir, contraste avant/après démoussage"
        loading="lazy"
        width="900"
        height="675"
      />
      <div class="cta-nettoyage__panneau">
        <h2>Devis gratuit en 24&nbsp;h pour nettoyer votre toiture</h2>
        <p>
