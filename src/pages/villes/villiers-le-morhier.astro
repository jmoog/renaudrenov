---
// ─────────────────────────────────────────────────────────────────────────
// Page ville VILLIERS-LE-MORHIER (siège) — fichier dédié (réécriture
// 14/08/2026, brief client). Même structure que le gabarit villes/[slug].astro
// + spécificité du siège : bloc adresse / horaires / urgence sous le hero.
// ─────────────────────────────────────────────────────────────────────────
import FlecheRonde from '../../components/FlecheRonde.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site.ts';
import services from '../../data/services.json';
import reviews from '../../data/reviews.json';
import FilAriane from '../../components/FilAriane.astro';
import AvisCarrousel from '../../components/AvisCarrousel.astro';
import CtaDevis from '../../components/CtaDevis.astro';
import LogoGoogle from '../../components/LogoGoogle.astro';
import LogosMarques from '../../components/LogosMarques.astro';

const ville = 'Villiers-le-Morhier';
const cp = '28130';

// ── Balises différenciées (anti-triplette) ──
const title = 'Entreprise de couverture à Villiers-le-Morhier (28)';
const description =
  "Démoussage de toiture, zinguerie et réparations au départ de Villiers-le-Morhier par Renaud Rénov, artisan de père en fils. ✓ Devis gratuit ✓ 02 34 40 17 61.";

// ── Les 6 cards de services (ordre propre à la commune) ──
const cartes = [
  {
    titre: `Nettoyage et démoussage de toiture à ${ville}`,
    texte:
      "Le nettoyage d'un toit se réussit avec la bonne technique : celle qui retire mousses et lichens sans altérer la couverture. Des produits professionnels, un dosage juste, un résultat durable.",
    image: '/images/photos/nettoyage-demoussage-toiture.webp',
    alt: 'Artisan Renaud Rénov nettoyant une toiture au jet en Eure-et-Loir',
    href: '/nettoyage-toiture-villiers-le-morhier/',
  },
  {
    titre: 'Réparation de toiture',
    texte:
      "Fuite, tuile cassée, infiltration : j'interviens vite — bâche posée en urgence si nécessaire — puis je recherche l'origine du problème pour une réparation qui tient. La proximité fait la rapidité.",
    image: '/images/photos/reparation-toiture.webp',
    alt: "Réparation du faîtage d'une toiture en tuiles en Eure-et-Loir",
    href: '/reparation-toiture-28/',
  },
  {
    titre: 'Gouttières et descentes',
    texte:
      "Gouttière percée, descente disjointe, eau qui ruisselle sur le pignon : j'interviens à Villiers-le-Morhier pour réparer, remplacer ou poser vos gouttières en zinc, en aluminium ou en PVC.",
    image: '/images/photos/gouttiere-descente.webp',
    alt: "Descente de gouttière posée le long d'un pignon par Renaud Rénov en Eure-et-Loir",
    href: '/pose-gouttiere-28/',
  },
  {
    titre: 'Rénovation et remplacement de toiture',
    texte:
      "M. Renaud maîtrise tous les matériaux de couverture présents à Villiers-le-Morhier : tuile de pays, tuile plate, ardoise, zinc et bac acier. Votre toiture est refaite dans les règles de l'art.",
    image: '/images/photos/renovation-toiture.webp',
    alt: 'Rénovation de toiture avec liteaunage neuf sur charpente en Eure-et-Loir',
    href: '/renovation-toiture-28/',
  },
  {
    titre: 'Nettoyage de façade',
    texte:
      "Renaud Rénov est le spécialiste de l'entretien des façades en Eure-et-Loir : lavage des murs, traitements adaptés à chaque revêtement, et le professionnalisme d'un artisan pour des extérieurs sains.",
    image: '/images/photos/facade-pignon-sale-28.webp',
    alt: "Façade et pignon avant nettoyage dans le 28 — coulures et traces d'humidité",
    href: '/nettoyage-facade-28/',
  },
  {
    titre: 'Travaux de zinguerie',
    texte:
      "Noues, solins, abergements de cheminée, habillages de rive : ces ouvrages en zinc protègent les points sensibles de la toiture. Un savoir-faire d'artisan, transmis de père en fils.",
    image: '/images/photos/zinguerie-epi.webp',
    alt: 'Épi de faîtage en zinc réalisé par Renaud Rénov, artisan couvreur-zingueur en Eure-et-Loir',
    href: '/zinguerie-28/',
  },
];

// ── Marques (4 fabricants) ──
const marquesVille = [
  { nom: 'Dalep', url: 'https://www.dalep.com/', logo: '/images/marques/logo-dalep.webp', alt: 'Dalep – traitements hydrofuges et anti-mousse pour toiture' },
  { nom: 'Monier', url: 'https://www.monier.fr/', logo: '/images/marques/logo-monier.webp', alt: 'Monier – tuiles en terre cuite et béton pour la couverture' },
  { nom: 'Edilians', url: 'https://www.edilians.com/', logo: '/images/marques/logo-edilians.webp', alt: 'Edilians – tuiles en terre cuite' },
  { nom: 'Knauf', url: 'https://www.knaufinsulation.fr/', logo: '/images/marques/logo-knauf.webp', alt: 'Knauf – isolation thermique' },
];

// Lien Google Maps depuis les coordonnées de l'entreprise.
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  `${SITE.rue}, ${SITE.cp} ${SITE.ville}`
)}`;

// ── Schema : même @id que la fiche globale (fusion) + areaServed ville ──
const businessId = `${SITE.url}/#localbusiness`;
const schemaVille = {
  '@context': 'https://schema.org',
  '@type': 'RoofingContractor',
  '@id': businessId,
  name: SITE.nom,
  url: SITE.url,
  areaServed: [
    { '@type': 'AdministrativeArea', name: `${SITE.departement} (${SITE.departementNum})` },
    { '@type': 'City', name: ville, postalCode: SITE.cp },
  ],
  knowsAbout: [
    'Nettoyage de toiture',
    'Démoussage de toiture',
    'Traitement hydrofuge',
    'Réparation de toiture',
    'Rénovation de toiture',
    'Nettoyage de façade',
    'Zinguerie',
    'Pose de gouttière',
    'Couverture tuile et ardoise',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: `Prestations de couverture à ${ville}`,
    itemListElement: services.map((s, i) => ({
      '@type': 'Offer',
      position: i + 1,
      itemOffered: { '@type': 'Service', name: s.label, url: `${SITE.url}${s.href}`, provider: { '@id': businessId } },
    })),
  },
};
---
<BaseLayout title={title} description={description} extraSchemas={[schemaVille]}>
  <!-- ── Fil d'Ariane ─────────────────────────────────────────── -->
  <section class="section section--sans-bas">
    <div class="conteneur">
      <FilAriane items={[{ label: 'Accueil', href: '/' }, { label: `Couvreur à ${ville}` }]} />
    </div>
  </section>

  <!-- ── Hero (modèle home : titre / photo / coches) ──────────── -->
  <section class="hx">
    <div class="conteneur hx__grid">
      <div class="hx__head">
        <h1 class="hx__title">Couvreur zingueur à {ville}</h1>
        <p class="hx__marque">RENAUD RÉNOV</p>
      </div>

      <div class="hx__right">
        <img
          class="hx__photo"
          src="/images/photos/hero-renaud-renov.webp"
          srcset="/images/photos/hero-renaud-renov-640.webp 640w, /images/photos/hero-renaud-renov-960.webp 960w, /images/photos/hero-renaud-renov-1280.webp 1280w, /images/photos/hero-renaud-renov.webp 1600w"
          sizes="(min-width: 980px) 46vw, calc(100vw - 2rem)"
          alt={`Le véhicule de Renaud Rénov devant une maison et sa toiture en tuiles à ${ville}`}
          fetchpriority="high"
          width="1600"
          height="1200"
        />
        <div class="hx__note">
          <div class="hx__note-top">
            <LogoGoogle taille={26} />
            <span class="hx__note-stars" aria-label={`${reviews.note} étoiles sur 5`}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg>
            </span>
          </div>
          <p class="hx__note-txt">Noté <strong>{reviews.note.toLocaleString('fr-FR')}/5</strong> sur Google · {reviews.nombre} avis</p>
        </div>
      </div>

      <div class="hx__body">
        <p class="hx__chapo">
          Vous avez besoin d'un spécialiste de la toiture à {ville} ?
          <strong>Renaud Rénov</strong>, <a href="/">artisan couvreur du 28</a>, est votre professionnel — et votre voisin, puisque
          l'entreprise est installée dans la commune : démoussage et nettoyage de la toiture,
          traitements hydrofuges, réparation d'infiltration ou remplacement d'une toiture ancienne.
        </p>

        <ul class="hx__points">
          <li>
            <span class="hx__check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M8 12.5l2.5 2.5 5-6"/></svg></span>
            Entreprise artisanale de couverture
          </li>
          <li>
            <span class="hx__check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M8 12.5l2.5 2.5 5-6"/></svg></span>
            Couvreur de père en fils
          </li>
          <li>
            <span class="hx__check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M8 12.5l2.5 2.5 5-6"/></svg></span>
            Garantie décennale
          </li>
        </ul>

        <div class="hx__badges">
          <img src="/images/labels/applicateur-dalep.webp" alt="Applicateur de solutions DALEP certifié" width="240" height="240" loading="lazy" />
          <img src="/images/labels/garantie-decennale-10-ans.png" alt="Garantie décennale 10 ans" width="220" height="220" loading="lazy" />
        </div>

        <div class="hx__actions">
          <a href="/devis-gratuit/" class="btn btn--rouge">Devis gratuit<FlecheRonde /></a>
          <a href={SITE.telHref} class="btn btn--bleu">
            <svg class="icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 3.5h-2A1.5 1.5 0 0 0 3 5.2C3.4 13 11 20.6 18.8 21a1.5 1.5 0 0 0 1.7-1.5v-2a1.5 1.5 0 0 0-1.3-1.5l-2.5-.35a1.5 1.5 0 0 0-1.4.6l-.7.95a11.5 11.5 0 0 1-4.9-4.9l.95-.7a1.5 1.5 0 0 0 .6-1.4l-.35-2.5a1.5 1.5 0 0 0-1.5-1.3Z"/><path d="M14.5 3.6a5.5 5.5 0 0 1 4.9 4.9"/><path d="M14 7a2.4 2.4 0 0 1 2 2"/></svg>
            {SITE.tel}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Adresse & horaires (uniquement sur la page du siège) ─── -->
  <section class="section section--sans-haut coord">
    <div class="conteneur">
      <div class="carte coord__carte">
        <div class="coord__bloc">
          <span class="coord__icone" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </span>
          <div>
            <h2>Mon adresse</h2>
            <address>
              <strong>{SITE.nomLegal}</strong><br />
              {SITE.rue}<br />
              {SITE.cp} {SITE.ville}
            </address>
            <a href={mapsUrl} rel="noopener" target="_blank" class="coord__lien">Voir sur Google Maps →</a>
          </div>
        </div>

        <div class="coord__bloc">
          <span class="coord__icone" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          </span>
          <div>
            <h2>Horaires d'ouverture</h2>
            <p class="coord__horaires"><strong>Du lundi au samedi</strong><br />8 h 00 – 20 h 00</p>
            <p class="coord__urgence">Fermé le dimanche.</p>
          </div>
        </div>

        <div class="coord__bloc">
          <span class="coord__icone" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="2" width="10" height="20" rx="2"/><line x1="11" y1="18" x2="13" y2="18"/></svg>
          </span>
          <div>
            <h2>Me contacter en cas d'urgence</h2>
            <p class="coord__contact">
              <a href={SITE.telUrgenceHref}>{SITE.telUrgence}</a>
            </p>
            <p class="coord__urgence">Disponible <strong>24h/24 et 7j/7</strong>.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Services : 6 cards ───────────────────────────────────── -->
  <section class="section section--gris">
    <div class="conteneur">
      <h2>Mes services pour votre toiture à {ville}</h2>
      <div class="grille-cards-4">
        {cartes.map((c) => (
          <a href={c.href} class="carte carte-service">
            <img src={c.image} alt={c.alt} loading="lazy" width="400" height="250" />
            <span class="carte-service__corps">
              <h3>{c.titre}</h3>
              <p>{c.texte}</p>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Avis clients ─────────────────────────────────────────── -->
  <AvisCarrousel lieu={`à ${ville}`} titre={`Ce que pensent mes clients à ${ville}`} />

  <!-- ── CTA photo ────────────────────────────────────────────── -->
  <CtaDevis
    titre={`Votre artisan couvreur à ${ville} vous répond`}
    texte="Installé dans la commune, M. Renaud se déplace chez vous en quelques minutes pour examiner votre toiture et vous donner un avis d'artisan : ce qui presse, ce qui peut attendre. Quinze années d'expérience des travaux de couverture, un savoir-faire familial et un devis gratuit, sans engagement."
  />

  <!-- ── Section longue : savoir-faire + urbanisme + mairie ───── -->
  <section class="section">
    <div class="conteneur">
      <div class="section__entete">
        <h2>Faites appel à une entreprise de couverture pour vos travaux de zinguerie et de charpente</h2>
      </div>
      <div class="texte-long">
        <p>
          La zinguerie est le détail qui fait tenir le tout : noues, solins, chéneaux et
          abergements conduisent l'eau partout où la couverture s'interrompt. Ce travail du zinc —
          mesurer, plier, souder, ajuster — s'apprend avec les années, et Renaud Rénov le pratique
          de père en fils. C'est ce qui nous permet de livrer des toitures complètes, finitions
          comprises, sans rien sous-traiter de ce qui fait l'étanchéité.
        </p>
        <p>
          La charpente mérite la même attention : c'est elle qui porte la couverture, et aucun toit
          neuf ne vaut rien sur des bois fatigués. À chaque intervention à {ville}, je contrôle
          l'état de la structure — déformations, traces d'humidité, attaques d'insectes — et les
          reprises nécessaires se font avant la pose, proprement, pour que le reste du chantier
          s'appuie sur une base saine. Ce contrôle préalable évite le pire scénario : découvrir
          le problème une fois la couverture neuve posée.
        </p>
        <p>
          Autour de ces savoir-faire, mon métier reste celui d'un couvreur complet : entretien
          régulier des toitures, nettoyage mené sans brutalité, <a href="/traitement-hydrofuge-28/">traitements hydrofuges</a> appliqués
          en professionnel certifié, réparations ponctuelles comme rénovations lourdes. Plus de
          quinze années d'expérience servent d'abord à cela : proposer l'intervention juste, celle
          qui répond au problème constaté — et le dire simplement quand il n'y a rien à faire.
          Le devis est gratuit, détaillé poste par poste, et le calendrier annoncé est tenu.
        </p>
        <p>
          La connaissance des matériaux complète l'ensemble : tuile de pays, tuile plate, tuile
          mécanique, ardoise, zinc et bac acier ont chacun leurs règles de pente, de fixation et de
          recouvrement, et chaque toit se travaille selon son matériau. Rappelez-vous enfin que
          refaire certains travaux sur une toiture implique le respect du code de l'urbanisme —
          notamment du plan local d'urbanisme ou du plan d'occupation des sols — et que plusieurs
          chantiers exigent une déclaration préalable. Ces règles varient selon les communes : un
          point vérifié en amont évite bien des retards. Le service urbanisme de la mairie de
          {ville} vous renseignera sur les règles applicables à votre maison.
        </p>
      </div>

      <div class="carte mairie-encart">
        <span class="mairie-encart__icone" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V10l7-5 7 5v11"/><path d="M9 21v-6h6v6"/></svg>
        </span>
        <div class="mairie-encart__corps">
          <p class="mairie-encart__invite">
            Avant d'engager des travaux qui modifient l'aspect de votre toiture, renseignez-vous
            auprès du service urbanisme de la <strong>mairie de {ville}</strong> :
          </p>
          <address class="mairie-encart__adresse">9 rue de la Mairie, {cp} {ville}</address>
          <a href="https://villiers-le-morhier.com/" rel="noopener nofollow" target="_blank" class="btn btn--bleu">
            Site de la mairie de {ville}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Marques & fournisseurs ───────────────────────────────── -->
  <LogosMarques marques={marquesVille} />
</BaseLayout>

<style>
  /* ══ Hero — design de la page d'accueil (repris de index.astro) ══ */
  .hx { padding-block: clamp(1.6rem, 4vw, 3rem); }
  .hx__grid {
    display: grid;
    gap: 1.6rem;
    grid-template-columns: 1fr;
    grid-template-areas: "head" "photo" "body";
  }
  @media (min-width: 980px) {
    .hx__grid {
      grid-template-columns: 1.05fr 1fr;
      grid-template-areas: "head photo" "body photo";
      column-gap: 3.5rem;
      row-gap: 1.1rem;
      align-items: center;
    }
  }
  .hx__head { grid-area: head; }
  .hx__right { grid-area: photo; position: relative; }
  .hx__right::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 42%;
    border-radius: 0 0 24px 24px;
    background: linear-gradient(to top, rgba(15, 34, 45, 0.6), rgba(15, 34, 45, 0));
    pointer-events: none;
    z-index: 1;
  }
  .hx__body { grid-area: body; }
  .hx__title { margin: 0; color: var(--bleu); font-size: var(--fs-h1-hero); line-height: 1.2; letter-spacing: -0.01em; }
  .hx__marque { color: var(--rouge); font-weight: 800; font-size: clamp(1.9rem, 4.4vw, 2.9rem); line-height: 1.1; margin: 0.6rem 0 0; }
  .hx__photo { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 24px; box-shadow: var(--ombre-forte); display: block; }
  @media (min-width: 980px) { .hx__photo { aspect-ratio: 4 / 5; } }

  .hx__chapo { color: var(--gris-700); margin: 0 0 1.2rem; max-width: var(--mesure-etroite); }
  .hx__chapo strong { color: var(--bleu); }

  .hx__points { list-style: none; padding: 0; margin: 0.4rem 0 1.2rem; display: grid; gap: 0.9rem; }
  .hx__points li {
    display: flex; align-items: center; gap: 0.8rem;
    font-size: var(--fs-md); font-weight: 600; color: var(--bleu);
  }
  .hx__check { color: var(--rouge); flex-shrink: 0; line-height: 0; }
  .hx__check svg { width: 30px; height: 30px; }

  .hx__note {
    position: absolute;
    left: 50%;
    bottom: 1rem;
    transform: translateX(-50%);
    width: max-content;
    max-width: calc(100% - 1.6rem);
    display: flex; flex-direction: column; align-items: center; gap: 0.3rem;
    background: var(--blanc);
    border-radius: 16px;
    box-shadow: 0 14px 34px rgba(15, 34, 45, 0.42);
    padding: 0.8rem 1.5rem;
    z-index: 2;
  }
  .hx__note-top { display: flex; align-items: center; gap: 0.6rem; }
  .hx__note-stars { display: inline-flex; gap: 0.1em; }
  .hx__note-stars svg { width: 1.35rem; height: 1.35rem; fill: var(--etoile); }
  .hx__note-txt { margin: 0; color: var(--gris-700); font-size: var(--fs-base); }
  .hx__note-txt strong { color: var(--bleu); }

  .hx__badges { display: flex; align-items: center; gap: 1.3rem; flex-wrap: wrap; margin: 0 0 1.6rem; }
  .hx__badges img { height: 64px; width: auto; }

  .hx__actions { display: flex; flex-wrap: wrap; gap: 0.8rem; }

  @media (max-width: 979px) {
    .hx__title, .hx__marque { text-align: center; }
    .hx__chapo { margin-inline: auto; }
    .hx__badges, .hx__actions { justify-content: center; }
    .hx__badges img { height: 56px; }
  }

