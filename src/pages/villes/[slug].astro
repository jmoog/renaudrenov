---
// ─────────────────────────────────────────────────────────────────────────
// Pages villes /villes/{slug}/ — réécriture 14/08/2026 (brief client).
//
// Structure : hero .hx (modèle home : H1 + marque orange + chapo
// problème → solution + 3 coches + badges + note Google) → 6 cards de
// services (ordre tournant par commune, la carte démoussage pointe vers le
// satellite /nettoyage-toiture-{ville}/, la carte façade vers le pilier
// /nettoyage-facade-28/) → avis → CTA photo (H2 localisé) → section longue
// « Faites appel à… » (4 §, se termine toujours par PLU / déclaration
// préalable) + encart mairie (adresse bien visible + lien site) → marques.
//
// Règles : H1 sans prestation ni département, balises title/H1/meta
// différenciées (anti-triplette), jamais de barre colorée sur une carte,
// jamais de bouton pleine largeur, tokens typo uniquement.
// ─────────────────────────────────────────────────────────────────────────
import FlecheRonde from '../../components/FlecheRonde.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site.ts';
import { ZONES_SERVIES, commune, cataloguePrestations } from '../../lib/schema.ts';
import services from '../../data/services.json';
import villes from '../../data/villes.json';
import { VILLES_CONTENU } from '../../data/villes-contenu.ts';
import { villeNettoyageParSlug } from '../../data/villes-nettoyage.ts';
import FilAriane from '../../components/FilAriane.astro';
import AvisCarrousel from '../../components/AvisCarrousel.astro';
import CtaDevis from '../../components/CtaDevis.astro';
import LogoGoogle from '../../components/LogoGoogle.astro';
import LogosMarques from '../../components/LogosMarques.astro';
import reviews from '../../data/reviews.json';

export function getStaticPaths() {
  return Object.keys(VILLES_CONTENU).map((slug) => {
    const v = villes.find((x) => x.slug === slug)!;
    return { params: { slug }, props: { nom: v.nom, cp: v.cp, contenu: VILLES_CONTENU[slug] } };
  });
}

const { nom, cp, contenu } = Astro.props;
const { slug } = Astro.params;
// « à Chartres » / « au Coudray », « de Chartres » / « du Coudray »
const aVille = contenu.a ?? `à ${nom}`;
const deVille = contenu.de ?? `de ${nom}`;
// La commune a-t-elle sa page démoussage /nettoyage-toiture-{slug}/ ?
const aSatellite = !!villeNettoyageParSlug(slug);

// ── Les 6 cards de services : visuel + lien par type. L'ordre et les
// textes viennent des données de la commune (villes-contenu.ts). ──
const CARTES_BASE: Record<string, { image: string; alt: string; href: string }> = {
  demoussage: {
    image: '/images/photos/nettoyage-demoussage-toiture.webp',
    alt: 'Artisan Renaud Rénov nettoyant une toiture au jet en Eure-et-Loir',
    href: aSatellite ? `/nettoyage-toiture-${slug}/` : '/nettoyage-toiture-28/',
  },
  renovation: {
    image: '/images/photos/renovation-toiture.webp',
    alt: 'Rénovation de toiture avec liteaunage neuf sur charpente en Eure-et-Loir',
    href: '/renovation-toiture-28/',
  },
  facade: {
    image: '/images/photos/facade-pignon-sale-28.webp',
    alt: "Façade et pignon avant nettoyage dans le 28 — coulures et traces d'humidité",
    href: '/nettoyage-facade-28/',
  },
  reparation: {
    image: '/images/photos/reparation-toiture.webp',
    alt: "Réparation du faîtage d'une toiture en tuiles en Eure-et-Loir",
    href: '/reparation-toiture-28/',
  },
  zinguerie: {
    image: '/images/photos/zinguerie-epi.webp',
    alt: 'Épi de faîtage en zinc réalisé par Renaud Rénov, artisan couvreur-zingueur en Eure-et-Loir',
    href: '/zinguerie-28/',
  },
  gouttiere: {
    image: '/images/photos/gouttiere-descente.webp',
    alt: "Descente de gouttière posée le long d'un pignon par Renaud Rénov en Eure-et-Loir",
    href: '/pose-gouttiere-28/',
  },
};

// ── Marques : jeu spécifique à la commune si défini, sinon 4 fabricants ──
const marquesVille = contenu.logos ?? [
  { nom: 'Dalep', url: 'https://www.dalep.com/', logo: '/images/marques/logo-dalep.webp', alt: 'Dalep – traitements hydrofuges et anti-mousse pour toiture' },
  { nom: 'Monier', url: 'https://www.monier.fr/', logo: '/images/marques/logo-monier.webp', alt: 'Monier – tuiles en terre cuite et béton pour la couverture' },
  { nom: 'Edilians', url: 'https://www.edilians.com/', logo: '/images/marques/logo-edilians.webp', alt: 'Edilians – tuiles en terre cuite' },
  { nom: 'Knauf', url: 'https://www.knaufinsulation.fr/', logo: '/images/marques/logo-knauf.webp', alt: 'Knauf – isolation thermique' },
];

// ── Données structurées : la page ENRICHIT le nœud #localbusiness du
// graphe (zone communale + catalogue), elle n'en déclare PAS un second.
// Avant le 14/08/2026, un deuxième RoofingContractor portait le même @id
// dans un script séparé : Google n'avait aucune garantie de fusion.
const enrichissement = {
  areaServed: [...ZONES_SERVIES, commune(nom, cp)],
  hasOfferCatalog: cataloguePrestations(aVille, aSatellite ? slug : undefined),
};
---
<BaseLayout title={contenu.title} description={contenu.metaDesc} enrichissementEntreprise={enrichissement}>
  <!-- ── Fil d'Ariane ─────────────────────────────────────────── -->
  <section class="section section--sans-bas">
    <div class="conteneur">
      <FilAriane items={[{ label: 'Accueil', href: '/' }, { label: `Couvreur ${aVille}` }]} />
    </div>
  </section>

  <!-- ── Hero (modèle home : titre / photo / coches) ──────────── -->
  <section class="hx">
    <div class="conteneur hx__grid">
      <div class="hx__head">
        <h1 class="hx__title">{contenu.h1}</h1>
        <p class="hx__marque">RENAUD RÉNOV</p>
        {contenu.portrait && (
          <p class="hx__artisan">
            <img src="/images/photos/jordy-renaud-artisan-couvreur.webp" alt={`Jordy Renaud, artisan couvreur ${aVille}`} width="240" height="240" />
            <span><strong>Jordy Renaud</strong>Artisan couvreur</span>
          </p>
        )}
      </div>

      <div class="hx__right">
        <img
          class="hx__photo"
          src={contenu.hero?.src ?? '/images/photos/hero-renaud-renov.webp'}
          srcset={contenu.hero?.srcset ?? '/images/photos/hero-renaud-renov-640.webp 640w, /images/photos/hero-renaud-renov-960.webp 960w, /images/photos/hero-renaud-renov-1280.webp 1280w, /images/photos/hero-renaud-renov.webp 1600w'}
          sizes="(min-width: 980px) 46vw, calc(100vw - 2rem)"
          alt={contenu.hero?.alt ?? `Le véhicule de Renaud Rénov devant une maison et sa toiture en tuiles, couvreur ${aVille}`}
          fetchpriority="high"
          width={contenu.hero?.largeur ?? 1600}
          height={contenu.hero?.hauteur ?? 1200}
        />
        <div class="hx__note">
          <div class="hx__note-top">
            <LogoGoogle taille={26} />
            <span class="hx__note-stars" aria-label={`${reviews.note} étoiles sur 5`}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg>
            </span>
          </div>
          <p class="hx__note-txt">Noté <strong>{reviews.note.toLocaleString('fr-FR')}/5</strong> sur Google · {reviews.nombre} avis</p>
        </div>
      </div>

      <div class="hx__body">
        <p class="hx__chapo" set:html={contenu.chapo} />

        <ul class="hx__points">
          {contenu.coches.map((c) => (
            <li>
              <span class="hx__check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M8 12.5l2.5 2.5 5-6"/></svg></span>
              {c}
            </li>
          ))}
        </ul>

        <div class="hx__badges">
          <img src="/images/labels/applicateur-dalep.webp" alt="Applicateur de solutions DALEP certifié" width="240" height="240" loading="lazy" />
          <img src="/images/labels/garantie-decennale-10-ans.webp" alt="Garantie décennale 10 ans" width="220" height="220" loading="lazy" />
        </div>

        <div class="hx__actions">
          <a href="/devis-gratuit/" class="btn btn--rouge">Devis gratuit<FlecheRonde /></a>
          <a href={SITE.telHref} class="btn btn--bleu">
            <svg class="icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 3.5h-2A1.5 1.5 0 0 0 3 5.2C3.4 13 11 20.6 18.8 21a1.5 1.5 0 0 0 1.7-1.5v-2a1.5 1.5 0 0 0-1.3-1.5l-2.5-.35a1.5 1.5 0 0 0-1.4.6l-.7.95a11.5 11.5 0 0 1-4.9-4.9l.95-.7a1.5 1.5 0 0 0 .6-1.4l-.35-2.5a1.5 1.5 0 0 0-1.5-1.3Z"/><path d="M14.5 3.6a5.5 5.5 0 0 1 4.9 4.9"/><path d="M14 7a2.4 2.4 0 0 1 2 2"/></svg>
            {SITE.tel}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Services : 6 cards (ordre propre à la commune) ───────── -->
  <section class="section section--gris">
    <div class="conteneur">
      <h2>{contenu.servicesH2}</h2>
      <div class="grille-cards-4">
        {contenu.cartes.map((c) => {
          const base = CARTES_BASE[c.type];
          return (
            <a href={base.href} class="carte carte-service">
              <img src={base.image} alt={base.alt} loading="lazy" width="400" height="250" />
              <span class="carte-service__corps">
                <h3>{c.titre}</h3>
                <p>{c.texte}</p>
              </span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ── Avis clients ─────────────────────────────────────────── -->
  <AvisCarrousel lieu={aVille} ordre={contenu.avisOrdre} titre={`Ce que pensent mes clients ${aVille}`} />

  <!-- ── CTA photo ────────────────────────────────────────────── -->
  <CtaDevis titre={contenu.ctaTitre} texte={contenu.ctaTexte} />

  <!-- ── Réalisations proches (si renseignées dans villes-contenu.ts) ── -->
  {contenu.realisations && (
    <section class="section section--gris">
      <div class="conteneur">
        <h2>{contenu.realisations.h2}</h2>
        <p class="bloc-intro">{contenu.realisations.intro}</p>
        <div class="grille-realisations">
          {contenu.realisations.cartes.map((r) => (
            <article class="carte carte-service carte-lien">
              <img src={r.image} alt={r.alt} loading="lazy" width="800" height="500" />
              <div class="carte-service__corps">
                <h3><a href={r.href}>{r.titre}</a></h3>
                <p>{r.texte}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ── Section longue : savoir-faire + urbanisme + mairie ───── -->
  <section class="section">
    <div class="conteneur">
      <div class="section__entete">
        <h2>{contenu.finalH2}</h2>
      </div>
      <div class="texte-long">
        {contenu.finalParas.map((p) => <p set:html={p} />)}
      </div>

      <div class="carte mairie-encart">
        <span class="mairie-encart__icone" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V10l7-5 7 5v11"/><path d="M9 21v-6h6v6"/></svg>
        </span>
        <div class="mairie-encart__corps">
          <p class="mairie-encart__invite">
            Avant d'engager des travaux qui modifient l'aspect de votre toiture, renseignez-vous
            auprès du service urbanisme de la <strong>mairie {deVille}</strong> :
          </p>
          <address class="mairie-encart__adresse">{contenu.mairieAdresse}, {cp} {nom}</address>
          <a href={contenu.mairieSite} rel="noopener nofollow" target="_blank" class="btn btn--bleu">
            Site de la mairie {deVille}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Marques & fournisseurs ───────────────────────────────── -->
  <LogosMarques
    marques={marquesVille}
    titre={`Des matériaux de qualité pour vos toitures ${aVille}`}
    intro={`Pour vos travaux de toiture ${aVille}, je sélectionne des matériaux de fabricants reconnus, gage d'une couverture durable.`}
  />

  <!-- ── Communes voisines (si renseignées dans villes-contenu.ts) ── -->
  {contenu.voisines && (
    <section class="section">
      <div class="conteneur">
        <h2>Des interventions dans d'autres communes</h2>
        <ul class="nuage-villes voisines">
          {contenu.voisines.liees.map((l) => (
            <li><a href={`/villes/${l.slug}/`}>{l.ancre}</a></li>
          ))}
          {contenu.voisines.autres.map((c) => (
            <li><span>{c}</span></li>
          ))}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  /* Portrait de l'artisan sous le H1 (même rendu que la page Lucé) */
  .hx__artisan { display: flex; align-items: center; gap: 0.85rem; margin: 1.1rem 0 0; }
  .hx__artisan img { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; flex: none; }
  .hx__artisan span { display: flex; flex-direction: column; line-height: 1.3; color: var(--gris-700); font-size: var(--fs-sm); }
  .hx__artisan strong { color: var(--bleu); font-size: var(--fs-base); }
  @media (max-width: 979px) { .hx__artisan { justify-content: center; } }
  /* Bloc réalisations : cartes liées par le titre, 1 / 2 / 3 colonnes */
  .carte-lien { position: relative; }
  .carte-lien h3 a { color: inherit; text-decoration: none; }
  .carte-lien h3 a::after { content: ""; position: absolute; inset: 0; }
  .bloc-intro { max-width: var(--mesure); margin: 0.75rem auto 0; color: var(--gris-700); text-align: center; }
  @media (max-width: 700px) { .bloc-intro { text-align: left; } }
  .grille-realisations { display: grid; gap: 1.5rem; grid-template-columns: 1fr; margin: 2rem auto 0; max-width: 68rem; }
  @media (min-width: 700px) { .grille-realisations { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .grille-realisations { grid-template-columns: repeat(3, 1fr); } }
  /* Communes voisines : nuage centré (même rendu que la page Lucé) */
  .section .voisines {
    display: flex; flex-wrap: wrap; justify-content: center; gap: 0.6rem;
    max-width: none; margin: 2rem 0 0; padding: 0; list-style: none;
  }
  /* ══ Hero — design de la page d'accueil (repris de index.astro) ══ */
  .hx { padding-block: clamp(1.6rem, 4vw, 3rem); }
  .hx__grid {
    display: grid;
    gap: 1.6rem;
    grid-template-columns: 1fr;
    grid-template-areas: "head" "photo" "body";
  }
  @media (min-width: 980px) {
    .hx__grid {
      grid-template-columns: 1.05fr 1fr;
      grid-template-areas: "head photo" "body photo";
      column-gap: 3.5rem;
      row-gap: 1.1rem;
      align-items: center;
    }
  }
  .hx__head { grid-area: head; }
  .hx__right { grid-area: photo; position: relative; }
  .hx__right::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 42%;
    border-radius: 0 0 24px 24px;
    background: linear-gradient(to top, rgba(15, 34, 45, 0.6), rgba(15, 34, 45, 0));
    pointer-events: none;
    z-index: 1;
  }
  .hx__body { grid-area: body; }
  .hx__title { margin: 0; color: var(--bleu); font-size: var(--fs-h1-hero); line-height: 1.2; letter-spacing: -0.01em; }
  .hx__marque { color: var(--rouge); font-weight: 800; font-size: clamp(1.9rem, 4.4vw, 2.9rem); line-height: 1.1; margin: 0.6rem 0 0; }
  .hx__photo { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 24px; box-shadow: var(--ombre-forte); display: block; }
  @media (min-width: 980px) { .hx__photo { aspect-ratio: 4 / 5; } }

  .hx__chapo { color: var(--gris-700); margin: 0 0 1.2rem; max-width: var(--mesure-etroite); }
  .hx__chapo :global(strong) { color: var(--bleu); }

  .hx__points { list-style: none; padding: 0; margin: 0.4rem 0 1.2rem; display: grid; gap: 0.9rem; }
  .hx__points li {
    display: flex; align-items: center; gap: 0.8rem;
    font-size: var(--fs-md); font-weight: 600; color: var(--bleu);
  }
  .hx__check { color: var(--rouge); flex-shrink: 0; line-height: 0; }
  .hx__check svg { width: 30px; height: 30px; }

  .hx__note {
    position: absolute;
    left: 50%;
    bottom: 1rem;
    transform: translateX(-50%);
    width: max-content;
    max-width: calc(100% - 1.6rem);
    display: flex; flex-direction: column; align-items: center; gap: 0.3rem;
    background: var(--blanc);
    border-radius: 16px;
    box-shadow: 0 14px 34px rgba(15, 34, 45, 0.42);
    padding: 0.8rem 1.5rem;
    z-index: 2;
  }
  .hx__note-top { display: flex; align-items: center; gap: 0.6rem; }
  .hx__note-stars { display: inline-flex; gap: 0.1em; }
  .hx__note-stars svg { width: 1.35rem; height: 1.35rem; fill: var(--etoile); }
  .hx__note-txt { margin: 0; color: var(--gris-700); font-size: var(--fs-base); }
  .hx__note-txt strong { color: var(--bleu); }

  .hx__badges { display: flex; align-items: center; gap: 1.3rem; flex-wrap: wrap; margin: 0 0 1.6rem; }
  .hx__badges img { height: 64px; width: auto; }

  .hx__actions { display: flex; flex-wrap: wrap; gap: 0.8rem; }

  @media (max-width: 979px) {
    .hx__title, .hx__marque { text-align: center; }
    .hx__chapo { margin-inline: auto; }
    .hx__badges, .hx__actions { justify-content: center; }
    .hx__badges img { height: 56px; }
  }

  /* ── Grille des 6 cards de services : 2 colonnes dès 700px, 3 × 2 en desktop ── */
  .grille-cards-4 {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
    margin-top: 2rem;
  }
  @media (min-width: 700px) {
    .grille-cards-4 { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .grille-cards-4 { grid-template-columns: repeat(3, 1fr); }
  }

  /* ── Section longue : colonne de lecture confortable ── */
  .texte-long { max-width: var(--mesure-large); margin: 1.8rem auto 0; display: grid; gap: 1.1rem; }
  .texte-long p { margin: 0; color: var(--gris-700); line-height: 1.65; }

  /* ── Encart mairie : adresse mise en évidence + lien vers le site ── */
  .mairie-encart {
    max-width: var(--mesure-large);
    margin: 2.2rem auto 0;
    padding: clamp(1.5rem, 4vw, 2.2rem);
    display: flex;
    gap: 1.4rem;
    align-items: flex-start;
  }
  .mairie-encart:hover { transform: none; }
  .mairie-encart__icone {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--bleu-pale);
    color: var(--bleu);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .mairie-encart__icone svg { width: 1.6rem; height: 1.6rem; }
  .mairie-encart__invite { margin: 0 0 0.7rem; color: var(--gris-700); max-width: var(--mesure); }
  .mairie-encart__adresse {
    font-style: normal;
    font-weight: 700;
    font-size: var(--fs-lg);
    color: var(--bleu);
    margin: 0 0 1.1rem;
  }
  @media (max-width: 620px) {
    .mairie-encart { flex-direction: column; align-items: center; text-align: center; }
    .mairie-encart__invite { text-align: center; }
  }
</style>
