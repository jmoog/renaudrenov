---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site.ts';
import services from '../../data/services.json';
import villes from '../../data/villes.json';
import { VILLES_CONTENU } from '../../data/villes-contenu.ts';
import FilAriane from '../../components/FilAriane.astro';
import AvisCarrousel from '../../components/AvisCarrousel.astro';
import CtaDevis from '../../components/CtaDevis.astro';
import LogoGoogle from '../../components/LogoGoogle.astro';
import LogosMarques from '../../components/LogosMarques.astro';
import reviews from '../../data/reviews.json';

export function getStaticPaths() {
  return Object.keys(VILLES_CONTENU).map((slug) => {
    const v = villes.find((x) => x.slug === slug)!;
    return { params: { slug }, props: { nom: v.nom, cp: v.cp, contenu: VILLES_CONTENU[slug] } };
  });
}

const { nom, cp, contenu } = Astro.props;
const deptNum = cp.slice(0, 2);

// ── Balises différenciées (anti-triplette sur la page) ──
const title = `Couvreur à ${nom} (${deptNum}) — Renaud Rénov`;
const description = contenu.metaDesc;

// H1 : toujours « Entreprise de couverture à [ville] », focalisé sur la
// commune (jamais « et alentours / environs »), différent du title.
const h1 = `Entreprise de couverture à ${nom}`;

// 2e phrase de l'accroche : focalisée sur la ville du client, sans jamais
// mentionner une autre commune (le siège). Mots-clés en gras.
// Ancre tournante vers l'accueil (page « couvreur 28 ») — variée pour le maillage.
const ancreAccueil = [
  'couvreur en Eure-et-Loir',
  'couvreur dans le 28',
  'artisan couvreur du 28',
][contenu.cardSet % 3];
const heroP2 = `Je suis M. Renaud, <strong>couvreur à ${nom}</strong> : j'interviens rapidement chez vous, mes <strong>devis</strong> sont <strong>gratuits</strong> et sans engagement. Découvrez tous mes services de <a href="/">${ancreAccueil}</a>.`;

const servicesP2 = [
  "Tuile plate de pays, tuile mécanique, ardoise, bac acier ou fibrociment : je maîtrise <strong>tous les matériaux de couverture</strong>, et je réalise la <strong>zinguerie</strong> (noues, solins, chéneaux, gouttières) comme la reprise de <strong>charpente</strong>.",
  "Je travaille la <strong>tuile</strong>, l'<strong>ardoise</strong>, le zinc et le bac acier, et je m'occupe aussi de la <strong>zinguerie</strong> et, quand il le faut, de la reprise de <strong>charpente</strong>.",
  "Des tuiles de pays aux ardoises en passant par le zinc, j'interviens sur toutes les <strong>couvertures</strong>, gouttières et points de <strong>zinguerie</strong>, charpente comprise si nécessaire.",
][contenu.servicesP2i];

const servicesP3 = [
  "Avant tout chantier, je me déplace pour évaluer votre toit et vous remettre un <strong>devis gratuit</strong>. Tous mes travaux sont <strong>garantis décennale</strong>.",
  "Je viens sur place examiner votre toiture, puis je vous propose une solution claire avec un <strong>devis gratuit</strong>. L'ensemble de mes travaux est couvert par la <strong>garantie décennale</strong>.",
][contenu.servicesP3i];

// Paragraphe d'urbanisme (générique) : 3 variantes, avec mise en gras.
const regVariantsHtml = [
  `À ${nom}, l'entretien courant ou une réparation à l'identique ne demande généralement aucune formalité. Mais dès que l'aspect du toit change — nouvelles tuiles, autre teinte, fenêtre de toit — une <strong>déclaration préalable de travaux</strong> s'impose le plus souvent, et un <strong>permis de construire</strong> pour une extension ou une surélévation.`,
  `Avant d'engager des travaux à ${nom}, un point sur l'urbanisme s'impose : réparer à l'identique reste libre, mais modifier l'aspect de la toiture (matériau, couleur, ouverture de toit) suppose en général une <strong>déclaration préalable de travaux</strong>, et un <strong>permis de construire</strong> dès que l'on crée de la surface.`,
  `Tous les travaux de toiture à ${nom} ne se valent pas côté démarches : un simple entretien ne demande rien, tandis qu'un changement d'aspect du toit relève le plus souvent d'une <strong>déclaration préalable</strong>, et une surélévation ou extension d'un <strong>permis de construire</strong>.`,
][contenu.regVariant];

// ── Cards : titre (ville sur les 2 phares) + description en jeux tournants ──
const cardSets: Record<string, string>[] = [
  {
    'nettoyage-demoussage-toiture': "Je débarrasse votre couverture des mousses, lichens et dépôts noirs pour lui rendre propreté et étanchéité.",
    'traitement-hydrofuge': "Résine et hydrofuge appliqués après nettoyage, pour protéger vos tuiles et ralentir le retour des mousses.",
    'reparation-toiture': "Tuile fêlée, ardoise glissée, faîtage ou solin défaillant : je remets vite votre toit à l'abri des infiltrations.",
    'renovation-toiture': "Couverture fatiguée ou vétuste : reprise partielle ou toit entièrement refait, pour repartir sur une base saine.",
    zinguerie: "Travail du zinc pour vos noues, solins de cheminée et chéneaux, garant d'une étanchéité qui dure.",
    'pose-gouttiere': "Gouttières et descentes posées ou remplacées pour évacuer les eaux de pluie loin de vos murs et fondations.",
  },
  {
    'nettoyage-demoussage-toiture': "J'élimine mousses, lichens et traînées noires pour rendre à votre toit son étanchéité et son aspect d'origine.",
    'traitement-hydrofuge': "J'applique résine et hydrofuge pour protéger durablement vos tuiles et freiner la repousse des mousses.",
    'reparation-toiture': "Tuile cassée, ardoise déplacée, faîtage abîmé ou fuite : j'interviens vite pour remettre votre toit hors d'eau.",
    'renovation-toiture': "Reprise partielle ou toit entièrement refait : liteaunage, écran sous-toiture et couverture neuve, saine et durable.",
    zinguerie: "Noues, solins de cheminée, chéneaux et abergements en zinc pour une étanchéité parfaite face aux intempéries.",
    'pose-gouttiere': "Pose et remplacement de gouttières et descentes pour évacuer les eaux de pluie et protéger vos façades.",
  },
  {
    'nettoyage-demoussage-toiture': "Démoussage et nettoyage adaptés à votre couverture, pour un toit sain, propre et durablement protégé.",
    'traitement-hydrofuge': "Un traitement hydrofuge qui fait perler l'eau, limite les mousses et prolonge la vie de vos tuiles.",
    'reparation-toiture': "Fuite, tuile ou ardoise à remplacer, faîtage descellé : intervention rapide pour sécuriser votre toiture.",
    'renovation-toiture': "De la reprise ponctuelle à la réfection totale, je redonne étanchéité et solidité à votre toit pour longtemps.",
    zinguerie: "Noues, chéneaux, solins et abergements réalisés en zinc, là où l'étanchéité de votre toit se joue vraiment.",
    'pose-gouttiere': "Installation et remplacement de gouttières et descentes pour maîtriser l'évacuation des eaux de pluie.",
  },
][contenu.cardSet];

const cardTitre: Record<string, string> = {
  'nettoyage-demoussage-toiture': `Nettoyage et démoussage de toiture à ${nom}`,
  'traitement-hydrofuge': 'Traitement hydrofuge de toiture',
  'reparation-toiture': `Réparation de toiture à ${nom}`,
  'renovation-toiture': 'Rénovation et réfection de toiture',
  zinguerie: 'Zinguerie : noues, chéneaux, cheminées',
  'pose-gouttiere': 'Pose de gouttière',
};

// ── Marques : jeu spécifique à la commune si défini, sinon 4 fabricants ──
const marquesVille = contenu.logos ?? [
  { nom: 'Dalep', url: 'https://www.dalep.com/', logo: '/images/marques/logo-dalep.webp', alt: 'Dalep – traitements hydrofuges et anti-mousse pour toiture' },
  { nom: 'Monier', url: 'https://www.monier.fr/', logo: '/images/marques/logo-monier.webp', alt: 'Monier – tuiles en terre cuite et béton pour la couverture' },
  { nom: 'Edilians', url: 'https://www.edilians.com/', logo: '/images/marques/logo-edilians.webp', alt: 'Edilians – tuiles en terre cuite' },
  { nom: 'Knauf', url: 'https://www.knaufinsulation.fr/', logo: '/images/marques/logo-knauf.webp', alt: 'Knauf – isolation thermique' },
];

// ── Schema : même @id que la fiche globale (fusion) + areaServed ville ──
const businessId = `${SITE.url}/#localbusiness`;
const schemaVille = {
  '@context': 'https://schema.org',
  '@type': 'RoofingContractor',
  '@id': businessId,
  name: SITE.nom,
  url: SITE.url,
  areaServed: [
    { '@type': 'AdministrativeArea', name: `${SITE.departement} (${SITE.departementNum})` },
    { '@type': 'City', name: nom, postalCode: cp },
  ],
  knowsAbout: [
    'Nettoyage de toiture',
    'Démoussage de toiture',
    'Traitement hydrofuge',
    'Réparation de toiture',
    'Rénovation de toiture',
    'Zinguerie',
    'Pose de gouttière',
    'Couverture tuile et ardoise',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: `Prestations de couverture à ${nom}`,
    itemListElement: services.map((s, i) => ({
      '@type': 'Offer',
      position: i + 1,
      itemOffered: { '@type': 'Service', name: s.label, url: `${SITE.url}${s.href}`, provider: { '@id': businessId } },
    })),
  },
};
---
<BaseLayout title={title} description={description} extraSchemas={[schemaVille]}>
  <!-- ── Fil d'Ariane ─────────────────────────────────────────── -->
  <section class="section" style="padding-block: 1.5rem 0;">
    <div class="conteneur">
      <FilAriane items={[{ label: 'Accueil', href: '/' }, { label: `Couvreur à ${nom}` }]} />
    </div>
  </section>

  <!-- ── Hero ─────────────────────────────────────────────────── -->
  <section class="hero" style="padding-top: 1.5rem;">
    <div class="conteneur hero__grille">
      <div class="hero__texte">
        <h1>{h1}</h1>
        <p class="hero__marque">RENAUD RÉNOV</p>
        <p class="hero__google">
          <LogoGoogle taille={20} />
          <span class="hero__etoiles" aria-hidden="true">★★★★★</span>
          <strong>{reviews.note.toLocaleString('fr-FR')}/5 sur Google · {reviews.nombre} avis</strong>
        </p>
        <div class="hero__accroche hero__encadre">
          <p set:html={contenu.heroP1} />
          <p set:html={heroP2} />
        </div>
        <div class="hero__actions">
          <a href={SITE.telHref} class="btn btn--rouge">
            <svg class="icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 3.5h-2A1.5 1.5 0 0 0 3 5.2C3.4 13 11 20.6 18.8 21a1.5 1.5 0 0 0 1.7-1.5v-2a1.5 1.5 0 0 0-1.3-1.5l-2.5-.35a1.5 1.5 0 0 0-1.4.6l-.7.95a11.5 11.5 0 0 1-4.9-4.9l.95-.7a1.5 1.5 0 0 0 .6-1.4l-.35-2.5a1.5 1.5 0 0 0-1.5-1.3Z"/><path d="M14.5 3.6a5.5 5.5 0 0 1 4.9 4.9"/><path d="M14 7a2.4 2.4 0 0 1 2 2"/></svg>
            {SITE.tel}
          </a>
          <a href="/devis-gratuit/" class="btn btn--bleu">Devis gratuit →</a>
        </div>
      </div>

      <div class="hero__media">
        <img
          class="hero__photo"
          src="/images/photos/hero-renaud-renov.webp"
          srcset="/images/photos/hero-renaud-renov-640.webp 640w, /images/photos/hero-renaud-renov-960.webp 960w, /images/photos/hero-renaud-renov-1280.webp 1280w, /images/photos/hero-renaud-renov.webp 1600w"
          sizes="(min-width: 980px) 540px, 94vw"
          alt={`Le véhicule de Renaud Rénov devant une maison et sa toiture en tuiles, couvreur à ${nom}`}
          fetchpriority="high"
          width="1600"
          height="1200"
        />
        <div class="carte hero__garantie">
          <img src="/images/logo/logo-renaud-renov-128.webp" alt="" width="80" height="80" loading="lazy" />
          <p><strong>Garantie décennale</strong><br />Pour tous travaux de couverture</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Avis clients ─────────────────────────────────────────── -->
  <AvisCarrousel lieu={`à ${nom}`} ordre={contenu.avisOrdre} titre={`Ce que pensent mes clients à ${nom}`} />

  <!-- ── Services (cards) ─────────────────────────────────────── -->
  <section class="section section--gris">
    <div class="conteneur">
      <h2>Mes services de couvreur à {nom}</h2>
      <div class="encadre">
        <p set:html={contenu.servicesP1} />
        <p set:html={servicesP2} />
        <p set:html={servicesP3} />
      </div>
      <div class="grille-services">
        {services.map((s) => (
          <a href={s.href} class="carte carte-service">
            <img src={s.image} alt={s.alt} loading="lazy" width="400" height="250" />
            <span class="carte-service__corps">
              <h3>{cardTitre[s.slug] ?? s.label}</h3>
              <p>{cardSets[s.slug] ?? s.accroche}</p>
              <span class="carte-service__lien">{s.lien} →</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Autorisations en mairie ──────────────────────────────── -->
  <section class="section">
    <div class="conteneur">
      <h2>Toiture et règles d'urbanisme à {nom}</h2>
      <div class="duo mairie-duo">
        <div>
          <p set:html={regVariantsHtml} />
          <p>{contenu.urbanismeNote}</p>
        </div>
        <div class="carte mairie">
          <span class="mairie__icone" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V10l7-5 7 5v11"/><path d="M9 21v-6h6v6"/></svg>
          </span>
          <p class="mairie__nom"><strong>Mairie de {nom}</strong></p>
          <address>{contenu.mairieAdresse}, {cp} {nom}</address>
          <a href={contenu.mairieSite} rel="noopener nofollow" target="_blank" class="btn btn--bleu mairie__lien">
            Site de la mairie →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Marques & fournisseurs ───────────────────────────────── -->
  <LogosMarques
    marques={marquesVille}
    titre={`Des matériaux de qualité pour vos toitures à ${nom}`}
    intro={`Pour vos travaux de toiture à ${nom}, je sélectionne des matériaux de fabricants reconnus, gage d'une couverture durable.`}
  />

  <!-- ── CTA devis ────────────────────────────────────────────── -->
  <CtaDevis titre={`Contactez-moi pour votre toit à ${nom}`} />
</BaseLayout>

<style>
  .hero__encadre {
    background: var(--bleu-pale);
    border-left: 4px solid var(--rouge);
    border-radius: var(--rayon);
    padding: 1.2rem 1.4rem;
    margin-bottom: 1.4rem;
  }
  .hero__encadre p { margin: 0; color: var(--gris-700); }
  .hero__encadre p + p { margin-top: 0.8rem; }

  .encadre {
    background: var(--bleu-pale);
    border-left: 4px solid var(--rouge);
    border-radius: var(--rayon);
    padding: clamp(1.3rem, 3vw, 1.8rem);
    margin-top: 1.5rem;
  }
  .encadre p { margin: 0; color: var(--gris-700); }
  .encadre p + p { margin-top: 0.9rem; }

  .mairie-duo { margin-top: 1.5rem; }
  .mairie {
    padding: clamp(1.5rem, 4vw, 2rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
  }
  .mairie:hover { transform: none; }
  .mairie__icone {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--bleu-pale);
    color: var(--bleu);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.5rem;
  }
  .mairie__icone svg { width: 1.5rem; height: 1.5rem; }
  .mairie__nom { font-size: 1.15rem; margin: 0; color: var(--bleu); }
  .mairie address { font-style: normal; color: var(--gris-700); margin: 0 0 1rem; }
  .mairie__lien { margin-top: 0.2rem; }
</style>
