---
// ─────────────────────────────────────────────────────────────────────────
// /villes/luce/ — page ville DÉDIÉE (14/11/2026, plan validé dans Notion
// « Couvreur LUCÉ »).
//
// Différences avec le gabarit villes/[slug].astro :
//  - cartes de services avec le lien porté par le H3 (carte cliquable par
//    ::after), plus de <a> englobant toute la carte ;
//  - CTA placé juste après les services, pas de CTA final ;
//  - avis RÉSERVÉS à cette page (champ `reserve: "luce"` de reviews.json) ;
//  - bloc « Quelques réalisations dans votre ville » (chantiers réels) ;
//  - trois cartes fournisseurs avec adresse + logos fabricants ;
//  - une carte vers la commune voisine (Chartres).
//
// Règles du site : H1 sans prestation ni département, pas d'eyebrow, pas de
// barre colorée, jamais de bouton pleine largeur, aucun délai chiffré.
// ─────────────────────────────────────────────────────────────────────────
import FlecheRonde from '../../components/FlecheRonde.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site.ts';
import { ZONES_SERVIES, commune, cataloguePrestations } from '../../lib/schema.ts';
import FilAriane from '../../components/FilAriane.astro';
import AvisCarrousel from '../../components/AvisCarrousel.astro';
import CtaDevis from '../../components/CtaDevis.astro';
import LogoGoogle from '../../components/LogoGoogle.astro';
import reviews from '../../data/reviews.json';

const ville = 'Lucé';
const cp = '28110';

const title = 'Artisan couvreur à Lucé (28) — Devis gratuit — Renaud Rénov';
const description =
  'M. Renaud, couvreur à Lucé, rénove, répare et entretient vos toitures : réfection de couverture, démoussage, zinguerie. ✓ Devis gratuit ✓ 02 34 40 17 61.';

// ── Les 6 services, dans l'ordre propre à Lucé. `texte` est du HTML. ──
// Le lien ne porte que sur la prestation (`titre`) : l'ancre reste exacte
// pour la page de service du 28, et « … à Lucé » est réservée aux réalisations.
const cartes = [
  {
    titre: 'Rénovation de toiture',
    suffixe: ' à Lucé', // dans le titre, hors de l'ancre du lien
    href: '/renovation-toiture-28/',
    image: '/images/photos/renovation-toiture.webp',
    alt: 'Rénovation de toiture avec liteaunage neuf sur charpente en Eure-et-Loir',
    texte:
      "Tuiles fendues, liteaux fatigués, couverture en fin de vie : je dépose l'ancienne toiture, puis je pose un écran de sous-toiture, un liteaunage neuf et des tuiles neuves. C'est le chantier que j'ai mené sur un pavillon de Lucé en décembre 2025.",
  },
  {
    titre: 'Nettoyage de façade',
    suffixe: ' à Lucé', // dans le titre, hors de l'ancre du lien
    href: '/nettoyage-facade-28/',
    image: '/images/photos/facade-pignon-sale-28.webp',
    alt: "Façade et pignon avant nettoyage dans le 28 — coulures et traces d'humidité",
    texte:
      "Murs verdis, coulures sous les appuis de fenêtre, descente de garage noircie : je nettoie et je traite les façades, les pignons et les sols extérieurs avec des produits adaptés au support. Vos murs retrouvent leur teinte d'origine.",
  },
  {
    titre: 'Réparation de toiture',
    href: '/reparation-toiture-28/',
    image: '/images/photos/reparation-toiture.webp',
    alt: "Réparation du faîtage d'une toiture en tuiles en Eure-et-Loir",
    texte:
      "Une tuile cassée, une ardoise déplacée, une infiltration au plafond : j'interviens rapidement, je recherche l'origine de la fuite et je remets votre toit hors d'eau.",
  },
  {
    titre: 'Nettoyage et démoussage de toiture à Lucé',
    href: '/nettoyage-toiture-luce/',
    image: '/images/photos/nettoyage-demoussage-toiture.webp',
    alt: 'Artisan Renaud Rénov nettoyant une toiture au jet en Eure-et-Loir',
    texte:
      "Les mousses retiennent l'humidité et finissent par rendre les tuiles poreuses. Je démousse votre toiture, puis j'applique un traitement anti-mousse Dalep, dont je suis applicateur certifié. Un <a href=\"/traitement-hydrofuge-28/\">traitement hydrofuge</a> peut compléter le nettoyage.",
  },
  {
    titre: 'Travaux de zinguerie',
    href: '/zinguerie-28/',
    image: '/images/photos/zinguerie-epi.webp',
    alt: 'Épi de faîtage en zinc réalisé par Renaud Rénov, artisan couvreur-zingueur en Eure-et-Loir',
    texte:
      "Noues, solins, abergements de cheminée, rives : ces pièces de zinc protègent les points sensibles du toit. J'assure leur entretien, leur réparation et leur remplacement, avec des pièces façonnées sur mesure.",
  },
  {
    titre: 'Gouttières et descentes',
    href: '/pose-gouttiere-28/',
    image: '/images/photos/gouttiere-descente.webp',
    alt: "Descente de gouttière posée le long d'un pignon par Renaud Rénov en Eure-et-Loir",
    texte:
      "Une gouttière qui déborde abîme la façade et le pied des murs. Je pose et je remplace vos gouttières et vos descentes à Lucé, en zinc, en aluminium ou en PVC, avec des pentes réglées pour que l'eau s'évacue.",
  },
];

// ── Chantiers réalisés à Lucé. `href` reste vide tant que la page
// réalisation n'existe pas : le titre s'affiche alors sans lien (aucun 404).
// Quand la page est créée, renseigner `href` suffit. ──
const realisations = [
  {
    titre: "Rénovation d'une toiture en tuiles à Lucé",
    href: '/realisations/renovation-toiture-luce/',
    image: '/images/photos/renovation-toiture-luce-pavillon.webp',
    alt: "Pavillon de Lucé et sa toiture en tuiles avant la rénovation par Renaud Rénov",
    texte:
      "Décembre 2025. Sous les tuiles, des liteaux pourris et des tuiles fendues : la couverture a été entièrement déposée puis refaite, avec un écran de sous-toiture et un liteaunage neuf.",
  },
  {
    titre: "Nettoyage de façade d'un pavillon à Lucé",
    href: '/realisations/nettoyage-facade-luce/',
    image: '/images/photos/nettoyage-facade-luce-pignon-apres.webp',
    alt: "Pignon d'un pavillon à Lucé après nettoyage de la façade par Renaud Rénov",
    texte:
      "Mai 2026. Le pignon et la descente de garage étaient noircis par les mousses. Après nettoyage et traitement, l'enduit et le béton ont retrouvé leur teinte claire.",
  },
];

// ── Section longue (4 paragraphes HTML, le dernier finit par l'urbanisme) ──
const finalParas = [
  "Refaire une toiture est un chantier qui engage votre maison pour plusieurs décennies. Le confier à un artisan couvreur, c'est d'abord obtenir un diagnostic fiable : j'examine la couverture, le bois qui la porte et la zinguerie avant de vous proposer quoi que ce soit. C'est aussi bénéficier de garanties écrites. Mes travaux de couverture sont couverts par la garantie décennale, mon devis est détaillé poste par poste, et je suis applicateur certifié des solutions Dalep pour le démoussage des toitures et le <a href=\"/nettoyage-facade-28/\">nettoyage de façade</a>.",
  "Sur un pavillon couvert en tuiles mécaniques, comme <a href=\"/realisations/renovation-toiture-luce/\">celui que j'ai rénové à Lucé</a>, ce sont rarement les tuiles qui cèdent en premier. Les liteaux, ces lattes de bois sur lesquelles elles reposent, noircissent puis pourrissent quand l'humidité s'installe. Les tuiles se fendent ensuite, glissent, et la pluie trouve son chemin. Vu du jardin, le toit paraît encore en état : c'est en soulevant quelques tuiles que l'on mesure son usure réelle.",
  "Tout ne se remplace pas pour autant. Quand le bois est sain et que seules quelques tuiles sont abîmées, une <a href=\"/reparation-toiture-28/\">réparation de toiture</a> suffit, et je vous le dis. Quand les liteaux sont atteints sur l'ensemble du toit, la réfection de la couverture devient la solution durable, avec un écran de sous-toiture et un liteaunage neuf. Vos murs méritent la même attention : les mousses, les traînées noires et les coulures d'un pignon se nettoient avec des produits qui respectent l'enduit.",
  "Le choix du matériau se fait avec vous : tuile mécanique, tuile plate, ardoise ou zinc, chacun a sa pente, son aspect et sa durée de vie. Avant le démarrage, pensez à la réglementation. Refaire une toiture en modifiant son aspect, par exemple la couleur ou le type de tuile, relève du code de l'urbanisme et du plan local d'urbanisme : une déclaration préalable de travaux est souvent exigée, et son instruction demande plusieurs semaines. Le service urbanisme de la mairie de Lucé vous indiquera les règles qui s'appliquent à votre adresse.",
];

// ── Fournisseurs (adresses vérifiées le 14/11/2026) et fabricants ──
const fournisseurs = [
  {
    nom: 'Larivière Chartres',
    adresse: '27 rue de Fontenay, 28110 Lucé',
    url: 'https://www.lariviere.fr/trouver-votre-agence/lariviere-SEB/entry-383-lariviere-chartres.html',
    logo: '/images/marques/logo-lariviere.webp',
    alt: 'Larivière Chartres, négoce spécialisé en couverture installé à Lucé',
  },
  {
    nom: 'Point P Chartres-Mainvilliers',
    adresse: "46 rue du Château-d'Eau, 28300 Mainvilliers",
    url: 'https://www.pointp.fr/infos-agence/chartres-mainvilliers-point-p-3370',
    logo: '/images/marques/logo-point-p.webp',
    alt: 'Point P Chartres-Mainvilliers, distributeur de matériaux de couverture',
  },
  {
    nom: 'Raboni Trappes',
    adresse: '19 rue François-Arago, 78190 Trappes',
    url: 'https://www.raboni.fr/',
    logo: '/images/marques/logo-raboni.webp',
    alt: 'Raboni Trappes, matériaux de construction et de couverture',
  },
];
const fabricants = [
  { nom: 'Dalep', url: 'https://www.dalep.com/', logo: '/images/marques/logo-dalep.webp', alt: 'Dalep – traitements hydrofuges et anti-mousse pour toiture' },
  { nom: 'Monier', url: 'https://www.monier.fr/', logo: '/images/marques/logo-monier.webp', alt: 'Monier – tuiles en terre cuite et béton pour la couverture' },
  { nom: 'Edilians', url: 'https://www.edilians.com/', logo: '/images/marques/logo-edilians.webp', alt: 'Edilians – tuiles en terre cuite' },
  { nom: 'Knauf', url: 'https://www.knaufinsulation.fr/', logo: '/images/marques/logo-knauf.webp', alt: 'Knauf – isolation thermique' },
];

// ── Données structurées : enrichit le nœud #localbusiness (zone + catalogue) ──
// Le démoussage a sa page propre à Lucé : le catalogue pointe vers elle.
const catalogue = cataloguePrestations(`à ${ville}`, 'luce');
const enrichissement = {
  areaServed: [...ZONES_SERVIES, commune(ville, cp)],
  hasOfferCatalog: catalogue,
};
---
<BaseLayout
  title={title}
  description={description}
  enrichissementEntreprise={enrichissement}
  lcpImage="/images/photos/couvreur-luce-renovation-toiture.webp"
  lcpSrcset="/images/photos/couvreur-luce-renovation-toiture-640.webp 640w, /images/photos/couvreur-luce-renovation-toiture-960.webp 960w, /images/photos/couvreur-luce-renovation-toiture-1280.webp 1280w, /images/photos/couvreur-luce-renovation-toiture.webp 1600w"
  lcpSizes="(min-width: 980px) 46vw, calc(100vw - 2rem)"
>
  <!-- ── Fil d'Ariane ─────────────────────────────────────────── -->
  <section class="section section--sans-bas">
    <div class="conteneur">
      <FilAriane items={[{ label: 'Accueil', href: '/' }, { label: `Couvreur à ${ville}` }]} />
    </div>
  </section>

  <!-- ── Hero ─────────────────────────────────────────────────── -->
  <section class="hx">
    <div class="conteneur hx__grid">
      <div class="hx__head">
        <h1 class="hx__title">Couvreur zingueur à Lucé</h1>
        <p class="hx__marque">RENAUD RÉNOV</p>
        <p class="hx__artisan">
          <img src="/images/photos/jordy-renaud-artisan-couvreur.webp" alt="Jordy Renaud, artisan couvreur à Lucé" width="240" height="240" />
          <span><strong>Jordy Renaud</strong>Artisan couvreur</span>
        </p>
      </div>

      <div class="hx__right">
        <img
          class="hx__photo"
          src="/images/photos/couvreur-luce-renovation-toiture.webp"
          srcset="/images/photos/couvreur-luce-renovation-toiture-640.webp 640w, /images/photos/couvreur-luce-renovation-toiture-960.webp 960w, /images/photos/couvreur-luce-renovation-toiture-1280.webp 1280w, /images/photos/couvreur-luce-renovation-toiture.webp 1600w"
          sizes="(min-width: 980px) 46vw, calc(100vw - 2rem)"
          alt="Rénovation d'une toiture à Lucé par Renaud Rénov : écran de sous-toiture et liteaux neufs avant la pose des tuiles"
          fetchpriority="high"
          width="1600"
          height="1200"
        />
        <div class="hx__note">
          <div class="hx__note-top">
            <LogoGoogle taille={26} />
            <span class="hx__note-stars" aria-label={`${reviews.note} étoiles sur 5`}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg>
            </span>
          </div>
          <p class="hx__note-txt">Noté <strong>{reviews.note.toLocaleString('fr-FR')}/5</strong> sur Google · {reviews.nombre} avis</p>
        </div>
      </div>

      <div class="hx__body">
        <p class="hx__chapo">
          Vous avez besoin d'un artisan couvreur pour une intervention sur votre toiture à Lucé ?
          Vous souhaitez réparer votre toit, retirer les mousses qui l'envahissent, nettoyer les
          façades de votre pavillon ou refaire complètement une toiture ancienne ? Renaud Rénov est
          votre <strong>couvreur à Lucé</strong>.
        </p>

        <ul class="hx__points">
          {['Garantie décennale', 'Devis gratuit', 'Tous matériaux de couverture'].map((c) => (
            <li>
              <span class="hx__check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M8 12.5l2.5 2.5 5-6"/></svg></span>
              {c}
            </li>
          ))}
        </ul>

        <div class="hx__badges">
          <img src="/images/labels/applicateur-dalep.webp" alt="Applicateur de solutions DALEP certifié" width="240" height="240" loading="lazy" />
          <img src="/images/labels/garantie-decennale-10-ans.webp" alt="Garantie décennale 10 ans" width="220" height="220" loading="lazy" />
        </div>

        <div class="hx__actions">
          <a href="/devis-gratuit/" class="btn btn--rouge">Devis gratuit<FlecheRonde /></a>
          <a href={SITE.telHref} class="btn btn--bleu">
            <svg class="icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 3.5h-2A1.5 1.5 0 0 0 3 5.2C3.4 13 11 20.6 18.8 21a1.5 1.5 0 0 0 1.7-1.5v-2a1.5 1.5 0 0 0-1.3-1.5l-2.5-.35a1.5 1.5 0 0 0-1.4.6l-.7.95a11.5 11.5 0 0 1-4.9-4.9l.95-.7a1.5 1.5 0 0 0 .6-1.4l-.35-2.5a1.5 1.5 0 0 0-1.5-1.3Z"/><path d="M14.5 3.6a5.5 5.5 0 0 1 4.9 4.9"/><path d="M14 7a2.4 2.4 0 0 1 2 2"/></svg>
            {SITE.tel}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Services : 6 cartes, lien porté par le H3 ────────────── -->
  <section class="section section--gris">
    <div class="conteneur">
      <h2>Entreprise de couverture à Lucé : mes services pour votre toit et les façades de votre logement</h2>
      <div class="grille-cards-4">
        {cartes.map((c) => (
          <article class="carte carte-service carte-lien">
            <img src={c.image} alt={c.alt} loading="lazy" width="400" height="250" />
            <div class="carte-service__corps">
              <h3><a href={c.href}>{c.titre}</a>{c.suffixe}</h3>
              <p set:html={c.texte} />
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA (juste après les services) ───────────────────────── -->
  <CtaDevis
    titre="Faites intervenir votre couvreur à Lucé"
    texte="Vous avez un projet de rénovation de toiture ? Votre toit a besoin d'un démoussage ou d'une réparation ? Renaud Rénov intervient rapidement à Lucé. Confiez-moi l'entretien de votre toiture et de vos façades : le devis est gratuit et sans engagement."
  />

  <!-- ── Avis réservés à la page Lucé ─────────────────────────── -->
  <AvisCarrousel reserve="luce" titre="Les avis de mes clients satisfaits de mon travail de couvreur" />

  <!-- ── Réalisations à Lucé ──────────────────────────────────── -->
  <section class="section section--gris">
    <div class="conteneur">
      <h2>Quelques réalisations dans votre ville</h2>
      <p class="bloc-intro">
        Une rénovation de toiture à Lucé, le nettoyage des extérieurs d'un pavillon : voici deux
        chantiers que j'ai menés dans votre commune.
      </p>
      <div class="grille-realisations">
        {realisations.map((r) => (
          <article class={`carte carte-service ${r.href ? 'carte-lien' : 'carte-fixe'}`}>
            <img src={r.image} alt={r.alt} loading="lazy" width="800" height="500" />
            <div class="carte-service__corps">
              <h3>{r.href ? <a href={r.href}>{r.titre}</a> : r.titre}</h3>
              <p>{r.texte}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Section longue : réfection + urbanisme + mairie ──────── -->
  <section class="section">
    <div class="conteneur">
      <div class="section__entete">
        <h2>Faites appel à un artisan couvreur pour la réfection de votre toiture</h2>
      </div>
      <div class="texte-long">
        {finalParas.map((p) => <p set:html={p} />)}
      </div>

      <div class="carte mairie-encart">
        <span class="mairie-encart__icone" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V10l7-5 7 5v11"/><path d="M9 21v-6h6v6"/></svg>
        </span>
        <div class="mairie-encart__corps">
          <p class="mairie-encart__invite">
            Avant d'engager des travaux qui modifient l'aspect de votre toiture, renseignez-vous
            auprès du service urbanisme de la <strong>mairie de {ville}</strong> :
          </p>
          <address class="mairie-encart__adresse">5 rue Jules-Ferry, {cp} {ville}</address>
          <a href="https://www.lucé.fr/" rel="noopener nofollow" target="_blank" class="btn btn--bleu">
            Site de la mairie de {ville}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Matériaux : fournisseurs (adresse) + fabricants ──────── -->
  <section class="section section--gris materiaux">
    <div class="conteneur">
      <h2>Des matériaux de qualité pour vos toitures à Lucé</h2>
      <p class="bloc-intro">
        Pour mes chantiers à Lucé, je m'approvisionne auprès de négoces spécialisés et de
        fabricants reconnus.
      </p>
      <ul class="fournisseurs">
        {fournisseurs.map((f) => (
          <li class="carte carte-lien fournisseur">
            <img src={f.logo} alt={f.alt} loading="lazy" height="56" />
            <h3><a href={f.url} rel="noopener" target="_blank">{f.nom}</a></h3>
            <address>{f.adresse}</address>
          </li>
        ))}
      </ul>
      <ul class="fabricants">
        {fabricants.map((m) => (
          <li>
            <a href={m.url} class="carte fabricants__carte" rel="noopener" target="_blank" aria-label={m.nom}>
              <img src={m.logo} alt={m.alt} loading="lazy" height="56" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── Communes voisines ─────────────────────────────────────── -->
  <section class="section">
    <div class="conteneur">
      <h2>Des interventions dans d'autres communes</h2>
      <ul class="nuage-villes voisines">
        <li><a href="/villes/chartres/">Couvreur à Chartres</a></li>
        <li><a href="/villes/mainvilliers/">Couvreur à Mainvilliers</a></li>
        <li><a href="/villes/luisant/">Couvreur à Luisant</a></li>
        <li><a href="/villes/leves/">Couvreur à Lèves</a></li>
        <li><a href="/villes/le-coudray/">Couvreur au Coudray</a></li>
        {['Amilly', 'Barjouville'].map((c) => (
          <li><span>{c}</span></li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  /* ══ Hero — design de la page d'accueil (repris de index.astro) ══ */
  .hx { padding-block: clamp(1.6rem, 4vw, 3rem); }
  .hx__grid {
    display: grid;
    gap: 1.6rem;
    grid-template-columns: 1fr;
    grid-template-areas: "head" "photo" "body";
  }
  @media (min-width: 980px) {
    .hx__grid {
      grid-template-columns: 1.05fr 1fr;
      grid-template-areas: "head photo" "body photo";
      column-gap: 3.5rem;
      row-gap: 1.1rem;
      align-items: center;
    }
  }
  .hx__head { grid-area: head; }
  .hx__right { grid-area: photo; position: relative; }
  .hx__right::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 42%;
