---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site.ts';
import FilAriane from '../../components/FilAriane.astro';
import AvisCarrousel from '../../components/AvisCarrousel.astro';
import CtaDevis from '../../components/CtaDevis.astro';
import PrestationsConnexes from '../../components/PrestationsConnexes.astro';

const title = 'Pose et remplacement de gouttières en Eure-et-Loir (28)';
const description =
  "Gouttière percée ou descente à remplacer ? Renaud Rénov pose des gouttières durables qui protègent façade et fondations. Devis gratuit dans tout le 28.";
---
<BaseLayout title={title} description={description}>
  <!-- ── Hero prestation ──────────────────────────────────────── -->
  <section class="section">
    <div class="conteneur">
      <FilAriane items={[{ label: 'Accueil', href: '/' }, { label: 'Pose de gouttière' }]} />
    </div>
    <div class="conteneur duo">
      <div>
        <h1>Des gouttières posées et raccordées par un couvreur du 28</h1>
        <p class="hero__accroche">
          Une gouttière percée, qui déborde ou une descente à remplacer ? Renaud Rénov, artisan
          couvreur en <strong>Eure-et-Loir (28)</strong>, pose, remplace et raccorde vos gouttières
          pour évacuer les eaux de pluie et protéger votre maison.
        </p>
        <p>
          Une évacuation des eaux bien pensée, c'est une façade et des fondations préservées année
          après année.
        </p>
        <div class="hero__actions">
          <a href={SITE.telHref} class="btn btn--rouge">
            <svg class="icone" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .57 3.6 1 1 0 0 1-.25 1z"/></svg>
            {SITE.tel}
          </a>
          <a href="/devis-gratuit/" class="btn btn--bleu">Devis gratuit →</a>
        </div>
      </div>
      <img
        src="/images/photos/gouttiere-descente.webp"
        alt="Descente de gouttière posée le long d'un pignon par Renaud Rénov en Eure-et-Loir"
        fetchpriority="high"
        width="2000"
        height="1500"
      />
    </div>
  </section>

  <!-- ── Pourquoi de bonnes gouttières ────────────────────────── -->
  <section class="section section--gris">
    <div class="conteneur">
      <div class="section__entete section__entete--gauche">
        <h2>Pourquoi de bonnes gouttières sont essentielles ?</h2>
      </div>
      <p>
        La gouttière a un rôle simple mais capital : recueillir l'eau du toit et l'éloigner de la
        maison. Quand elle est percée, bouchée ou mal posée, l'eau ruisselle le long des murs, tache
        la façade, s'infiltre et finit par atteindre les fondations. Des dégâts discrets au départ,
        mais coûteux à réparer.
      </p>
      <p>
        Des gouttières en bon état, c'est une maison protégée du sol au toit. En canalisant les eaux
        de pluie vers le bon endroit, on préserve la façade, on garde les fondations au sec et on
        évite l'humidité qui remonte. Un équipement modeste qui protège durablement tout votre bien.
      </p>
      <h3>Pose, remplacement et raccordement</h3>
      <p>
        Pose de gouttières neuves, remplacement d'installations vétustes, descentes et raccords : nous
        assurons une évacuation des eaux fiable et soignée. Ces travaux s'inscrivent dans la
        continuité de la <a href="/prestations/zinguerie/">zinguerie</a> et accompagnent souvent une
        <a href="/prestations/renovation-toiture/">rénovation de toiture</a>.
      </p>
    </div>
  </section>

  <!-- ── Savoir-faire Renaud Rénov ────────────────────────────── -->
  <section class="section">
    <div class="conteneur duo duo--inverse">
      <div>
        <h2>Votre artisan pour la pose de gouttières en Eure-et-Loir</h2>
        <p>
          Installés à <strong>{SITE.ville}</strong>, nous intervenons pour la pose et le remplacement
          de gouttières dans toute l'<strong>Eure-et-Loir (28)</strong>. Un travail de couvreur-zingueur
          réalisé avec le même soin que le reste de votre toiture.
        </p>
        <p>
          Entreprise familiale père et fils, nous vous conseillons le matériau et la section adaptés à
          votre maison, puis réalisons une pose propre et durable. Devis gratuit, sans engagement, et
          garantie décennale sur nos travaux.
        </p>
        <a href="/devis-gratuit/" class="btn btn--bleu">Poser ou remplacer mes gouttières</a>
      </div>
      <img
        src="/images/photos/gouttiere-zinc.webp"
        alt="Gouttière en zinc neuve réalisée par Renaud Rénov en Eure-et-Loir"
        loading="lazy"
        width="1500"
        height="2000"
      />
    </div>
  </section>

  <!-- ── Avis clients ─────────────────────────────────────────── -->
  <AvisCarrousel ordre={10} />

  <!-- ── Maillage interne ─────────────────────────────────────── -->
  <PrestationsConnexes slugs={["zinguerie", "reparation-toiture", "renovation-toiture"]} />

  <!-- ── CTA devis ────────────────────────────────────────────── -->
  <CtaDevis />
</BaseLayout>
