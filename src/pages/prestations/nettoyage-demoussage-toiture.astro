---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site.ts';
import villes from '../../data/villes.json';
import reviews from '../../data/reviews.json';
import FilAriane from '../../components/FilAriane.astro';
import LogoGoogle from '../../components/LogoGoogle.astro';
import CtaDevis from '../../components/CtaDevis.astro';
import PrestationsConnexes from '../../components/PrestationsConnexes.astro';

// ── Balises : angles différenciés (règle anti-triplette du projet) ──
// Title  → intention + spécialité ; H1 → bénéfice + mousses/lichens ;
// Meta   → nettoyage + preuve artisan. Le mot-clé n'est jamais répété à l'identique.
const title = 'Nettoyage - Démoussage toiture 28 (Eure-et-Loir)| Renaud Rénov';
const description =
  "Des Mousses ou des traînées noires sur votre toit ? Renaud Renov réalise le nettoyage de toiture en Eure-et-Loir (28). Devis gratuit.";

// ── Cocon : quelques communes de la zone, ancres volontairement variées ──
const zone = [
  { slug: 'maintenon', ancre: 'démoussage de toiture à Maintenon' },
  { slug: 'epernon', ancre: 'nettoyage de toiture à Épernon' },
  { slug: 'nogent-le-roi', ancre: 'traitement anti-mousse à Nogent-le-Roi' },
  { slug: 'gallardon', ancre: 'nettoyer un toit à Gallardon' },
  { slug: 'villiers-le-morhier', ancre: 'démousser votre toiture à Villiers-le-Morhier' },
  { slug: 'pierres', ancre: 'entretien de toiture à Pierres' },
  { slug: 'hanches', ancre: 'nettoyage de couverture à Hanches' },
  { slug: 'saint-piat', ancre: 'démoussage de toit à Saint-Piat' },
  { slug: 'chartres', ancre: 'couvreur nettoyage toiture à Chartres' },
  { slug: 'dreux', ancre: 'traitement des mousses à Dreux' },
];
const villeParSlug = Object.fromEntries(villes.map((v) => [v.slug, v]));

// ── Schémas : le Service rattaché à la fiche LocalBusiness + une FAQ
// qui capte les requêtes informationnelles sans alourdir le corps de page. ──
const businessId = `${SITE.url}/#localbusiness`;
const schemaService = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${SITE.url}/prestations/nettoyage-demoussage-toiture/#service`,
  serviceType: 'Nettoyage et démoussage de toiture',
  name: 'Démoussage et nettoyage de toiture en Eure-et-Loir',
  description:
    "Élimination des mousses, lichens et traînées noires, traitement anti-mousse fongicide et nettoyage adapté à chaque couverture, par un artisan couvreur du 28.",
  provider: { '@id': businessId },
  areaServed: {
    '@type': 'AdministrativeArea',
    name: `${SITE.departement} (${SITE.departementNum})`,
  },
  offers: { '@type': 'Offer', priceCurrency: 'EUR', availability: 'https://schema.org/InStock' },
};

const faq = [
  {
    q: 'À quelle fréquence faut-il démousser une toiture ?',
    r: "En Eure-et-Loir, un démoussage tous les 7 à 10 ans suffit pour la plupart des toits. Les toitures orientées au nord ou entourées d'arbres se rechargent plus vite : je vous conseille la bonne fréquence selon l'exposition de votre maison.",
  },
  {
    q: 'Quelle est la meilleure saison pour nettoyer un toit ?',
    r: "Le printemps et l'automne sont idéaux : temps sec, ni gel ni forte chaleur. Un traitement anti-mousse posé à cette période agit ensuite pendant plusieurs mois.",
  },
  {
    q: "Utilisez-vous un nettoyeur haute pression ?",
    r: "Non, jamais sur une couverture fragile. La haute pression décape l'émail des tuiles et accélère leur porosité. Je travaille en basse pression et au brossage, une méthode qui nettoie sans abîmer le matériau.",
  },
  {
    q: 'Faut-il appliquer un hydrofuge après le démoussage ?',
    r: "C'est vivement conseillé : une fois le toit propre, un traitement hydrofuge protège les tuiles, limite la repousse des mousses et prolonge le résultat. Je vous l'explique lors du devis, sans obligation.",
  },
  {
    q: 'Le déplacement et le devis sont-ils gratuits ?',
    r: `Oui. Je me déplace gratuitement partout en ${SITE.departement} pour examiner votre toiture et vous remettre un devis clair, gratuit et sans engagement.`,
  },
];
// ── 4 avis Google ciblés nettoyage / démoussage ──
const nomsAvis = [
  'Jean-Michel Hanon',
  'Dominique Ndiaye',
  'Jean-Claude Hunault',
  'Anne Marie Epossi Ekedi',
];
const avisNettoyage = nomsAvis
  .map((n) => reviews.avis.find((a) => a.auteur === n))
  .filter(Boolean);

const schemaFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.r },
  })),
};
---
<BaseLayout title={title} description={description} extraSchemas={[schemaService, schemaFaq]}>
  <!-- ── Hero prestation : l'intention du client, la réponse = l'artisan ── -->
  <section class="section">
    <div class="conteneur">
      <FilAriane items={[{ label: 'Accueil', href: '/' }, { label: 'Démoussage et nettoyage de toiture' }]} />
    </div>
    <div class="conteneur duo hero-duo">
      <div class="hero-haut">
        <a href={reviews.urlFiche} class="note-google-box" rel="noopener" target="_blank" aria-label={`Note Google ${reviews.note} sur 5 sur ${reviews.nombre} avis`}>
          <LogoGoogle taille={22} />
          <span class="note-google-box__note"><strong>{reviews.note.toLocaleString('fr-FR')}</strong>/5</span>
          <span class="note-google-box__etoiles" aria-hidden="true">★★★★★</span>
          <span class="note-google-box__avis">{reviews.nombre} avis</span>
        </a>
        <h1 class="hero-titre">Démoussage de toiture dans le 28 (Eure-et-Loir)</h1>
        <p class="marque-orange">RENAUD RÉNOV</p>
      </div>
      <img
        class="hero-photo-prestation"
        src="/images/photos/nettoyage-demoussage-toiture.webp"
        alt="M. Renaud, artisan couvreur, nettoyant et démoussant une toiture en Eure-et-Loir"
        fetchpriority="high"
        width="2000"
        height="1500"
      />
      <div class="hero-bas">
        <p class="hero__accroche">
          Votre toiture est couverte de mousses et de lichens, ou simplement salie et marquée par des
          traînées noires de pollution ? Vous cherchez un professionnel, spécialiste du nettoyage de
          toiture en <strong>Eure-et-Loir (28)</strong> ?
        </p>
        <p>
          Je suis <strong>M. Renaud</strong>, le spécialiste du démoussage de toiture dans le
          <strong>28</strong>. Le nettoyage est le cœur de mon métier d'artisan couvreur, fort de plus
          de <strong>quinze années d'expérience</strong>. Grâce à mon travail, votre toiture sera à
          nouveau propre et saine, capable de résister aux intempéries.
        </p>
        <div class="hero__actions">
          <a href={SITE.telHref} class="btn btn--rouge">
            <svg class="icone" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .57 3.6 1 1 0 0 1-.25 1z"/></svg>
            {SITE.tel}
          </a>
          <a href="/devis-gratuit/" class="btn btn--bleu">Demander le démoussage de votre toit →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Savoir-faire détaillé : cartes contrastées image / texte ─────── -->
  <section class="section section--gris">
    <div class="conteneur">
      <div class="section__entete">
        <h2>Couvreur du 28&nbsp;: un véritable <span style="white-space: nowrap;">savoir-faire</span> en matière de lavage des toits</h2>
      </div>
      <p style="max-width: 62ch; margin-inline: auto; text-align: center; text-wrap: balance;">
        Nettoyer un toit sans l'abîmer, c'est un métier. Reconnaître le matériau, doser la pression,
        choisir le bon traitement : voici, concrètement, ce que je réalise sur vos&nbsp;toitures.
      </p>

      <div class="savoir">
        <!-- 1 · Démoussage de toiture -->
        <article class="savoir-carte">
          <div class="savoir-carte__media">
            <img
              src="/images/photos/demoussage-28.webp"
              alt="Maison aux volets bleus avec sa toiture en tuiles propre après démoussage par Renaud Rénov en Eure-et-Loir (28)"
              loading="lazy" width="2000" height="1500"
            />
          </div>
          <div class="savoir-carte__texte">
            <h3>Le démoussage de toiture</h3>
            <p>
              C'est le cœur de mon savoir-faire. J'élimine les mousses, lichens et algues qui
              recouvrent vos tuiles, puis j'applique un traitement anti-mousse fongicide qui agit en
              profondeur et retarde durablement la repousse. Votre toit retrouve son aspect d'origine
              et toute son étanchéité.
            </p>
          </div>
        </article>

        <!-- 2 · Traitement hydrofuge (carte marine, image à droite) -->
        <article class="savoir-carte savoir-carte--inverse savoir-carte--marine">
          <div class="savoir-carte__media">
            <img
              src="/images/photos/toiture-apres-hydrofuge-resine-28.webp"
              alt="Toiture en tuiles ravivée après application d'une résine hydrofuge colorée par Renaud Rénov en Eure-et-Loir"
              loading="lazy" width="2000" height="1500"
            />
          </div>
          <div class="savoir-carte__texte">
            <h3>L'application d'un traitement hydrofuge</h3>
            <p>
              Une fois le toit propre, je protège vos tuiles avec un traitement hydrofuge. Il
              imperméabilise la couverture, limite l'accroche des mousses et prolonge nettement le
              résultat du nettoyage. Je vous explique en détail le
              <a href="/prestations/traitement-hydrofuge/">traitement hydrofuge de toiture</a>.
            </p>
          </div>
        </article>

        <!-- 3 · Brossage manuel tuiles anciennes & ardoises -->
        <article class="savoir-carte">
          <div class="savoir-carte__media">
            <img
              src="/images/photos/brossage-manuel-tuiles-anciennes-28.webp"
              alt="Artisan couvreur Renaud Rénov brossant à la main les mousses d'une toiture ancienne en tuiles plates en Eure-et-Loir"
              loading="lazy" width="1500" height="2000"
              style="object-position: center 62%;"
            />
          </div>
          <div class="savoir-carte__texte">
            <h3>Le brossage manuel des tuiles anciennes et des ardoises</h3>
            <p>
              Les tuiles anciennes et les ardoises sont fragiles : elles ne supportent ni la haute
              pression, ni les produits agressifs. Je les nettoie à la main, au brossage, avec le
              geste qui respecte le matériau. C'est ce savoir-faire d'artisan couvreur qui fait la
              différence sur les toits de caractère.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ── 4 avis Google ciblés nettoyage / démoussage ──────────────────── -->
  <section class="section section--bleu">
    <div class="conteneur">
      <div class="section__entete">
        <h2>Ils m'ont confié le nettoyage de leur toiture</h2>
        <p class="avis-note-google">
          <LogoGoogle taille={20} />
          <span class="avis-note-google__etoiles" aria-hidden="true">★★★★★</span>
          <strong>{reviews.note.toLocaleString('fr-FR')}/5</strong> · {reviews.nombre} avis Google
        </p>
      </div>
      <div class="avis-grille">
        {avisNettoyage.map((a) => (
          <figure class="avis-carte">
            <div class="avis-carte__haut">
              <span class="avis-carte__etoiles" aria-hidden="true">★★★★★</span>
              <LogoGoogle taille={18} />
            </div>
            <blockquote>{a.texte}</blockquote>
            <figcaption>{a.auteur}<span>{a.date}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Avant / après : la preuve visuelle d'un vrai chantier ────────── -->
  <section class="section">
    <div class="conteneur">
      <div class="section__entete section__entete--gauche">
        <h2>Avant / après : un démoussage récent en Eure-et-Loir</h2>
      </div>
      <p>
        Une toiture entièrement envahie de mousses et de lichens, retrouvée propre et saine après mon
        intervention. Même maison, même pan de toit : le résultat parle de lui-même.
      </p>
      <div class="avant-apres">
        <figure>
          <span class="badge badge--avant">Avant</span>
          <img
            src="/images/photos/demoussage-toiture-avant-eure-et-loir.webp"
            alt="Toiture en tuiles envahie par les mousses et les lichens avant démoussage en Eure-et-Loir"
            loading="lazy" width="2000" height="1500"
          />
        </figure>
        <figure>
          <span class="badge badge--apres">Après</span>
          <img
            src="/images/photos/demoussage-toiture-apres-eure-et-loir.webp"
            alt="Même toiture propre et démoussée par M. Renaud, tuiles nettes après nettoyage en Eure-et-Loir"
            loading="lazy" width="2000" height="1500"
          />
        </figure>
      </div>
      <figure class="apres-large">
        <span class="badge badge--apres">Après</span>
        <img
          src="/images/photos/toiture-nettoyee-apres-demoussage.webp"
          alt="Façade de la maison avec sa toiture nettoyée et débarrassée des mousses après démoussage"
          loading="lazy" width="2000" height="1500"
        />
        <figcaption>Le résultat vu de la façade, une fois le chantier terminé.</figcaption>
      </figure>
    </div>
  </section>

  <!-- ── Pourquoi choisir mon service de démoussage ───────────────────── -->
  <section class="section section--bleute">
    <div class="conteneur">
      <div class="section__entete">
        <h2>Pourquoi choisir mon service de démoussage</h2>
      </div>
      <p style="max-width: 66ch; margin-inline: auto; text-align: center; text-wrap: balance;">
        Un toit se nettoie efficacement à condition de le faire dans les règles. Fort de plus de
        quinze années d'expérience, je mets mon savoir-faire d'artisan couvreur au service de votre
        toiture : la bonne méthode et les bons produits, pour un résultat durable et une étanchéité
        préservée.
      </p>

      <div class="atouts">
        <article class="atout">
          <h3>Un savoir-faire d'artisan spécialisé</h3>
          <p>
            Le démoussage est mon métier, pas une prestation d'appoint. Quinze ans à intervenir sur
            les toits d'Eure-et-Loir : je sais lire une couverture et choisir le bon geste pour chaque
            toiture.
          </p>
        </article>

        <article class="atout">
          <h3>La bonne méthode</h3>
          <p>
            Tout commence par un diagnostic de la couverture. Vient ensuite un démoussage en basse
            pression et au brossage, qui élimine mousses et lichens en profondeur sans jamais décaper
            ni fragiliser la tuile.
          </p>
        </article>

        <article class="atout">
          <h3>Les bons produits</h3>
          <p>
            J'applique un traitement anti-mousse fongicide de qualité professionnelle, dosé selon
            votre couverture. Il détruit les spores à la racine et retarde durablement leur repousse.
          </p>
        </article>

        <article class="atout">
          <h3>Une étanchéité préservée</h3>
          <p>
            Un rinçage maîtrisé évacue toutes les impuretés, puis je contrôle l'écoulement des eaux.
            Votre toit retrouve une surface saine et parfaitement étanche, prête à traverser les
            saisons.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ── Adapté à chaque toiture : l'expertise matériaux ──────────────── -->
  <section class="section section--gris">
    <div class="conteneur duo duo--inverse">
      <div>
        <h2>Prenez soin de votre toiture</h2>
        <p>
          Ne laissez pas les mousses et les lichens dégrader votre couverture. Spécialiste du
          démoussage en <strong>Eure-et-Loir (28)</strong>, j'interviens rapidement pour un
          <strong>diagnostic gratuit</strong> de votre toit.
        </p>
        <p>
          Profitez de tarifs avantageux et d'un <strong>devis détaillé sous 24&nbsp;h</strong>.
        </p>
        <a href="/devis-gratuit/" class="btn btn--bleu">Demander mon diagnostic gratuit</a>
      </div>
      <img
        src="/images/photos/toiture-mousse-a-nettoyer-28.webp"
        alt="Toiture fortement envahie par la mousse à nettoyer et démousser en Eure-et-Loir (28)"
        loading="lazy"
        width="2000"
        height="1500"
      />
    </div>
  </section>

  <!-- ── Fournisseurs / produits pros (confiance + E-E-A-T) ───────────── -->
  <section class="section">
    <div class="conteneur">
      <div class="section__entete">
        <h2>Des produits professionnels pour un démoussage durable</h2>
      </div>
      <p style="max-width: 60ch; margin-inline: auto; text-align: center; text-wrap: balance;">
        Pour le nettoyage, le traitement anti-mousse et l'hydrofuge, je m'appuie sur des produits et
        des fournisseurs reconnus du métier.
      </p>
      <ul class="fournisseurs">
        <li>
          <a href="https://www.pointp.fr/infos-agence/chartres-mainvilliers-point-p-3370" class="fournisseurs__carte" rel="noopener" target="_blank" aria-label="Point P Chartres-Mainvilliers">
            <img src="/images/marques/logo-point-p.webp" alt="Point P Chartres-Mainvilliers – distributeur de matériaux de couverture" loading="lazy" height="56" />
          </a>
        </li>
        <li>
          <a href="https://www.dalep.com/" class="fournisseurs__carte" rel="noopener" target="_blank" aria-label="Dalep">
            <img src="/images/marques/logo-dalep.webp" alt="Dalep – traitements hydrofuges et anti-mousse pour toiture" loading="lazy" height="56" />
          </a>
        </li>
        <li>
          <a href="https://www.lariviere.fr/trouver-votre-agence/lariviere-SEB/entry-383-lariviere-chartres.html" class="fournisseurs__carte" rel="noopener" target="_blank" aria-label="Larivière Chartres">
            <img src="/images/marques/logo-lariviere.webp" alt="Larivière Chartres – négoce spécialisé couverture" loading="lazy" height="56" />
          </a>
        </li>
        <li>
          <a href="https://www.gedimat.fr/?magDest=2573" class="fournisseurs__carte" rel="noopener" target="_blank" aria-label="Gedimat Maintenon">
            <img src="/images/marques/logo-gedimat-maintenon.webp" alt="Gedimat Maintenon – matériaux de construction près de Villiers-le-Morhier" loading="lazy" height="56" />
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- ── Zone d'intervention : le maillage du cocon (ancres variées) ──── -->
  <section class="section zone">
    <div class="conteneur">
      <div class="section__entete">
        <h2>Entretenir votre toit partout en Eure-et-Loir</h2>
      </div>
      <p style="max-width: 64ch; margin-inline: auto; text-align: center; text-wrap: balance;">
        Installé à Villiers-le-Morhier, je me déplace partout en Eure-et-Loir (28) et ses alentours
        pour nettoyer et démousser les toitures. Voici quelques communes où j'interviens
        régulièrement&nbsp;:
      </p>
      <ul class="zone-villes">
        {zone.map((z) => (
          villeParSlug[z.slug] && (
            <li>
              <a href={`/villes/${z.slug}/`}>
                <span class="zone-villes__ville">{villeParSlug[z.slug].nom}</span>
                <span class="zone-villes__ancre">{z.ancre}</span>
              </a>
            </li>
          )
        ))}
      </ul>
    </div>
  </section>

  <!-- ── FAQ : capte l'intention informationnelle + montre l'expertise ── -->
  <section class="section">
    <div class="conteneur">
      <div class="section__entete section__entete--gauche">
        <h2>Vos questions sur le nettoyage de toiture</h2>
      </div>
      <div class="faq">
        {faq.map((f) => (
          <div class="faq__item">
            <h3>{f.q}</h3>
            <p>{f.r}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Maillage prestations ─────────────────────────────────────────── -->
  <PrestationsConnexes slugs={["traitement-hydrofuge", "reparation-toiture", "renovation-toiture"]} />

  <!-- ── CTA devis ────────────────────────────────────────────────────── -->
  <CtaDevis />
</BaseLayout>

<style>
  /* Encadré note Google — au-dessus du H1, coins arrondis élégants (pas une pilule) */
  .note-google-box {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.5rem 0.9rem;
    margin-bottom: 1rem;
    background: #fff;
    border: 1px solid rgba(36, 75, 100, 0.14);
    border-radius: 14px;
    box-shadow: 0 2px 10px rgba(36, 75, 100, 0.08);
    text-decoration: none;
    color: var(--bleu, #244B64);
    font-size: 0.95rem;
    line-height: 1;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .note-google-box:hover {
    box-shadow: 0 4px 16px rgba(36, 75, 100, 0.14);
    transform: translateY(-1px);
  }
  .note-google-box__note { font-weight: 500; }
  .note-google-box__note strong { font-size: 1.15rem; font-weight: 800; }
  .note-google-box__etoiles { color: var(--etoile, #f5a623); letter-spacing: 0.06em; }
  .note-google-box__avis { color: var(--gris-700, #4b5563); }

  /* ── Cartes savoir-faire : contraste blanc / marine, image pleine hauteur ── */
  .savoir { display: grid; gap: 2rem; margin-top: 2.5rem; }
  .savoir-carte {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    background: #fff;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 12px 32px rgba(36, 75, 100, 0.12);
  }
  .savoir-carte__media { min-height: 100%; }
  .savoir-carte__media img {
    width: 100%;
    height: 100%;
    min-height: 300px;
    object-fit: cover;
    display: block;
  }
  .savoir-carte__texte {
    padding: 2.4rem 2.6rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .savoir-carte__num {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.12em;
