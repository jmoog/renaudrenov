---
import FlecheRonde from '../../components/FlecheRonde.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site.ts';
import FilAriane from '../../components/FilAriane.astro';
import AvisCarrousel from '../../components/AvisCarrousel.astro';
import CtaDevis from '../../components/CtaDevis.astro';
import PrestationsConnexes from '../../components/PrestationsConnexes.astro';
import LogoGoogle from '../../components/LogoGoogle.astro';
import reviews from '../../data/reviews.json';

const title = 'Zinguerie en Eure-et-Loir (28) — Noues, chéneaux, solins';
const description =
  "Solin de cheminée, noue qui fuit, chéneau percé ? Nous façonnons le zinc en neuf comme en rénovation, dans toute l'Eure-et-Loir. Devis sans engagement.";
---
<BaseLayout title={title} description={description}>
  <!-- ── Hero prestation ──────────────────────────────────────── -->
  <section class="section">
    <div class="conteneur">
      <FilAriane items={[{ label: 'Accueil', href: '/' }, { label: 'Zinguerie' }]} />
    </div>
    <div class="conteneur duo">
      <div>
        <h1>Le façonnage du zinc au service de l'étanchéité de votre toit</h1>
        <p class="hero__accroche">
          Des infiltrations autour de la cheminée, une noue qui fuit, un chéneau percé ? Renaud Rénov,
          artisan couvreur en <strong>Eure-et-Loir (28)</strong>, réalise tous vos travaux de
          zinguerie pour assurer l'étanchéité de votre toiture face aux intempéries.
        </p>
        <p>
          La zinguerie, ce sont ces points sensibles du toit par lesquels l'eau s'infiltre en
          priorité : mieux vaut les confier à un professionnel.
        </p>
        <div class="hero__actions">
          <a href={SITE.telHref} class="btn btn--rouge">
            <svg class="icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 3.5h-2A1.5 1.5 0 0 0 3 5.2C3.4 13 11 20.6 18.8 21a1.5 1.5 0 0 0 1.7-1.5v-2a1.5 1.5 0 0 0-1.3-1.5l-2.5-.35a1.5 1.5 0 0 0-1.4.6l-.7.95a11.5 11.5 0 0 1-4.9-4.9l.95-.7a1.5 1.5 0 0 0 .6-1.4l-.35-2.5a1.5 1.5 0 0 0-1.5-1.3Z"/><path d="M14.5 3.6a5.5 5.5 0 0 1 4.9 4.9"/><path d="M14 7a2.4 2.4 0 0 1 2 2"/></svg>
            {SITE.tel}
          </a>
          <a href="/devis-gratuit/" class="btn btn--bleu">Devis gratuit<FlecheRonde /></a>
        </div>
      </div>
      <div class="photo-note">
        <img
          src="/images/photos/zinguerie-epi.webp"
          alt="Épi de faîtage en zinc réalisé par Renaud Rénov, artisan couvreur-zingueur en Eure-et-Loir"
          fetchpriority="high"
          width="1500"
          height="1125"
        />
        <div class="photo-note__carte">
          <div class="photo-note__top">
            <LogoGoogle taille={26} />
            <span class="photo-note__etoiles" aria-label={`${reviews.note} étoiles sur 5`}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg>
            </span>
          </div>
          <p class="photo-note__txt">Noté <strong>{reviews.note.toLocaleString('fr-FR')}/5</strong> sur Google · {reviews.nombre} avis</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Pourquoi une zinguerie soignée ───────────────────────── -->
  <section class="section section--gris">
    <div class="conteneur">
      <div class="section__entete section__entete--gauche">
        <h2>Pourquoi soigner la zinguerie de votre toit ?</h2>
      </div>
      <p>
        La couverture assure l'essentiel, mais c'est souvent par la zinguerie que l'eau finit par
        passer : jonctions de pans, tour de cheminée, raccords contre un mur. Un solin fissuré ou une
        noue mal réalisée, et l'humidité s'invite dans la charpente sans que rien ne se voie de
        l'extérieur.
      </p>
      <p>
        Une zinguerie bien exécutée, c'est l'assurance d'un toit réellement étanche, saison après
        saison. En traitant correctement chaque point sensible, on évite les infiltrations sournoises
        et on protège durablement l'ensemble de la toiture et de la maison.
      </p>
      <h3>Nos travaux de zinguerie</h3>
      <p>
        Noues, chéneaux, abergements, solins de cheminée, habillages et raccords : nous travaillons le
        zinc avec précision, en neuf comme en rénovation. La zinguerie accompagne naturellement une
        <a href="/prestations/reparation-toiture/">réparation de toiture</a> ou la
        <a href="/prestations/pose-gouttiere/">pose de gouttières</a> pour une évacuation des eaux
        parfaitement maîtrisée.
      </p>
    </div>
  </section>

  <!-- ── Savoir-faire Renaud Rénov ────────────────────────────── -->
  <section class="section">
    <div class="conteneur duo duo--inverse">
      <div>
        <h2>La précision d'un couvreur-zingueur du 28</h2>
        <p>
          La zinguerie demande de la précision et un vrai coup de main. Installés à
          <strong>{SITE.ville}</strong>, nous réalisons les travaux de zinguerie sur les toitures de
          toute l'<strong>Eure-et-Loir (28)</strong>, avec le soin qui fait notre réputation.
        </p>
        <p>
          Entreprise familiale père et fils, nous apportons la même exigence à un solin de cheminée
          qu'à une réfection complète. Un travail durable, salué par nos clients, et couvert par la
          garantie décennale.
        </p>
        <a href="/devis-gratuit/" class="btn btn--bleu">Demander un devis zinguerie<FlecheRonde /></a>
      </div>
      <img
        src="/images/photos/zinguerie-aretier.webp"
        alt="Arêtier en zinc réalisé par Renaud Rénov, artisan couvreur-zingueur en Eure-et-Loir"
        loading="lazy"
        width="1500"
        height="2000"
      />
    </div>
  </section>

  <!-- ── Avis clients ─────────────────────────────────────────── -->
  <AvisCarrousel ordre={8} />

  <!-- ── Maillage interne ─────────────────────────────────────── -->
  <PrestationsConnexes slugs={["pose-gouttiere", "reparation-toiture", "renovation-toiture"]} />

  <!-- ── CTA devis ────────────────────────────────────────────── -->
  <CtaDevis />
</BaseLayout>
