---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site.ts';
import FilAriane from '../../components/FilAriane.astro';
import AvisCarrousel from '../../components/AvisCarrousel.astro';
import CtaDevis from '../../components/CtaDevis.astro';
import PrestationsConnexes from '../../components/PrestationsConnexes.astro';

const title = 'Rénovation de toiture en Eure-et-Loir (28) — Devis gratuit';
const description =
  "Tuiles poreuses, infiltrations répétées ? Nous refaisons votre toit : liteaux, écran sous-toiture, couverture neuve. Chantiers garantis décennale dans le 28.";
---
<BaseLayout title={title} description={description}>
  <!-- ── Hero prestation ──────────────────────────────────────── -->
  <section class="section">
    <div class="conteneur">
      <FilAriane items={[{ label: 'Accueil', href: '/' }, { label: 'Rénovation et réfection de toiture' }]} />
    </div>
    <div class="conteneur duo">
      <div>
        <h1>Réfection de toit partielle ou complète, dans tout le 28</h1>
        <p class="hero__accroche">
          Votre toiture est vieillissante, poreuse ou fatiguée par les années ? Renaud Rénov, artisan
          couvreur en <strong>Eure-et-Loir (28)</strong>, rénove et refait votre toit pour un
          résultat sain, étanche et durable pendant des décennies.
        </p>
        <p>
          De la reprise partielle à la réfection complète, nous vous accompagnons pour redonner à
          votre toiture toute sa solidité.
        </p>
        <div class="hero__actions">
          <a href={SITE.telHref} class="btn btn--rouge">
            <svg class="icone" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .57 3.6 1 1 0 0 1-.25 1z"/></svg>
            {SITE.tel}
          </a>
          <a href="/devis-gratuit/" class="btn btn--bleu">Devis gratuit →</a>
        </div>
      </div>
      <img
        src="/images/photos/renovation-toiture.webp"
        alt="Rénovation de toiture avec liteaunage neuf sur charpente en Eure-et-Loir"
        fetchpriority="high"
        width="2000"
        height="1500"
      />
    </div>
  </section>

  <!-- ── Pourquoi rénover sa toiture ──────────────────────────── -->
  <section class="section section--gris">
    <div class="conteneur">
      <div class="section__entete section__entete--gauche">
        <h2>Pourquoi rénover votre toiture ?</h2>
      </div>
      <p>
        Quand les tuiles deviennent poreuses, que les réparations se multiplient et que les
        infiltrations reviennent, réparer ne suffit plus. Une toiture en fin de vie fragilise la
        charpente, laisse fuir la chaleur et met la maison en danger à chaque intempérie.
      </p>
      <p>
        Rénover son toit, c'est repartir sur une base saine pour des décennies. Une couverture neuve
        et bien posée protège durablement votre maison, améliore son confort et sa performance
        thermique, et valorise fortement votre bien. C'est un investissement qui sécurise l'ensemble
        de votre habitation.
      </p>
      <h3>De la reprise ciblée à la toiture entièrement refaite</h3>
      <p>
        Selon l'état de votre toit, nous réalisons une reprise ciblée ou une réfection complète :
        dépose de l'ancienne couverture, liteaunage, pose d'un écran sous-toiture et
        <a href="/prestations/couverture/">couverture neuve</a> en tuile ou en ardoise. La
        <a href="/prestations/zinguerie/">zinguerie</a> est reprise en même temps pour une étanchéité
        parfaite.
      </p>
    </div>
  </section>

  <!-- ── Savoir-faire Renaud Rénov ────────────────────────────── -->
  <section class="section">
    <div class="conteneur duo duo--inverse">
      <div>
        <h2>L'expérience d'un couvreur de l'Eure-et-Loir</h2>
        <p>
          La rénovation de toiture demande de l'expérience et un vrai souci du détail. Installés à
          <strong>{SITE.ville}</strong>, nous menons des chantiers de réfection dans toute
          l'<strong>Eure-et-Loir (28)</strong>, dans les règles de l'art.
        </p>
        <p>
          Entreprise familiale père et fils, nous suivons votre projet du premier conseil à la
          dernière tuile. Nos clients saluent le sérieux et la qualité de nos rénovations sur Google,
          et tous nos travaux sont couverts par la garantie décennale.
        </p>
        <a href="/devis-gratuit/" class="btn btn--bleu">Rénover ma toiture</a>
      </div>
      <img
        src="/images/photos/renovation-chantier.webp"
        alt="Chantier de rénovation de toiture avec écran sous-toiture et liteaunage en Eure-et-Loir"
        loading="lazy"
        width="2000"
        height="1500"
      />
    </div>
  </section>

  <!-- ── Avis clients ─────────────────────────────────────────── -->
  <AvisCarrousel tag="renovation" ordre={6} />

  <!-- ── Maillage interne ─────────────────────────────────────── -->
  <PrestationsConnexes slugs={["couverture", "reparation-toiture", "zinguerie"]} />

  <!-- ── CTA devis ────────────────────────────────────────────── -->
  <CtaDevis />
</BaseLayout>
