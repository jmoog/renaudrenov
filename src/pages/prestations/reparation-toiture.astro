---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site.ts';
import FilAriane from '../../components/FilAriane.astro';
import AvisCarrousel from '../../components/AvisCarrousel.astro';
import CtaDevis from '../../components/CtaDevis.astro';
import PrestationsConnexes from '../../components/PrestationsConnexes.astro';

const title = 'Réparation de toiture en Eure-et-Loir (28) — Urgence fuite';
const description =
  "Tuile cassée, fuite, faîtage descellé ? Nous intervenons rapidement, partout en Eure-et-Loir, même en urgence. Diagnostic honnête et devis gratuit.";
---
<BaseLayout title={title} description={description}>
  <!-- ── Hero prestation ──────────────────────────────────────── -->
  <section class="section">
    <div class="conteneur">
      <FilAriane items={[{ label: 'Accueil', href: '/' }, { label: 'Réparation de toiture' }]} />
    </div>
    <div class="conteneur duo">
      <div>
        <h1>Fuite, tuile cassée ? Dépannage de toiture rapide dans le 28</h1>
        <p class="hero__accroche">
          Une ardoise déplacée, une infiltration après la tempête, un solin qui lâche ? Renaud Rénov,
          artisan couvreur en <strong>Eure-et-Loir (28)</strong>, répare votre toiture rapidement pour
          la remettre hors d'eau et vous éviter des dégâts plus lourds.
        </p>
        <p>
          Un problème sur votre toit ne doit jamais attendre : nous intervenons vite, partout dans le
          département, et même en urgence.
        </p>
        <div class="hero__actions">
          <a href={SITE.telHref} class="btn btn--rouge">
            <svg class="icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 3.5h-2A1.5 1.5 0 0 0 3 5.2C3.4 13 11 20.6 18.8 21a1.5 1.5 0 0 0 1.7-1.5v-2a1.5 1.5 0 0 0-1.3-1.5l-2.5-.35a1.5 1.5 0 0 0-1.4.6l-.7.95a11.5 11.5 0 0 1-4.9-4.9l.95-.7a1.5 1.5 0 0 0 .6-1.4l-.35-2.5a1.5 1.5 0 0 0-1.5-1.3Z"/><path d="M14.5 3.6a5.5 5.5 0 0 1 4.9 4.9"/><path d="M14 7a2.4 2.4 0 0 1 2 2"/></svg>
            {SITE.tel}
          </a>
          <a href={SITE.telUrgenceHref} class="btn btn--bleu">Urgence : {SITE.telUrgence}</a>
        </div>
      </div>
      <img
        src="/images/photos/reparation-toiture.webp"
        alt="Réparation du faîtage d'une toiture en tuiles en Eure-et-Loir"
        fetchpriority="high"
        width="2000"
        height="1500"
      />
    </div>
  </section>

  <!-- ── Pourquoi réparer sans attendre ───────────────────────── -->
  <section class="section section--gris">
    <div class="conteneur">
      <div class="section__entete section__entete--gauche">
        <h2>Pourquoi réparer votre toiture sans attendre ?</h2>
      </div>
      <p>
        Une simple tuile cassée ou une ardoise déplacée laisse l'eau s'infiltrer à chaque pluie.
        L'humidité gagne l'écran sous-toiture, puis la charpente et les plafonds. Ce qui aurait pu
        être réglé en une intervention se transforme alors en chantier bien plus lourd et coûteux.
      </p>
      <p>
        Faire réparer son toit dès les premiers signes, c'est protéger toute la maison. Une toiture
        maintenue hors d'eau préserve la charpente, l'isolation et la valeur de votre bien. C'est le
        réflexe le plus économique face à un problème naissant.
      </p>
      <h3>Ce que nous réparons</h3>
      <p>
        Tuiles et ardoises cassées ou déplacées, faîtage descellé, solins et
        <a href="/prestations/zinguerie/">zinguerie</a> abîmés, fuites et infiltrations : nous
        recherchons l'origine du problème et remettons votre toiture en état. Lorsque les dégâts
        sont trop étendus, nous vous orientons vers une
        <a href="/prestations/renovation-toiture/">rénovation de toiture</a>.
      </p>
    </div>
  </section>

  <!-- ── Savoir-faire Renaud Rénov ────────────────────────────── -->
  <section class="section">
    <div class="conteneur duo duo--inverse">
      <div>
        <h2>Un couvreur réactif près de chez vous</h2>
        <p>
          Installés à <strong>{SITE.ville}</strong>, nous connaissons les toitures de
          l'<strong>Eure-et-Loir (28)</strong> et intervenons rapidement dans tout le département.
          Cette proximité fait toute la différence quand une fuite se déclare.
        </p>
        <p>
          Entreprise familiale père et fils, nous mettons le même sérieux sur une petite réparation
          que sur un grand chantier. Diagnostic honnête, travail soigné, garantie décennale : nos
          clients nous recommandent pour notre réactivité et notre franchise.
        </p>
        <a href="/devis-gratuit/" class="btn btn--bleu">Faire réparer ma toiture</a>
      </div>
      <img
        src="/images/photos/toiture-avant-demoussage.webp"
        alt="Toiture en tuiles vieillissante à remettre en état par Renaud Rénov en Eure-et-Loir"
        loading="lazy"
        width="1500"
        height="2000"
      />
    </div>
  </section>

  <!-- ── Avis clients ─────────────────────────────────────────── -->
  <AvisCarrousel tag="reparation" ordre={4} />

  <!-- ── Maillage interne ─────────────────────────────────────── -->
  <PrestationsConnexes slugs={["renovation-toiture", "zinguerie", "nettoyage-demoussage-toiture"]} />

  <!-- ── CTA devis ────────────────────────────────────────────── -->
  <CtaDevis />
</BaseLayout>
