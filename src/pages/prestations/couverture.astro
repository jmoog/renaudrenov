---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site.ts';
import FilAriane from '../../components/FilAriane.astro';
import AvisCarrousel from '../../components/AvisCarrousel.astro';
import CtaDevis from '../../components/CtaDevis.astro';
import PrestationsConnexes from '../../components/PrestationsConnexes.astro';

const title = 'Couverture neuve en tuile ou ardoise — Eure-et-Loir (28)';
const description =
  "Construction, extension, toit à refaire : nous posons tuile terre cuite, tuile plate et ardoise, avec écran sous-toiture et zinguerie soignée. Devis gratuit.";
---
<BaseLayout title={title} description={description}>
  <!-- ── Hero prestation ──────────────────────────────────────── -->
  <section class="section">
    <div class="conteneur">
      <FilAriane items={[{ label: 'Accueil', href: '/' }, { label: 'Couverture neuve : tuile et ardoise' }]} />
    </div>
    <div class="conteneur duo">
      <div>
        <h1>Un toit neuf en tuile ou en ardoise, durable et étanche</h1>
        <p class="hero__accroche">
          Un projet de construction, une extension ou une toiture à refaire entièrement ? Renaud
          Rénov, artisan couvreur en <strong>Eure-et-Loir (28)</strong>, pose votre couverture neuve
          en tuile ou en ardoise, du liteaunage aux finitions.
        </p>
        <p>
          Une toiture neuve bien conçue, c'est la tranquillité pour des décennies : étanchéité,
          solidité et bel aspect.
        </p>
        <div class="hero__actions">
          <a href={SITE.telHref} class="btn btn--rouge">
            <svg class="icone" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .57 3.6 1 1 0 0 1-.25 1z"/></svg>
            {SITE.tel}
          </a>
          <a href="/devis-gratuit/" class="btn btn--bleu">Devis gratuit →</a>
        </div>
      </div>
      <img
        src="/images/photos/couverture-tuile.webp"
        alt="Toiture neuve en tuiles terre cuite posée par Renaud Rénov en Eure-et-Loir"
        fetchpriority="high"
        width="2000"
        height="1500"
      />
    </div>
  </section>

  <!-- ── Pourquoi une couverture neuve ────────────────────────── -->
  <section class="section section--gris">
    <div class="conteneur">
      <div class="section__entete section__entete--gauche">
        <h2>Une couverture neuve, réalisée dans les règles de l'art</h2>
      </div>
      <p>
        La couverture est ce qui protège toute la maison des intempéries. Une pose neuve, qu'il
        s'agisse d'une construction ou du remplacement d'un toit en fin de vie, mérite d'être menée
        avec rigueur : le moindre défaut se paie en infiltrations quelques années plus tard.
      </p>
      <p>
        Une toiture neuve posée avec méthode et précision, c'est une maison protégée pour des
        décennies, mieux isolée et durablement valorisée. Vous investissez une fois, sereinement, pour
        un toit sain et étanche sur lequel vous n'aurez plus à revenir.
      </p>
      <h3>Tuile terre cuite, tuile plate ou ardoise</h3>
      <p>
        Nous posons la tuile terre cuite, la tuile plate et l'ardoise naturelle, avec écran
        sous-toiture, liteaunage et <a href="/prestations/zinguerie/">zinguerie</a> soignée. Quand le
        toit existant peut être conservé en partie, nous vous orientons plutôt vers une
        <a href="/prestations/renovation-toiture/">rénovation de toiture</a> adaptée à votre budget.
      </p>
    </div>
  </section>

  <!-- ── Savoir-faire Renaud Rénov ────────────────────────────── -->
  <section class="section">
    <div class="conteneur duo duo--inverse">
      <div>
        <h2>Le savoir-faire d'un couvreur de l'Eure-et-Loir</h2>
        <p>
          Poser une couverture neuve demande expérience et précision. Installés à
          <strong>{SITE.ville}</strong>, nous réalisons des toitures neuves partout en
          <strong>Eure-et-Loir (28)</strong>, en tuile comme en ardoise, avec le même souci du détail.
        </p>
        <p>
          Entreprise familiale père et fils, nous vous accompagnons du choix des matériaux à la
          finition. Un travail durable, reconnu par nos clients sur Google, et couvert par la garantie
          décennale.
        </p>
        <a href="/devis-gratuit/" class="btn btn--bleu">Mon projet de couverture neuve</a>
      </div>
      <img
        src="/images/photos/maison-toiture-eure-et-loir.webp"
        alt="Maison à la toiture neuve en tuiles réalisée par Renaud Rénov en Eure-et-Loir"
        loading="lazy"
        width="2000"
        height="1500"
      />
    </div>
  </section>

  <!-- ── Avis clients ─────────────────────────────────────────── -->
  <AvisCarrousel tag="renovation" ordre={12} />

  <!-- ── Maillage interne ─────────────────────────────────────── -->
  <PrestationsConnexes slugs={["renovation-toiture", "zinguerie", "traitement-hydrofuge"]} />

  <!-- ── CTA devis ────────────────────────────────────────────── -->
  <CtaDevis />
</BaseLayout>
