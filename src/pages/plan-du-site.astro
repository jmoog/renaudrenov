---
import BaseLayout from '../layouts/BaseLayout.astro';
import FilAriane from '../components/FilAriane.astro';
import CtaDevis from '../components/CtaDevis.astro';
import FlecheRonde from '../components/FlecheRonde.astro';
import { SITE } from '../data/site.ts';
import services from '../data/services.json';
import villes from '../data/villes.json';
import { VILLES_NETTOYAGE } from '../data/villes-nettoyage.ts';

// ── Balises différenciées (règle anti-triplette du projet) ──────────────
// Title → l'intitulé attendu + la marque ; H1 → la promesse de lecture ;
// Meta → l'inventaire concret de ce qu'on trouve sur la page.
const title = 'Plan du site — Renaud Rénov, couvreur en Eure-et-Loir (28)';
const description =
  "Plan du site de Renaud Rénov, artisan couvreur à Villiers-le-Morhier : prestations de toiture et de façade, villes d'intervention, réalisations et coordonnées.";

// ── Le nettoyage de façade n'est pas dans services.json (pilier à plat) :
// on l'ajoute en fin de liste pour que la rubrique soit complète. ──────
const prestations = [
  ...services.map((s) => ({ label: s.label, accroche: s.accroche, href: s.href })),
  {
    label: 'Nettoyage de façade',
    accroche:
      "Enduits, crépis, pierre ou brique : élimination des mousses, des lichens et des coulures de ruissellement, puis protection des murs.",
    href: '/nettoyage-facade-28/',
  },
];

// ── Les réalisations (miroir de /realisations/) ────────────────────────
const realisations = [
  {
    href: '/realisations/renovation-toiture-luce/',
    titre: "Rénovation d'une toiture en tuiles à Lucé",
    resume: "Liteaux pourris et tuiles fendues : une couverture entièrement déposée puis refaite, avec écran de sous-toiture.",
  },
  {
    href: '/realisations/nettoyage-facade-luce/',
    titre: "Nettoyage de façade d'un pavillon à Lucé",
    resume: "Pignon terni et descente de garage noircie : démoussage et lavage, photos avant / après.",
  },
  {
    href: '/realisations/nettoyage-peinture-facade-luisant/',
    titre: "Nettoyage et peinture de façade à Luisant",
    resume: "Pignon verdi lavé puis repeint, en quatre étapes photographiées.",
  },
  {
    href: '/realisations/nettoyage-facade-leves/',
    titre: "Nettoyage de façade d'un pavillon à Lèves",
    resume: "Pignon couvert de coulures brunes, photos avant / après.",
  },
  {
    href: '/realisations/nettoyage-facade-salle-municipale-le-coudray/',
    titre: "Nettoyage de façade d'une salle au Coudray",
    resume: "Façades noircies d'une salle municipale, photos avant / après.",
  },
  {
    href: '/realisations/nettoyage-mur-enceinte-parc-le-coudray/',
    titre: "Nettoyage d'un mur d'enceinte au Coudray",
    resume: "Mur d'un parc public marqué de coulures, photos avant / après.",
  },
  {
    href: '/realisations/renovation-toiture-poigny-la-foret/',
    titre: "Rénovation de toiture à Poigny-la-Forêt",
    resume: "Une couverture moussue déposée jusqu'à la charpente, puis refaite avec des liteaux et des tuiles neufs.",
  },
  {
    href: '/realisations/couverture-bac-acier-villiers-le-morhier/',
    titre: "Rénovation de toiture à Villiers-le-Morhier",
    resume: "Le toit d'une annexe entièrement refait : écran de sous-toiture, liteaux neufs et couverture en bac acier.",
  },
  {
    href: '/realisations/refection-faitage-pierres/',
    titre: "Réfection du faîtage d'une toiture à Pierres",
    resume: "Un faîtage ouvert sur toute sa longueur, puis refermé avec un closoir ventilé et des faîtières neuves vissées.",
  },
  {
    href: '/realisations/reparation-cheminee-saint-piat/',
    titre: "Réparation d'une cheminée à Saint-Piat",
    resume: "Un dessus de cheminée noirci et fissuré, remplacé par un chapeau neuf qui abrite le conduit.",
  },
  {
    href: '/realisations/zinguerie-aretier-ardoise-epernon/',
    titre: "Zinguerie sur une toiture en ardoise à Épernon",
    resume: "Un arêtier habillé de zinc de la gouttière jusqu'au sommet, terminé par un épi de faîtage.",
  },
  {
    href: '/realisations/habillage-rive-zinc-hanches/',
    titre: "Habillage d'une rive de toit en zinc à Hanches",
    resume: "Le bord d'un toit en tuiles repris : bandeau habillé de zinc, puis tuiles de rive neuves.",
  },
  {
    href: '/realisations/demoussage-toiture-bouglainval/',
    titre: "Démoussage de toiture à Bouglainval",
    resume: "Une couverture verdie par la mousse sous les arbres, lavée pan par pan : les tuiles ont retrouvé leur teinte brune.",
  },
  {
    href: '/realisations/nettoyage-toiture-tremblay-les-villages/',
    titre: "Nettoyage de toiture à Tremblay-les-Villages",
    resume: "Une couverture devenue presque noire : tuiles lavées, faîtage refait, puis toit remis en couleur.",
  },
  {
    href: '/realisations/nettoyage-facade-haras-guainville/',
    titre: "Nettoyage de façade d'un haras à Guainville",
    resume: "Trois façades d'un centre équestre débarrassées des mousses et des coulures, sans toucher à l'enduit.",
  },
  {
    href: '/realisations/demoussage-toiture-maintenon/',
    titre: "Démoussage d'une toiture à Maintenon",
    resume: 'Une couverture en tuiles gagnée par le vert, redevenue nette en une seule intervention.',
  },
];

// ── Sommaire d'ancres de l'en-tête ─────────────────────────────────────
const sommaire = [
  { href: '#prestations', label: 'Prestations' },
  { href: '#nettoyage-communes', label: 'Démoussage par ville' },
  { href: '#zone', label: "Villes d'intervention" },
  { href: '#realisations', label: 'Réalisations' },
  { href: '#pratique', label: 'Contact' },
];
---
<BaseLayout title={title} description={description} typePage="CollectionPage">
  <!-- ── En-tête ─────────────────────────────────────────────── -->
  <section class="plan-entete">
    <div class="conteneur">
      <FilAriane items={[{ label: 'Accueil', href: '/' }, { label: 'Plan du site' }]} />
      <h1>Plan du site de Renaud Rénov</h1>
      <p class="plan-entete__intro">
        Retrouvez ici mes prestations de couvreur, les villes d'{SITE.departement} et des Yvelines
        où j'interviens, mes réalisations récentes et mes coordonnées.
      </p>
      <nav class="plan-sommaire" aria-label="Sommaire de la page">
        {sommaire.map((s) => (
          <a href={s.href}>{s.label}</a>
        ))}
      </nav>
    </div>
  </section>

  <!-- ── 1. Prestations ──────────────────────────────────────── -->
  <section class="section" id="prestations">
    <div class="conteneur">
      <h2>Mes prestations de couvreur en {SITE.departement}</h2>
      <p>
        Entretien, réparation et rénovation de toiture, zinguerie, gouttières, nettoyage de
        façade&nbsp;: choisissez la prestation qui correspond à vos travaux.
      </p>

      <div class="plan-cartes">
        {prestations.map((p) => (
          <a class="plan-carte" href={p.href}>
            <span class="plan-carte__titre">{p.label}</span>
            <span class="plan-carte__texte">{p.accroche}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── 2. Cocon nettoyage de toiture ───────────────────────── -->
  <section class="section section--gris" id="nettoyage-communes">
    <div class="conteneur">
      <h2>Nettoyage et démoussage de toiture par ville</h2>
      <p>
        Votre toiture verdit ou se couvre de mousse&nbsp;? Sélectionnez votre ville pour savoir
        comment se déroule le nettoyage de votre toit.
      </p>

      <a class="plan-pilier" href="/nettoyage-toiture-28/">
        <span class="plan-pilier__titre">Nettoyage et démoussage de toiture en {SITE.departement}</span>
        <span class="plan-pilier__texte">
          Diagnostic de la couverture, brossage, nettoyage à basse pression, traitement et tarifs
          indicatifs.
        </span>
      </a>

      <p class="plan-soustitre">Démoussage de toiture dans votre ville&nbsp;:</p>
      <ul class="nuage-villes">
        {VILLES_NETTOYAGE.map((v) => (
          <li><a href={`/nettoyage-toiture-${v.slug}/`}>{v.nom}</a></li>
        ))}
      </ul>

      <p class="plan-soustitre">Nettoyage de façade dans votre ville&nbsp;:</p>
      <ul class="nuage-villes">
        <li><a href="/nettoyage-facade-chartres/">Chartres</a></li>
      </ul>
    </div>
  </section>

  <!-- ── 3. Zone d'intervention ──────────────────────────────── -->
  <section class="section" id="zone">
    <div class="conteneur">
      <h2>Les villes où j'interviens</h2>
      <p>
        Installé à {SITE.ville}, j'interviens à Maintenon, à Épernon, à Chartres et dans son
        agglomération, à Dreux, ainsi qu'à Rambouillet et à Houdan dans les Yvelines.
      </p>

      <ul class="plan-villes">
        {villes.map((v) => (
          <li>
            <a href={`/villes/${v.slug}/`}>
              <span class="plan-villes__nom">{v.nom}</span>
              <span class="plan-villes__cp">{v.cp}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── 4. Réalisations ─────────────────────────────────────── -->
  <section class="section section--gris" id="realisations">
    <div class="conteneur">
      <h2>Mes réalisations en {SITE.departement}</h2>
      <p>
        Rénovation de toiture, démoussage, nettoyage de façade&nbsp;: des chantiers récents,
        présentés avec leurs photos avant et après travaux.
      </p>

      <div class="plan-cartes plan-cartes--deux">
        <a class="plan-carte plan-carte--index" href="/realisations/">
          <span class="plan-carte__titre">Toutes les réalisations</span>
          <span class="plan-carte__texte">
            L'ensemble des chantiers réalisés par l'entreprise, en toiture comme en façade.
          </span>
        </a>
        {realisations.map((r) => (
          <a class="plan-carte" href={r.href}>
            <span class="plan-carte__titre">{r.titre}</span>
            <span class="plan-carte__texte">{r.resume}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── 5. Informations pratiques ───────────────────────────── -->
  <section class="section" id="pratique">
    <div class="conteneur">
      <h2>L'entreprise et ses coordonnées</h2>

      <div class="plan-pratique">
        <div class="plan-pratique__liens">
          <h3>L'entreprise</h3>
          <ul>
            <li><a href="/">Accueil</a> <span>— présentation de l'entreprise, prestations et avis clients</span></li>
            <li><a href="/a-propos/">À propos</a> <span>— le parcours et le savoir-faire de l'artisan</span></li>
            <li><a href="/devis-gratuit/">Devis gratuit</a> <span>— le formulaire pour décrire vos travaux</span></li>
            <li><a href="/mentions-legales/">Mentions légales</a> <span>— identité de l'entreprise, hébergement, données personnelles</span></li>
          </ul>
          <a href="/devis-gratuit/" class="btn btn--rouge">Demander un devis gratuit<FlecheRonde /></a>
        </div>

        <aside class="plan-pratique__nap" aria-label="Coordonnées">
          <h3>Coordonnées</h3>
          <dl>
            <dt>Téléphone</dt>
            <dd><a href={SITE.telHref}>{SITE.tel}</a></dd>
            <dt>Urgence (fuite, sinistre, bâchage)</dt>
            <dd><a href={SITE.telUrgenceHref}>{SITE.telUrgence}</a></dd>
            <dt>E-mail</dt>
            <dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd>
            <dt>Adresse</dt>
            <dd>{SITE.rue}, {SITE.cp} {SITE.ville}</dd>
            <dt>Horaires</dt>
            <dd>{SITE.horaires}</dd>
          </dl>
        </aside>
      </div>
    </div>
  </section>

  <CtaDevis titre="Vous n'avez pas trouvé ce que vous cherchiez&nbsp;?" />
</BaseLayout>

<style>
  /* ── En-tête dégradé marine (même trame que /realisations/) ── */
  .plan-entete {
    background: linear-gradient(135deg, var(--bleu) 0%, var(--bleu-fonce) 100%);
    color: var(--blanc);
    padding-block: clamp(2.5rem, 6vw, 4rem);
    position: relative;
    overflow: hidden;
  }
  .plan-entete::after {
    content: '';
    position: absolute;
    right: -80px;
    top: -80px;
    width: 320px;
    height: 320px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(239, 126, 15, 0.22) 0%, transparent 70%);
    pointer-events: none;
  }
  .plan-entete > .conteneur { position: relative; z-index: 1; }
  .plan-entete :global(.fil-ariane),
  .plan-entete :global(.fil-ariane a),
  .plan-entete :global(.fil-ariane [aria-current]) {
    color: rgba(255, 255, 255, 0.7);
  }
  .plan-entete :global(.fil-ariane a:hover) { color: var(--rouge); }
  .plan-entete h1 { color: var(--blanc); margin: 0; }
  .plan-entete__intro {
    max-width: var(--mesure);
    color: rgba(255, 255, 255, 0.85);
    margin-top: 1rem;
    font-size: var(--fs-md);
  }

  /* Sommaire d'ancres */
  .plan-sommaire {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.6rem;
  }
  .plan-sommaire a {
    padding: 0.42em 1em;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: var(--rayon);
    background: rgba(255, 255, 255, 0.07);
    color: rgba(255, 255, 255, 0.92);
    text-decoration: none;
    font-size: var(--fs-sm);
    font-weight: 600;
    transition: background var(--transition), border-color var(--transition), color var(--transition);
  }
  .plan-sommaire a:hover {
    background: var(--rouge-fonce);
    border-color: var(--rouge-fonce);
    color: var(--blanc);
  }

  /* ── Cartes de rubrique ──────────────────────────────────── */
  .plan-cartes {
    display: grid;
    gap: 1.3rem;
    grid-template-columns: 1fr;
    align-items: start; /* les cartes prennent la hauteur de leur texte */
    margin-top: 2.2rem;
  }
  /* Colonnes explicites (pas d'auto-fit) : on maîtrise le nombre de colonnes,
     donc on sait quand la dernière carte se retrouve seule sur sa ligne. Elle
     prend alors toute la largeur — plus de trou blanc en fin de grille. */
  @media (min-width: 640px) {
    .plan-cartes { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .plan-cartes > :last-child:nth-child(odd) { grid-column: 1 / -1; }
  }
  @media (min-width: 1000px) {
    .plan-cartes { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .plan-cartes > :last-child:nth-child(odd) { grid-column: auto; }
    .plan-cartes > :last-child:nth-child(3n + 1) { grid-column: 1 / -1; }
  }

  /* Pas de barre colorée sur les cartes (ni border-left, ni border-top, ni
     liseré ::before au survol) : le survol se joue sur l'ombre et le titre. */
  .plan-carte {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    background: var(--blanc);
    border: 1px solid var(--gris-200);
    border-radius: var(--rayon);
    padding: 1.4rem 1.5rem 1.5rem;
    text-decoration: none;
    box-shadow: var(--ombre);
    transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
  }
  .plan-carte:hover {
    transform: translateY(-3px);
    box-shadow: var(--ombre-forte);
    border-color: var(--bleu-accent);
  }
  .plan-carte__titre {
    font-size: var(--fs-lg);
    font-weight: 700;
    color: var(--bleu);
    line-height: 1.3;
    transition: color var(--transition);
  }
  .plan-carte:hover .plan-carte__titre { color: var(--bleu-accent); text-decoration: underline; }
  .plan-carte__texte {
    font-size: var(--fs-sm);
    color: var(--gris-700);
    line-height: 1.55;
  }
  .plan-carte--index { background: var(--bleu-pale); border-color: #cfdce4; }

  /* ── Page pilier mise en avant ───────────────────────────── */
  .plan-pilier {
    position: relative;
    display: grid;
    gap: 0.5rem;
    margin-top: 2.2rem;
    padding: 1.6rem 1.7rem 1.7rem;
    background: var(--bleu);
    border-radius: var(--rayon);
    color: var(--blanc);
    text-decoration: none;
    box-shadow: var(--ombre);
    transition: background var(--transition), transform var(--transition);
  }
  .plan-pilier:hover { background: var(--bleu-fonce); transform: translateY(-3px); color: var(--blanc); }
  .plan-pilier__titre { font-size: var(--fs-lg); font-weight: 700; line-height: 1.3; }
  .plan-pilier__texte {
    font-size: var(--fs-sm);
    color: rgba(255, 255, 255, 0.85);
    max-width: var(--mesure);
  }
  .plan-pilier:hover .plan-pilier__titre { text-decoration: underline; }

  .plan-soustitre {
    max-width: none !important;
    margin: 2rem 0 0.9rem !important;
    font-weight: 700;
    color: var(--bleu);
  }

  /* Les puces des communes réutilisent le composant global `.nuage-villes`
     (même rendu que sur les pages prestations et villes) — rien à redéfinir
     ici, on annule seulement la marge haute par défaut. */
  :global(.nuage-villes) { margin-top: 0 !important; }

  /* ── Liste des communes (pages villes) ───────────────────── */
  .plan-villes {
    list-style: none;
    padding: 0;
    margin: 2.2rem 0 0 !important;
    max-width: none !important;
    display: grid;
    gap: 0.6rem;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
  }
  .plan-villes a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--gris-200);
    border-radius: var(--rayon);
    background: var(--blanc);
    text-decoration: none;
    transition: border-color var(--transition), background var(--transition), transform var(--transition);
  }
  .plan-villes a:hover {
    border-color: var(--bleu-accent);
    background: var(--bleu-pale);
    transform: translateY(-2px);
  }
  .plan-villes__nom { font-weight: 600; color: var(--bleu); font-size: var(--fs-sm); }
  .plan-villes__cp { font-size: var(--fs-xs); color: var(--gris-500); font-variant-numeric: tabular-nums; }

  /* ── Informations pratiques ──────────────────────────────── */
  .plan-pratique {
    display: grid;
    gap: 1.8rem;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    align-items: start;
    margin-top: 2.2rem;
  }
  .plan-pratique h3 {
    font-size: var(--fs-lg);
    color: var(--bleu);
    margin: 0 0 1rem;
  }
  .plan-pratique__liens ul {
    list-style: none;
    padding: 0;
    margin: 0 0 1.6rem;
    display: grid;
    gap: 0.75rem;
  }
  .plan-pratique__liens li {
    border-top: 1px solid var(--gris-100);
    padding-top: 0.75rem;
    font-size: var(--fs-sm);
    line-height: 1.5;
  }
  .plan-pratique__liens li:first-child { border-top: 0; padding-top: 0; }
  .plan-pratique__liens li a { font-weight: 700; color: var(--bleu); text-decoration: none; }
  .plan-pratique__liens li a:hover { color: var(--rouge-fonce); text-decoration: underline; }
  .plan-pratique__liens li span { color: var(--gris-500); }
  .plan-pratique__liens li [aria-current] { font-weight: 700; color: var(--gris-500); font-style: italic; }

  .plan-pratique__nap {
    background: var(--bleu-pale);
    border-radius: var(--rayon);
    padding: 1.5rem 1.6rem;
  }
  .plan-pratique__nap dl { margin: 0; }
  .plan-pratique__nap dt {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    color: var(--gris-500);
    margin-top: 1rem;
  }
  .plan-pratique__nap dt:first-of-type { margin-top: 0; }
  .plan-pratique__nap dd {
    margin: 0.15rem 0 0;
    font-size: var(--fs-sm);
    color: var(--gris-700);
    font-weight: 600;
  }
  .plan-pratique__nap dd a { color: var(--bleu); text-decoration: none; }
  .plan-pratique__nap dd a:hover { color: var(--rouge-fonce); text-decoration: underline; }

  @media (max-width: 800px) {
    .plan-pratique { grid-template-columns: 1fr; }
    .plan-pilier { padding: 1.4rem 1.4rem 1.5rem; }
  }
</style>
