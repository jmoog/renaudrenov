---
// ─────────────────────────────────────────────────────────────────────────
// ACCUEIL — contenu d'origine INCHANGÉ, seul l'habillage reprend le design
// du modèle artisan (hero grande photo + cartouche en surplomb).
// Structure : hero → avis → CTA devis → services → 2 duos → pourquoi →
// marques → zones → CTA final.
// ─────────────────────────────────────────────────────────────────────────
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site.ts';
import services from '../data/services.json';
import villes from '../data/villes.json';
import AvisCarrousel from '../components/AvisCarrousel.astro';
import CtaDevis from '../components/CtaDevis.astro';
import reviews from '../data/reviews.json';
import LogoGoogle from '../components/LogoGoogle.astro';
import LogosMarques from '../components/LogosMarques.astro';
import FlecheRonde from '../components/FlecheRonde.astro';
---
<BaseLayout
  title="Couvreur 28 - Renaud Rénov - un pro de la toiture"
  description="Couvreur zingueur en Eure-et-Loir (28) - tous travaux de couverture - entretien, réparation et rénovation de toiture. Devis gratuit."
>
  <!-- ── Hero deux colonnes : texte à gauche, photo entière à droite ── -->
  <section class="hero3">
    <div class="conteneur hero3__grille">
      <div class="hero3__texte">
        <p class="hero3__eyebrow">Entretenir, réparer, protéger votre toiture</p>
        <h1>Entreprise de couverture en Eure-et-Loir (28)</h1>
        <p class="hero3__marque">RENAUD RÉNOV</p>
        <p class="hero3__google">
          <LogoGoogle taille={20} />
          <span class="hero3__etoiles" aria-hidden="true">★★★★★</span>
          <strong>{reviews.note.toLocaleString('fr-FR')}/5 sur Google · {reviews.nombre} avis</strong>
        </p>
        <p class="hero3__accroche">
          Je suis M. Renaud. À la tête de mon entreprise de couverture basée en
          <strong>Eure-et-Loir</strong>, à <strong>{SITE.ville}</strong>, je réalise tous les travaux
          de couverture : <strong>nettoyage et démoussage</strong>, traitement hydrofuge, réparation,
          rénovation, couverture, zinguerie et pose de gouttière.
        </p>
        <p>
          Je suis au service des particuliers partout dans le <strong>28</strong> et je propose des
          <strong>devis gratuits et sans engagement</strong>.
        </p>
        <p>Mon métier, c'est de prendre soin de votre toit :</p>
        <ul>
          <li><strong>Nettoyage et démoussage</strong> de toiture, application de <strong>traitements hydrofuges</strong> et anti-mousses.</li>
          <li><strong>Réparation</strong> de toiture : tuiles cassées, ardoises déplacées, faîtage et infiltrations.</li>
          <li><strong>Rénovation</strong> et <strong>couverture neuve</strong> en tuile ou ardoise.</li>
          <li><strong>Zinguerie</strong>, pose de gouttières et étanchéité des points sensibles.</li>
        </ul>
        <div class="hero3__actions">
          <a href={SITE.telHref} class="btn btn--rouge">
            <svg class="icone" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .57 3.6 1 1 0 0 1-.25 1z"/></svg>
            {SITE.tel}
          </a>
          <a href="/devis-gratuit/" class="btn btn--bleu">Devis gratuit<FlecheRonde /></a>
        </div>
      </div>

      <div class="hero3__media">
        <img
          class="hero3__img"
          src="/images/photos/hero-renaud-renov.webp"
          srcset="/images/photos/hero-renaud-renov-640.webp 640w, /images/photos/hero-renaud-renov-960.webp 960w, /images/photos/hero-renaud-renov-1280.webp 1280w, /images/photos/hero-renaud-renov.webp 1600w"
          sizes="(min-width: 980px) 540px, 94vw"
          width="1600"
          height="1200"
          alt="Le véhicule Renaud Rénov devant une maison et sa toiture en tuiles en Eure-et-Loir"
          fetchpriority="high"
        />
        <div class="hero3__garantie">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 3 6v6c0 5 3.8 8.3 9 10 5.2-1.7 9-5 9-10V6l-9-4Z"/><text x="12" y="15.5" text-anchor="middle" font-size="8" font-weight="700" fill="currentColor" stroke="none">10</text></svg>
          <p><strong>Garantie décennale</strong><br />Pour tous travaux de couverture</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Avis clients ─────────────────────────────────────────── -->
  <AvisCarrousel titre="Ce que mes clients pensent de mon travail" />

  <!-- ── CTA devis ────────────────────────────────────────────── -->
  <CtaDevis titre="Parlons de votre projet de toiture" />

  <!-- ── Services ─────────────────────────────────────────────── -->
  <section id="nos-services" class="section section--gris">
    <div class="conteneur">
      <h2>Notre savoir-faire, transmis de père en fils</h2>
      <div class="grille-services">
        {services.map((s) => (
          <a href={s.href} class="carte carte-service">
            <img src={s.image} alt={s.alt} loading="lazy" width="400" height="250" />
            <span class="carte-service__corps">
              <h3>{s.label}</h3>
              <p>{s.accroche}</p>
              <span class="carte-service__lien">{s.lien} →</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Spécialité : nettoyage & démoussage ──────────────────── -->
  <section class="section">
    <div class="conteneur">
      <div class="section__entete section__entete--gauche">
        <h2>Nettoyage, démoussage et traitement hydrofuge de toiture</h2>
      </div>
    </div>
    <div class="conteneur duo">
      <div>
        <p>
          Avec le temps, mousses et lichens fragilisent votre couverture et retiennent l'humidité.
          Renaud Rénov est <strong>spécialiste du nettoyage et du démoussage de toiture</strong> en
          Eure-et-Loir, pour préserver l'étanchéité et prolonger la durée de vie de votre toit.
        </p>
        <h3>Nettoyage et démoussage</h3>
        <p>
          Brossage, nettoyage adapté à votre couverture et élimination des mousses : nous redonnons
          à votre toiture son aspect et ses performances d'origine, tuiles comme ardoises.
        </p>
        <h3>Traitement hydrofuge et résine</h3>
        <p>
          Après le nettoyage, nous appliquons des traitements hydrofuges et des résines colorées
          professionnels qui protègent durablement les matériaux et limitent la repousse des mousses.
        </p>
        <a href="/devis-gratuit/" class="btn btn--bleu">Nettoyer et protéger mon toit</a>
      </div>
      <img
        src="/images/photos/nettoyage-toiture-resultat.webp"
        alt="Maison à la toiture propre après nettoyage et démoussage par Renaud Rénov en Eure-et-Loir"
        loading="lazy"
        width="2000"
        height="1500"
      />
    </div>
  </section>

  <!-- ── Couverture, rénovation & zinguerie ───────────────────── -->
  <section class="section section--bleute">
    <div class="conteneur">
      <div class="section__entete section__entete--gauche">
        <h2>Couverture, rénovation et zinguerie en Eure-et-Loir</h2>
      </div>
    </div>
    <div class="conteneur duo duo--inverse">
      <div>
        <p>
          De la simple tuile cassée à la réfection complète d'une couverture, j'apporte le même
          soin et la même exigence. Je travaille la tuile terre cuite, l'ardoise naturelle et le
          zinc, en rénovation comme en neuf.
        </p>
        <h3>Rénovation et couverture neuve</h3>
        <p>
          Reprise partielle ou réfection complète : liteaunage, écran sous-toiture et couverture
          neuve pour un toit sain, étanche et durable pendant des décennies.
        </p>
        <h3>Zinguerie soignée</h3>
        <p>
          Noues, abergements, solins de cheminée et chéneaux : un travail du zinc précis qui assure
          une protection durable et une excellente étanchéité face aux intempéries.
        </p>
        <a href="/devis-gratuit/" class="btn btn--bleu">Demander un devis</a>
      </div>
      <img
        src="/images/photos/renovation-chantier.webp"
        alt="Chantier de rénovation de toiture avec écran sous-toiture et liteaunage en Eure-et-Loir"
        loading="lazy"
        width="2000"
        height="1500"
      />
    </div>
  </section>

  <!-- ── Pourquoi nous choisir ────────────────────────────────── -->
  <section class="section section--bleu pourquoi">
    <div class="conteneur">
      <h2>Pourquoi confier votre toiture à Renaud Rénov ?</h2>
      <div class="etapes">
        <div class="etape">
          <span class="etape__numero">01</span>
          <h3>Un artisan d'ici, en Eure-et-Loir</h3>
          <p>
            Installés à Villiers-le-Morhier, nous connaissons les toitures de la région et
            intervenons rapidement dans toute l'Eure-et-Loir et ses alentours.
          </p>
        </div>
        <div class="etape">
          <span class="etape__numero">02</span>
          <h3>Une entreprise familiale</h3>
          <p>
            Le père et le fils sur le chantier : un savoir-faire transmis et l'amour du travail bien
            fait, salués par nos clients sur Google. Tous nos travaux sont couverts par la décennale.
          </p>
        </div>
        <div class="etape">
          <span class="etape__numero">03</span>
          <h3>Devis gratuit et sans engagement</h3>
          <p>
            Nous évaluons votre besoin sur place et vous remettons un devis clair et détaillé,
            gratuit et sans engagement, pour décider en toute sérénité.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Marques & fournisseurs ───────────────────────────────── -->
  <LogosMarques />

  <!-- ── Zone d'intervention ──────────────────────────────────── -->
  <section class="section section--gris">
    <div class="conteneur">
      <h2>Votre couvreur autour de {SITE.ville}</h2>
      <p>
        Basés à {SITE.ville} ({SITE.cp}), nous intervenons dans toute l'Eure-et-Loir et aux portes
        des Yvelines. Quelques communes où nous travaillons :
      </p>
      <ul class="nuage-villes">
        {villes.map((v) => (
          <li><span>{v.nom}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── CTA final ────────────────────────────────────────────── -->
  <section class="section cta-final">
    <div class="conteneur">
      <div class="cta-final__carte">
        <h2>Demandez votre devis gratuit</h2>
        <p class="cta-final__texte">
          Réponse rapide, déplacement et devis sans engagement partout en Eure-et-Loir.
          Appelez-nous ou écrivez-nous, nous prenons soin de votre toiture.
        </p>
        <div class="cta-final__actions">
          <a href={SITE.telHref} class="btn btn--blanc">
            <svg class="icone" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .57 3.6 1 1 0 0 1-.25 1z"/></svg>
            {SITE.tel}
          </a>
          <a href="/devis-gratuit/" class="btn btn--bleu">Formulaire de devis</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero deux colonnes : texte à gauche, photo ENTIÈRE à droite
     (aucun élément ne recouvre la photo) */
  .hero3 { padding-block: clamp(2rem, 4vw, 3.5rem); }
  .hero3__grille { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 980px) {
    .hero3__grille { grid-template-columns: 1.05fr 0.95fr; gap: 4rem; }
  }

  .hero3__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    font-size: 0.82rem;
    color: var(--rouge-fonce);
    margin-bottom: 0.6rem;
  }
  .hero3__texte h1 { margin: 0; font-size: clamp(1.55rem, 3.2vw, 2.3rem); line-height: 1.15; }
  .hero3__marque {
    color: var(--rouge);
    font-weight: 800;
    font-size: clamp(1.5rem, 4vw, 2.1rem);
    line-height: 1.1;
    margin: 0.4rem 0 0;
    white-space: nowrap;
  }
  .hero3__google {
    display: flex;
    align-items: center;
    gap: 0.5em;
    color: var(--bleu);
    margin: 0.8rem 0 0;
    flex-wrap: wrap;
  }
  .hero3__etoiles { color: var(--etoile); letter-spacing: 0.08em; }
  .hero3__accroche { font-size: 1.08rem; }
  .hero3__texte > p:not(.hero3__eyebrow):not(.hero3__marque):not(.hero3__google) {
    color: var(--gris-700);
    margin: 0.9rem 0 0;
  }
  .hero3__texte > ul { margin: 0.6rem 0 0; }
  .hero3__texte > ul li { margin-block: 0.3rem; color: var(--gris-700); }
  .hero3__actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.4rem; }

  /* Photo : entièrement visible, jamais recouverte */
  .hero3__media { display: grid; gap: 1.2rem; align-content: center; justify-items: center; }
  .hero3__img {
    width: 100%;
    border-radius: var(--rayon);
    box-shadow: var(--ombre-forte);
    object-fit: cover;
  }

  /* Badge garantie décennale : compact, sous la photo */
  .hero3__garantie {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    background: var(--blanc);
    border: 1px solid var(--gris-200);
    border-left: 4px solid var(--rouge);
    border-radius: var(--rayon);
    box-shadow: var(--ombre);
    padding: 0.8rem 1.3rem;
  }
  .hero3__garantie svg { width: 2.4rem; height: 2.4rem; color: var(--rouge-fonce); flex-shrink: 0; }
  .hero3__garantie strong { color: var(--bleu); font-size: 1.05rem; }
  .hero3__garantie p { margin: 0; font-size: 0.95rem; color: var(--gris-700); line-height: 1.4; }

  /* Mobile / colonne unique : la photo remonte juste sous la note Google,
     titres et accroches centrés. */
  @media (max-width: 979px) {
    .hero3__grille { gap: 0; }
    .hero3__texte, .hero3__media { display: contents; }
    .hero3__texte > p { order: 7; }
    .hero3__texte > .hero3__eyebrow { order: 1; text-align: center; }
    .hero3__texte > h1 { order: 2; text-align: center; }
    .hero3__texte > .hero3__marque { order: 3; text-align: center; }
    .hero3__texte > .hero3__google { order: 4; justify-content: center; }
    .hero3__media > .hero3__img { order: 5; margin-block: 1rem 0.4rem; }
    .hero3__texte > .hero3__accroche { order: 6; }
    .hero3__texte > ul { order: 8; }
    .hero3__texte > .hero3__actions { order: 9; justify-content: center; }
    .hero3__media > .hero3__garantie { order: 10; margin-top: 1.4rem; justify-self: center; }
  }
  @media (max-width: 380px) {
    .hero3__texte h1 { font-size: 1.4rem; }
    .hero3__marque { font-size: 1.3rem; }
  }
</style>
