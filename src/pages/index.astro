---
// ─────────────────────────────────────────────────────────────────────────
// ACCUEIL — restructuration août 2026, inspirée de la home Lafleur Couvreur :
// hero → bandeau de réassurance → grande section NETTOYAGE DE TOITURE (la
// spécialité, mise en avant) → section dédiée NETTOYAGE DE FAÇADE → avis en
// CARROUSEL (remplace la grille de 6) → section REMPLACEMENT DES TOITURES
// ANCIENNES → cards zinguerie / gouttières / réparation d'urgence → CTA devis
// → pourquoi → marques → zones → CTA final.
// Les textes dictés par le client (24/07/2026) sont conservés et réorganisés.
// ─────────────────────────────────────────────────────────────────────────
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site.ts';
import villes from '../data/villes.json';
import CtaDevis from '../components/CtaDevis.astro';
import AvisCarrousel from '../components/AvisCarrousel.astro';
import reviews from '../data/reviews.json';
import LogoGoogle from '../components/LogoGoogle.astro';
import LogosMarques from '../components/LogosMarques.astro';
import FlecheRonde from '../components/FlecheRonde.astro';
---
<BaseLayout
  title="Couvreur 28 - Renaud Rénov - un pro de la toiture"
  description="Couvreur zingueur en Eure-et-Loir (28) - tous travaux de couverture - entretien, réparation et rénovation de toiture. Devis gratuit."
  lcpImage="/images/photos/renaud-renov-couvreur-28.webp"
  lcpSrcset="/images/photos/renaud-renov-couvreur-28-640.webp 640w, /images/photos/renaud-renov-couvreur-28-768.webp 768w, /images/photos/renaud-renov-couvreur-28-896.webp 896w, /images/photos/renaud-renov-couvreur-28.webp 1024w"
  lcpSizes="(min-width: 980px) 46vw, calc(100vw - 2rem)"
>
  <!-- ── Hero (titre + photo + coches + badges) ───────────────── -->
  <section class="hx">
    <div class="conteneur hx__grid">
      <div class="hx__head">
        <h1 class="hx__title">Entreprise de couverture en Eure-et-Loir&nbsp;(28)</h1>
        <p class="hx__marque">RENAUD RÉNOV</p>
      </div>

      <div class="hx__right">
        <img
          class="hx__photo"
          src="/images/photos/renaud-renov-couvreur-28.webp"
          srcset="/images/photos/renaud-renov-couvreur-28-640.webp 640w, /images/photos/renaud-renov-couvreur-28-768.webp 768w, /images/photos/renaud-renov-couvreur-28-896.webp 896w, /images/photos/renaud-renov-couvreur-28.webp 1024w"
          sizes="(min-width: 980px) 46vw, calc(100vw - 2rem)"
          width="1024"
          height="768"
          alt="Couvreur 28 – Renaud Rénov"
          fetchpriority="high"
          decoding="async"
        />
        <div class="hx__note">
          <div class="hx__note-top">
            <LogoGoogle taille={26} />
            <span class="hx__note-stars" aria-label={`${reviews.note} étoiles sur 5`}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg>
            </span>
          </div>
          <p class="hx__note-txt">Noté <strong>{reviews.note.toLocaleString('fr-FR')}/5</strong> sur Google · {reviews.nombre} avis</p>
        </div>
      </div>

      <div class="hx__body">
        <p class="hx__intro">
          Artisan couvreur installé à <strong>Villiers-le-Morhier</strong>, je réalise tous vos
          travaux de couverture et d’entretien du toit&nbsp;: nettoyage et démoussage, réparation
          et rénovation de toiture, zinguerie et gouttières.
        </p>
        <p class="hx__intro">
          Plus de <strong>15 ans d’expérience</strong> au service des particuliers
          d’<strong>Eure-et-Loir</strong> (<strong>28</strong>), avec la garantie décennale sur
          l’ensemble de mes travaux. Devis gratuit et sans engagement.
        </p>
        <p class="hx__intro">Nous sommes des spécialistes des travaux sur votre toiture&nbsp;:</p>
        <ul class="hx__points">
          <li>
            <span class="hx__check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M8 12.5l2.5 2.5 5-6"/></svg></span>
            <span><strong>Nettoyage</strong> de toit&nbsp;: <strong>démoussage</strong> et application de traitements hydrofuges et anti-mousses professionnels.</span>
          </li>
          <li>
            <span class="hx__check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M8 12.5l2.5 2.5 5-6"/></svg></span>
            <span><strong>Nettoyage des façades</strong> et des extérieurs des maisons.</span>
          </li>
          <li>
            <span class="hx__check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M8 12.5l2.5 2.5 5-6"/></svg></span>
            <span><strong>Remplacement</strong> de <strong>couverture ancienne</strong> par une toiture neuve.</span>
          </li>
          <li>
            <span class="hx__check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M8 12.5l2.5 2.5 5-6"/></svg></span>
            <span><strong>Réparation</strong> de <strong>toiture abîmée</strong>&nbsp;: tuiles cassées ou poreuses, faîtage, ardoises déplacées.</span>
          </li>
          <li>
            <span class="hx__check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M8 12.5l2.5 2.5 5-6"/></svg></span>
            <span><strong>Zinguerie</strong> et pose de <strong>gouttières</strong>&nbsp;: noues, chéneaux, solins et descentes.</span>
          </li>
        </ul>

        <div class="hx__badges">
          <img src="/images/labels/applicateur-dalep.webp" alt="Applicateur de solutions DALEP certifié" width="240" height="240" loading="lazy" />
          <img src="/images/labels/garantie-decennale-10-ans.webp" alt="Garantie décennale 10 ans" width="220" height="220" loading="lazy" />
          <img src="/images/labels/artisan-cma28.webp" alt="Artisan — Chambre de Métiers et de l'Artisanat d'Eure-et-Loir" width="320" height="228" loading="lazy" />
        </div>

        <div class="hx__actions">
          <a href="/devis-gratuit/" class="btn btn--rouge">Devis gratuit<FlecheRonde /></a>
          <a href={SITE.telHref} class="btn btn--bleu">
            <svg class="icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 3.5h-2A1.5 1.5 0 0 0 3 5.2C3.4 13 11 20.6 18.8 21a1.5 1.5 0 0 0 1.7-1.5v-2a1.5 1.5 0 0 0-1.3-1.5l-2.5-.35a1.5 1.5 0 0 0-1.4.6l-.7.95a11.5 11.5 0 0 1-4.9-4.9l.95-.7a1.5 1.5 0 0 0 .6-1.4l-.35-2.5a1.5 1.5 0 0 0-1.5-1.3Z"/><path d="M14.5 3.6a5.5 5.5 0 0 1 4.9 4.9"/><path d="M14 7a2.4 2.4 0 0 1 2 2"/></svg>
            {SITE.tel}
          </a>
        </div>
        <p class="hx__cta-sub">Réponse rapide, sans engagement</p>
      </div>
    </div>
  </section>

  <!-- ── Bandeau de réassurance (design Lafleur) ──────────────── -->
  <div class="reassurance">
    <ul class="conteneur">
      <li>
        <svg class="icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2.5 4.5 5.3v5.2c0 5 3.2 9.2 7.5 10.5 4.3-1.3 7.5-5.5 7.5-10.5V5.3z"/><path d="m8.8 11.8 2.2 2.2 4.2-4.6"/></svg>
        Garantie décennale
      </li>
      <li>
        <svg class="icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3.2s5.6 6.2 5.6 10.4a5.6 5.6 0 0 1-11.2 0C6.4 9.4 12 3.2 12 3.2Z"/><path d="M9.4 13.8a2.7 2.7 0 0 0 2.3 2.6"/></svg>
        Applicateur certifié DALEP
      </li>
      <li>
        <svg class="icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path d="M4 20c0-3 2.2-5 5-5s5 2 5 5"/><circle cx="16.5" cy="9.5" r="2.4"/><path d="M15.8 15.2c2.5.2 4.2 2 4.2 4.8"/></svg>
        Entreprise familiale, père &amp; fils
      </li>
      <li>
        <svg class="icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11Z"/><circle cx="12" cy="10" r="2.6"/></svg>
        Intervention dans tout l'Eure-et-Loir
      </li>
    </ul>
  </div>

  <!-- ── NETTOYAGE DE TOITURE — la spécialité, mise en avant ──── -->
  <section class="section section--gris">
    <div class="conteneur">
      <h2>Nettoyage et démoussage de toiture en Eure-et-Loir&nbsp;(28)</h2>
    </div>
    <div class="conteneur duo">
      <div>
        <p>
          Utilisation de techniques de nettoyage professionnelles adaptées à votre toit et aux
          façades de votre habitation. L’objectif est de nettoyer et laver efficacement sans abîmer
          les matériaux, ni polluer votre environnement. Avoir recours aux services de Renaud Rénov,
          c’est faire confiance à un <strong>professionnel certifié Applicateur DALEP</strong>, ce
          qui vous garantit une utilisation conforme des produits biocides&nbsp;; c’est l’expérience
          et le savoir-faire d’un artisan installé en Eure-et-Loir depuis plus de 15&nbsp;années.
        </p>
        <h3>Nettoyage et démoussage de votre toit</h3>
        <p>
          Brossage manuel, démoussage haute pression ou lavage basse pression&nbsp;: j’utilise
          les bonnes techniques pour être certain de ne pas abîmer votre toiture. Le travail
          est délicat et demande un véritable savoir-faire, que vous pouvez confier à
          Renaud Rénov, <strong>artisan couvreur en Eure-et-Loir</strong>. Mousses, lichens et
          salissures retiennent l’humidité contre la couverture&nbsp;: un
          <a href="/nettoyage-toiture-28/">nettoyage et un démoussage de toiture</a> dans les
          règles de l’art préservent l’étanchéité et prolongent la vie de votre toit.
        </p>
        <h3>Application de traitements sur votre toit</h3>
        <p>
          <a href="/traitement-hydrofuge-28/">Traitements hydrofuges et anti-mousses</a>, hydrofuges
          colorés et peintures de toitures. Je renforce votre toit contre l’usure du temps et
          l’installation des mousses. Je vous propose la solution idéale, avec le bon produit,
          pour bien protéger votre toiture. Adaptés aux toitures anciennes en tuiles et ardoises,
          les traitements sont une bonne solution pour améliorer la longévité de votre toit et
          lui redonner une belle apparence.
        </p>
        <a href="/nettoyage-toiture-28/" class="btn btn--bleu duo__btn">Nettoyer et démousser mon toit</a>
      </div>
      <img
        src="/images/photos/nettoyage-toiture-pavillon-eure-et-loir-28.webp"
          srcset="/images/photos/nettoyage-toiture-pavillon-eure-et-loir-28-640.webp 640w, /images/photos/nettoyage-toiture-pavillon-eure-et-loir-28.webp 900w"
          sizes="(min-width: 980px) 46vw, calc(100vw - 2rem)"
        alt="Nettoyage de la toiture d'un pavillon en Eure-et-Loir (28) — toit à moitié démoussé par Renaud Rénov"
        loading="lazy"
          decoding="async"
        width="900"
        height="675"
      />
    </div>
  </section>

  <!-- ── NETTOYAGE DE FAÇADE — section dédiée ─────────────────── -->
  <section class="section">
    <div class="conteneur">
      <h2>Nettoyage de façade dans le 28&nbsp;: murs, pignons et crépis</h2>
    </div>
    <div class="conteneur duo duo--inverse">
      <div>
        <p>
          Retrouvez une maison avec des façades propres, sans présence de mousses ou de traces
          d’humidité. Une maison saine et propre grâce au nettoyage de vos murs, sans abîmer
          les peintures et les revêtements&nbsp;: enduits, crépis, pierres, briques, bardages.
          Un nettoyage effectué par un professionnel, une garantie de savoir-faire et
          d’efficacité.
        </p>
        <p>
          Traînées vertes sous les gouttières, coulures rouges ou noires sur les pignons, mousses
          en pied de mur&nbsp;: ces salissures s’installent avec l’humidité et ternissent
          l’ensemble de la maison. Un <a href="/nettoyage-facade-28/">nettoyage de façade</a>
          adapté au support redonne à l’enduit sa teinte d’origine et prépare, si besoin,
          l’application d’un traitement protecteur.
        </p>
        <a href="/nettoyage-facade-28/" class="btn btn--bleu duo__btn">Nettoyer mes façades</a>
      </div>
      <img
        src="/images/photos/facade-pignon-sale-28.webp"
          srcset="/images/photos/facade-pignon-sale-28-640.webp 640w, /images/photos/facade-pignon-sale-28.webp 900w"
          sizes="(min-width: 980px) 46vw, calc(100vw - 2rem)"
        alt="Façade et pignon sales avant nettoyage dans le 28 — coulures et traces d'humidité"
        loading="lazy"
          decoding="async"
        width="900"
        height="675"
      />
    </div>
  </section>

  <!-- ── Avis clients (carrousel responsive) ──────────────────── -->
  <AvisCarrousel
    titre="Les avis de mes clients satisfaits en Eure-et-Loir"
    tag="nettoyage"
    avecCtaAvis
  />

  <!-- ── REMPLACEMENT DES TOITURES ANCIENNES — section dédiée ─── -->
  <section class="section section--gris">
    <div class="conteneur">
      <h2>Remplacement des toitures anciennes en Eure-et-Loir</h2>
    </div>
    <div class="conteneur duo">
      <div>
        <p>
          Rénovation de toiture abîmée, remplacement de toiture ancienne. Je suis Jordy Renaud,
          votre <strong>artisan couvreur dans le 28</strong>&nbsp;: spécialiste de la couverture
          traditionnelle — tuiles pays, tuiles plates, ardoises — et des techniques
          traditionnelles de pose, je refais tous les types de toitures. Je vous garantis une
          toiture rénovée, résistante contre les intempéries.
        </p>
        <h3>Quand envisager le remplacement de votre couverture&nbsp;?</h3>
        <p>
          Tuiles poreuses ou gélives, ardoises qui se délitent, faîtage fragilisé, infiltrations
          répétées&nbsp;: quand la couverture arrive en fin de vie, une
          <a href="/renovation-toiture-28/">réfection complète de la toiture</a> remet votre toit
          à neuf pour plusieurs décennies. Écran de sous-toiture, liteaunage neuf et couverture
          posée dans les règles de l’art, avec la garantie décennale sur l’ensemble des travaux.
        </p>
        <a href="/renovation-toiture-28/" class="btn btn--bleu duo__btn">Rénover ma toiture</a>
      </div>
      <img
        src="/images/photos/renovation-toiture-28-renaud-renov.webp"
          srcset="/images/photos/renovation-toiture-28-renaud-renov-640.webp 640w, /images/photos/renovation-toiture-28-renaud-renov.webp 900w"
          sizes="(min-width: 980px) 46vw, calc(100vw - 2rem)"
        alt="Remplacement d'une toiture ancienne dans le 28 par Renaud Rénov — écran de sous-toiture, liteaunage neuf et tuiles en cours de pose"
        loading="lazy"
          decoding="async"
        width="900"
        height="675"
      />
    </div>
  </section>

  <!-- ── Zinguerie, gouttières, urgences : 3 cards ────────────── -->
  <section class="section section--bleute">
    <div class="conteneur">
      <h2>Travaux de zinguerie, gouttières et réparations d’urgence</h2>

      <div class="grille-cartes grille-cartes--3">
        <article class="carte carte-presta">
          <img class="carte-presta__img" src="/images/photos/couvreur-zingueur-28.webp"
          srcset="/images/photos/couvreur-zingueur-28-480.webp 480w, /images/photos/couvreur-zingueur-28-720.webp 720w, /images/photos/couvreur-zingueur-28.webp 900w"
          sizes="(min-width: 1232px) 374px, (min-width: 900px) 31vw, (min-width: 560px) 45vw, calc(100vw - 2rem)" alt="Couvreur zingueur 28 — épi de faîtage et arêtier en zinc réalisés par Renaud Rénov" loading="lazy"
          decoding="async" width="900" height="1200" />
          <div class="carte-presta__corps">
            <h3>Travaux de zinguerie</h3>
            <p>
              Gouttières, solins, rives, noues, chéneaux, habillage des rives&nbsp;: la zinguerie
              est essentielle pour l’étanchéité et la résistance de votre toiture. Mon savoir-faire
              de <strong>couvreur zingueur dans le 28</strong> me permet de façonner ces éléments en zinc pour les
              adapter à votre toit et aux parties saillantes de la toiture.
            </p>
            <a class="carte-presta__lien" href="/zinguerie-28/">En savoir plus sur la zinguerie</a>
          </div>
        </article>

        <article class="carte carte-presta">
          <img class="carte-presta__img" src="/images/photos/gouttiere-descente.webp"
          srcset="/images/photos/gouttiere-descente-480.webp 480w, /images/photos/gouttiere-descente-720.webp 720w, /images/photos/gouttiere-descente.webp 1200w"
          sizes="(min-width: 1232px) 374px, (min-width: 900px) 31vw, (min-width: 560px) 45vw, calc(100vw - 2rem)" alt="Descente de gouttière en zinc et rive habillée le long d'un pignon par Renaud Rénov en Eure-et-Loir" loading="lazy"
          decoding="async" width="1200" height="900" />
          <div class="carte-presta__corps">
            <h3>Pose et remplacement de gouttières</h3>
            <p>
              Pose, remplacement et raccordement de gouttières et de descentes en zinc, en
              aluminium ou en PVC. Une évacuation des eaux de pluie en bon état protège vos
              façades et vos fondations&nbsp;: je dimensionne, je pose et je règle chaque
              gouttière pour un écoulement impeccable, partout en Eure-et-Loir.
            </p>
            <a class="carte-presta__lien" href="/pose-gouttiere-28/">En savoir plus sur la pose de gouttières</a>
          </div>
        </article>

        <article class="carte carte-presta">
          <img class="carte-presta__img" src="/images/photos/reparation-toiture-urgence-28.webp"
          srcset="/images/photos/reparation-toiture-urgence-28-480.webp 480w, /images/photos/reparation-toiture-urgence-28-720.webp 720w, /images/photos/reparation-toiture-urgence-28.webp 900w"
          sizes="(min-width: 1232px) 374px, (min-width: 900px) 31vw, (min-width: 560px) 45vw, calc(100vw - 2rem)" alt="Camionnette de Renaud Rénov devant un pavillon lors d'une intervention sur toiture en Eure-et-Loir" loading="lazy"
          decoding="async" width="900" height="675" />
          <div class="carte-presta__corps">
            <h3>Réparation des toitures en urgence</h3>
            <p>
              Recherche de fuites et infiltrations, pose de bâches&nbsp;: j’interviens rapidement
              chez vous pour remettre en état une toiture abîmée. Pose de bâches en urgence,
              7&nbsp;j/7, partout dans le département. Je protège et répare votre toit pour
              empêcher l’eau de pénétrer dans votre habitation.
            </p>
            <a class="carte-presta__lien" href="/reparation-toiture-28/">En savoir plus sur la réparation de toiture</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ── CTA devis ────────────────────────────────────────────── -->
  <CtaDevis
    titre="Contactez votre couvreur en Eure-et-Loir"
    image="/images/photos/contact-couvreur-eure-et-loir-28.webp"
    imageAlt="Jordy Renaud, votre couvreur en Eure-et-Loir, sur un chantier de toiture"
    imageWidth={900}
    imageHeight={1200}
  />

  <!-- ── Pourquoi nous choisir ────────────────────────────────── -->
  <section class="section section--bleu pourquoi">
    <div class="conteneur">
      <h2>Pourquoi confier votre toiture à Renaud Rénov ?</h2>
      <div class="etapes">
        <div class="etape">
          <span class="etape__numero">01</span>
          <h3>Un artisan d'ici, en Eure-et-Loir</h3>
          <p>
            Installés à Villiers-le-Morhier, nous connaissons les toitures de la région et
            intervenons rapidement dans toute l'Eure-et-Loir et ses alentours.
          </p>
        </div>
        <div class="etape">
          <span class="etape__numero">02</span>
          <h3>Une entreprise familiale</h3>
          <p>
            Le père et le fils sur le chantier : un savoir-faire transmis et l'amour du travail bien
