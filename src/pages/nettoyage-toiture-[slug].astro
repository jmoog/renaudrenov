---
// ─────────────────────────────────────────────────────────────────────────
// Satellites du cocon nettoyage : /nettoyage-toiture-{ville}/, générés
// depuis src/data/villes-nettoyage.ts (modèle Richard Toitures, adapté 28).
//
// Règles du cocon (12-13/08/2026) :
// - Satellite TOUJOURS moins profond que le pilier /nettoyage-toiture-28/ :
//   pas de tarifs détaillés, pas de FAQ. 800-1000 mots.
// - Anti-cannibalisation : ici l'intention est « nettoyage/démoussage
//   + ville », jamais « couvreur + ville » (propriété de /villes/{slug}/)
//   ni « nettoyage + département » (propriété du pilier).
// - Maillage : chaque satellite lie le pilier (ancre variée), la page
//   /villes/{slug}/ de la même commune, 3 satellites voisins, et selon le
//   thème /traitement-hydrofuge-28/ ou /prestations/pose-gouttiere/.
// - Hero .hx problème → solution + liste à coches (modèle home) ; badge
//   Dalep seul (jamais de décennale sur une page nettoyage).
// ─────────────────────────────────────────────────────────────────────────
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site.ts';
import { schemaService, commune } from '../lib/schema.ts';
import reviews from '../data/reviews.json';
import { VILLES_NETTOYAGE, villeNettoyageParSlug } from '../data/villes-nettoyage.ts';
import FilAriane from '../components/FilAriane.astro';
import LogoGoogle from '../components/LogoGoogle.astro';
import CtaDevis from '../components/CtaDevis.astro';
import FlecheRonde from '../components/FlecheRonde.astro';

export function getStaticPaths() {
  return VILLES_NETTOYAGE.map((v) => ({ params: { slug: v.slug }, props: { v } }));
}

const { v } = Astro.props;
const path = `/nettoyage-toiture-${v.slug}/`;

// Villes proches : 3 satellites voisins, ancres variées portées par les données.
const proches = v.proches
  .map((p) => {
    const s = villeNettoyageParSlug(p.slug);
    return s ? { href: `/nettoyage-toiture-${s.slug}/`, ancre: p.ancre } : null;
  })
  .filter(Boolean);

// ── Schema : Service rattaché au LocalBusiness, zone = la commune ──
const schemaPrestation = schemaService({
  chemin: path,
  serviceType: 'Nettoyage et démoussage de toiture',
  nom: `Nettoyage de toiture à ${v.nom}`,
  description: v.metaDesc,
  image: v.heroPhoto.src,
  zone: commune(v.nom, v.cp),
});
---
<BaseLayout title={v.title} description={v.metaDesc} extraSchemas={[schemaPrestation]}>
  <!-- ── Fil d'Ariane : rattaché au pilier (3 niveaux) ─────────────────── -->
  <section class="section section--sans-bas">
    <div class="conteneur">
      <FilAriane
        items={[
          { label: 'Accueil', href: '/' },
          { label: 'Nettoyage de toiture', href: '/nettoyage-toiture-28/' },
          { label: v.nom },
        ]}
      />
    </div>
  </section>

  <!-- ── Bloc 1 · Hero : design de la home (titre / photo / coches) ───── -->
  <section class="hx">
    <div class="conteneur hx__grid">
      <div class="hx__head">
        <h1 class="hx__title" set:html={v.h1} />
        <p class="hx__marque">RENAUD RÉNOV</p>
      </div>

      <div class="hx__right">
        <img
          class="hx__photo"
          src={v.heroPhoto.src}
          alt={v.heroPhoto.alt}
          fetchpriority="high"
          width={v.heroPhoto.largeur}
          height={v.heroPhoto.hauteur}
        />
        <div class="hx__note">
          <div class="hx__note-top">
            <LogoGoogle taille={26} />
            <span class="hx__note-stars" aria-label={`${reviews.note} étoiles sur 5`}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg>
            </span>
          </div>
          <p class="hx__note-txt">Noté <strong>{reviews.note.toLocaleString('fr-FR')}/5</strong> sur Google · {reviews.nombre} avis</p>
        </div>
      </div>

      <div class="hx__body">
        <p class="hx__chapo" set:html={v.chapo} />

        <ul class="hx__points">
          {v.coches.map((c) => (
            <li>
              <span class="hx__check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M8 12.5l2.5 2.5 5-6"/></svg></span>
              {c}
            </li>
          ))}
        </ul>

        <div class="hx__badges">
          <img src="/images/labels/applicateur-dalep.webp" alt="Applicateur de solutions DALEP certifié" width="240" height="240" loading="lazy" />
        </div>

        <div class="hx__actions">
          <a href="/devis-gratuit/" class="btn btn--rouge">Devis gratuit<FlecheRonde /></a>
          <a href={SITE.telHref} class="btn btn--bleu">
            <svg class="icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 3.5h-2A1.5 1.5 0 0 0 3 5.2C3.4 13 11 20.6 18.8 21a1.5 1.5 0 0 0 1.7-1.5v-2a1.5 1.5 0 0 0-1.3-1.5l-2.5-.35a1.5 1.5 0 0 0-1.4.6l-.7.95a11.5 11.5 0 0 1-4.9-4.9l.95-.7a1.5 1.5 0 0 0 .6-1.4l-.35-2.5a1.5 1.5 0 0 0-1.5-1.3Z"/><path d="M14.5 3.6a5.5 5.5 0 0 1 4.9 4.9"/><path d="M14 7a2.4 2.4 0 0 1 2 2"/></svg>
            {SITE.tel}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Bloc 2 · Première section de fond (thème propre à la ville) ──── -->
  <section class="section section--gris">
    <div class="conteneur">
      <div class="section__entete">
        <h2>{v.sectionA.h2}</h2>
      </div>
      <div class="texte-long">
        {v.sectionA.paragraphes.map((p) => <p set:html={p} />)}
      </div>
    </div>
  </section>

  <!-- ── Bloc 3 · Encart Dalep : applicateur certifié ─────────────────── -->
  <section class="section">
    <div class="conteneur">
      <div class="dalep">
        <div class="dalep__badge">
          <img src="/images/labels/applicateur-dalep.webp" alt="Badge officiel d'applicateur certifié des solutions DALEP" width="240" height="240" loading="lazy" />
        </div>
        <div class="dalep__texte">
          <h2>Applicateur certifié de solutions Dalep</h2>
          <p>
            Les traitements que j'applique sur votre toiture ne viennent pas d'un rayon de grande
            surface : Dalep est un fabricant français de produits professionnels — antimousses,
            fongicides, hydrofuges — et je suis certifié pour les appliquer. Bon produit, bon
            dosage, bon support : c'est ce qui fait la différence entre un toit propre six mois
            et un toit protégé plusieurs années.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Bloc 4 · Section photo + texte (thème propre à la ville) ─────── -->
  <section class="section section--gris">
    <div class="conteneur duo-media">
      <div class="duo-media__texte">
        <h2>{v.sectionB.h2}</h2>
        {v.sectionB.paragraphes.map((p) => <p set:html={p} />)}
      </div>
      <img
        class="duo-media__photo"
        src={v.sectionB.photo.src}
        alt={v.sectionB.photo.alt}
        loading="lazy"
        width={v.sectionB.photo.largeur}
        height={v.sectionB.photo.hauteur}
      />
    </div>
  </section>

  <!-- ── Bloc 5 · Troisième section de fond ───────────────────────────── -->
  <section class="section">
    <div class="conteneur">
      <div class="section__entete">
        <h2>{v.sectionC.h2}</h2>
      </div>
      <div class="texte-long">
        {v.sectionC.paragraphes.map((p) => <p set:html={p} />)}
      </div>
    </div>
  </section>

  <!-- ── Bloc 6 · Le déroulé de l'intervention (4 étapes) ─────────────── -->
  <section class="section section--bleute">
    <div class="conteneur">
      <div class="section__entete">
        <h2>{v.etapesH2}</h2>
      </div>
      <div class="protocole">
        {v.etapes.map((e, i) => (
          <article class="protocole__etape">
            <div class="protocole__entete">
              <span class="protocole__num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{e.titre}</h3>
            </div>
            <p>{e.texte}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Bloc 7 · Le cocon : villes proches + retour pilier ───────────── -->
  <section class="section zone">
    <div class="conteneur">
      <div class="section__entete">
        <h2>{v.prochesH2}</h2>
      </div>
      <p class="zone__intro" set:html={v.prochesIntro} />
      <ul class="zone-villes">
        {proches.map((p) => (
          <li><a href={p.href}>{p.ancre}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── CTA devis final : version nettoyage (jamais de décennale) ────── -->
  <CtaDevis
    titre={v.ctaTitre}
    texte={v.ctaTexte}
    puces={[
      'Entreprise familiale, père & fils.',
      "Un travail d'artisan, mené avec exigence et passion.",
      'Applicateur certifié de solutions Dalep.',
    ]}
    image="/images/photos/toiture-mousse-a-nettoyer-28.webp"
    imageAlt="Toiture envahie par la mousse avant nettoyage par Renaud Rénov"
    imageWidth={1200}
    imageHeight={900}
  />
</BaseLayout>

<style>
  /* ══ Hero — design de la page d'accueil (repris de index.astro) ══ */
  .hx { padding-block: clamp(1.6rem, 4vw, 3rem); }
  .hx__grid {
    display: grid;
    gap: 1.6rem;
    grid-template-columns: 1fr;
    grid-template-areas: "head" "photo" "body";
  }
  @media (min-width: 980px) {
    .hx__grid {
      grid-template-columns: 1.05fr 1fr;
      grid-template-areas: "head photo" "body photo";
      column-gap: 3.5rem;
      row-gap: 1.1rem;
      align-items: center;
    }
  }
  .hx__head { grid-area: head; }
  .hx__right { grid-area: photo; position: relative; }
  .hx__right::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 42%;
    border-radius: 0 0 24px 24px;
    background: linear-gradient(to top, rgba(15, 34, 45, 0.6), rgba(15, 34, 45, 0));
    pointer-events: none;
    z-index: 1;
  }
  .hx__body { grid-area: body; }
  .hx__title { margin: 0; color: var(--bleu); font-size: var(--fs-h1-hero); line-height: 1.2; letter-spacing: -0.01em; }
  .hx__marque { color: var(--rouge); font-weight: 800; font-size: clamp(1.9rem, 4.4vw, 2.9rem); line-height: 1.1; margin: 0.6rem 0 0; }
  .hx__photo { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 24px; box-shadow: var(--ombre-forte); display: block; }
  @media (min-width: 980px) { .hx__photo { aspect-ratio: 4 / 5; } }

  .hx__chapo { color: var(--gris-700); margin: 0 0 1.2rem; max-width: var(--mesure-etroite); }
  .hx__chapo :global(strong) { color: var(--bleu); }

  .hx__points { list-style: none; padding: 0; margin: 0.4rem 0 1.2rem; display: grid; gap: 0.9rem; }
  .hx__points li {
    display: flex; align-items: center; gap: 0.8rem;
    font-size: var(--fs-md); font-weight: 600; color: var(--bleu);
  }
  .hx__check { color: var(--rouge); flex-shrink: 0; line-height: 0; }
  .hx__check svg { width: 30px; height: 30px; }

  .hx__note {
    position: absolute;
    left: 50%;
    bottom: 1rem;
    transform: translateX(-50%);
    width: max-content;
    max-width: calc(100% - 1.6rem);
    display: flex; flex-direction: column; align-items: center; gap: 0.3rem;
    background: var(--blanc);
    border-radius: 16px;
    box-shadow: 0 14px 34px rgba(15, 34, 45, 0.42);
    padding: 0.8rem 1.5rem;
    z-index: 2;
  }
  .hx__note-top { display: flex; align-items: center; gap: 0.6rem; }
  .hx__note-stars { display: inline-flex; gap: 0.1em; }
  .hx__note-stars svg { width: 1.35rem; height: 1.35rem; fill: var(--etoile); }
  .hx__note-txt { margin: 0; color: var(--gris-700); font-size: var(--fs-base); }
  .hx__note-txt strong { color: var(--bleu); }

  .hx__badges { display: flex; align-items: center; gap: 1.3rem; flex-wrap: wrap; margin: 0 0 1.6rem; }
  .hx__badges img { height: 64px; width: auto; }

  .hx__actions { display: flex; flex-wrap: wrap; gap: 0.8rem; }

  @media (max-width: 979px) {
    .hx__title, .hx__marque { text-align: center; }
    .hx__chapo { margin-inline: auto; } /* chapô long : reste en drapeau à gauche */
    .hx__badges, .hx__actions { justify-content: center; }
    .hx__badges img { height: 56px; }
  }

  /* ── Sections de fond : colonne de lecture confortable ── */
  .texte-long { max-width: var(--mesure-large); margin: 1.8rem auto 0; display: grid; gap: 1.1rem; }
  .texte-long p { margin: 0; color: var(--gris-700); line-height: 1.65; }

  /* ── Encart Dalep : badge à gauche, texte à droite, panneau marine ── */
  .dalep {
    display: grid;
    gap: 1.8rem;
    align-items: center;
    background: linear-gradient(160deg, #244B64 0%, #173445 100%);
    border-radius: var(--rayon);
    box-shadow: var(--ombre-forte);
    padding: clamp(1.8rem, 4.5vw, 2.8rem);
  }
  @media (min-width: 900px) {
    .dalep { grid-template-columns: auto 1fr; column-gap: 2.6rem; }
  }
  .dalep__badge {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff;
    border-radius: 18px;
    padding: 1.1rem;
    box-shadow: 0 10px 28px rgba(15, 34, 45, 0.35);
    justify-self: center;
  }
  .dalep__badge img { width: 130px; height: 130px; display: block; }
  .dalep__texte h2 { color: #fff; margin: 0 0 0.7rem; }
  .dalep__texte p { color: rgba(255, 255, 255, 0.88); margin: 0; max-width: var(--mesure-etroite); }
  @media (max-width: 899px) {
    .dalep__texte h2 { text-align: center; }
  }

  /* ── Duo photo + texte ── */
  .duo-media {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .duo-media { grid-template-columns: 1.15fr 0.85fr; column-gap: 3.2rem; }
  }
  .duo-media__texte h2 { color: var(--bleu); margin: 0 0 1rem; }
  .duo-media__texte p { color: var(--gris-700); margin: 0 0 0.9rem; line-height: 1.65; }
  .duo-media__texte p:last-child { margin-bottom: 0; }
  .duo-media__photo {
    width: 100%;
    max-height: 460px;
    object-fit: cover;
    border-radius: 20px;
    box-shadow: var(--ombre-forte);
    display: block;
  }

  /* ── Protocole : étapes numérotées, colonne unique (modèle pilier) ── */
  .protocole {
    display: grid;
    gap: 1.1rem;
    grid-template-columns: 1fr;
    max-width: var(--mesure);
    margin: 2.4rem auto 0;
  }
  .protocole__etape {
    background: #fff;
    border: 1px solid rgba(36, 75, 100, 0.08);
    border-radius: 18px;
    padding: 1.6rem 1.7rem;
    box-shadow: 0 10px 28px rgba(36, 75, 100, 0.09);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
  }
  .protocole__entete {
    display: flex;
    flex-direction: row;
    align-items: baseline;
    gap: 0.8rem;
  }
  .protocole__num {
    flex: 0 0 auto;
    font-size: var(--fs-xl);
    font-weight: 800;
    color: var(--rouge, #EF7E0F);
    line-height: 1;
  }
  .protocole__etape h3 { margin: 0; color: var(--bleu, #244B64); font-size: var(--fs-lg); }
  .protocole__etape p { margin: 0; color: var(--gris-700, #4b5563); }

  /* ── Le cocon : fond marine + cartes liens (modèle pilier) ── */
  .zone { background: linear-gradient(160deg, #244B64 0%, #173445 100%); }
  .zone .section__entete h2 { color: #fff; }
  .zone__intro {
    max-width: var(--mesure);
    margin: 0 auto;
    text-align: left;
    text-wrap: pretty;
    color: rgba(255, 255, 255, 0.9);
  }
  .zone__intro :global(a) { color: #ffb060; }
  .zone-villes {
    list-style: none;
    padding: 0;
    margin: 2.2rem 0 0;
    display: grid;
    gap: 0.9rem;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  }
  .zone-villes a {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    text-align: left;
    padding: 1.05rem 1.15rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 13px;
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }
  .zone-villes a:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: var(--rouge, #EF7E0F);
    transform: translateY(-2px);
  }

  /* ── Mesure de lecture ────────────────────────────────────────
     En dessous du seuil où ce bloc passe en deux colonnes, il occupe
     toute la largeur du conteneur et la ligne dépassait 90 caractères
     (le confort de lecture s'arrête vers 75). On borne la colonne. */
  .duo-media__texte p { max-width: var(--mesure); }
</style>
