---
// ─────────────────────────────────────────────────────────────────────────
// PILIER — Zinguerie en Eure-et-Loir (28).
// URL : /zinguerie-28/ (remplace /prestations/zinguerie/, 301 réelle).
// Brief client du 14/08/2026 : 9 blocs, 1300-1600 mots.
// Cocon COUVERTURE (zinguerie / réparation / rénovation / gouttière) —
// maillage prioritaire vers /reparation-toiture-28/, /renovation-toiture-28/
// et /prestations/pose-gouttiere/. Aucun lien vers le cocon nettoyage.
// Design = piliers /reparation-toiture-28/ et /renovation-toiture-28/
// (hero .hx problème → solution + coches, cartes savoir, témoins, atouts,
// CTA, protocole, prix, zone marine, FAQ).
// ─────────────────────────────────────────────────────────────────────────
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site.ts';
import villes from '../data/villes.json';
import reviews from '../data/reviews.json';
import FilAriane from '../components/FilAriane.astro';
import LogoGoogle from '../components/LogoGoogle.astro';
import CtaDevis from '../components/CtaDevis.astro';
import FlecheRonde from '../components/FlecheRonde.astro';
import PrestationsConnexes from '../components/PrestationsConnexes.astro';

// ── Balises — CORRECTION 14/08/2026 après retour Joseph. La 1re version
// avait un H1 « bénéfice » sans mot-clé (« Le zinc qui rend votre toiture
// réellement étanche ») : anti-triplette MAL appliquée, on avait retiré le
// mot-clé au lieu de VARIER la formulation. L'intention de recherche prime
// sur la créativité. Les 3 balises couvrent maintenant le champ visé —
// zinguerie 28, travaux de zinguerie, spécialiste / expert du zinc,
// couvreur-zingueur, Eure-et-Loir, entretien / réparation / rénovation —
// en trois formulations distinctes. Title 49 car. : pas de troncature. ──
const title = 'Zinguerie 28 | Spécialiste du zinc en Eure-et-Loir';
const description =
  "Noue percée, solin décollé, chéneau qui déborde ? Votre couvreur-zingueur en Eure-et-Loir répare et remplace vos ouvrages en zinc. Devis gratuit.";

// ── Bloc 3 : deux avis RÉELS (reviews.json). Aucun des 14 avis Google ne
// mentionne la zinguerie — arbitrage validé par Joseph le 14/08/2026 : on
// prend deux avis génériques encore inutilisés, sous un titre neutre, plutôt
// que d'inventer une mention de solin ou de noue. Aucun de ces avis ne cite
// de ville : pas de signature géographique. ──
const avisZinguerie = [
  { auteur: 'Olivier Ayrault', signature: 'Olivier A.' },
  { auteur: 'Gilli G.', signature: 'Gilli G.' },
]
  .map((s) => {
    const a = reviews.avis.find((r) => r.auteur === s.auteur);
    return a && { ...a, signature: s.signature };
  })
  .filter(Boolean);

// ── Bloc 7 : fourchettes de prix (repères marché — À VALIDER PAR JORDY) ──
const prix = [
  { presta: 'Solin de cheminée, pose ou reprise', fourchette: '250 à 600 €' },
  { presta: 'Noue en zinc, dépose et refaçonnage', fourchette: '80 à 150 €/ml' },
  { presta: 'Chéneau encastré ou apparent', fourchette: '100 à 200 €/ml' },
  { presta: 'Habillage de rive ou bande de rive', fourchette: '40 à 90 €/ml' },
];

// ── Bloc 6 : le déroulé d'une intervention en 4 étapes ──────────────────
const deroule = [
  {
    titre: 'Le diagnostic des points sensibles',
    texte:
      "Tout commence par la lecture du parcours de l'eau. Une auréole au plafond peut venir d'un solin décollé trois mètres plus haut, d'une noue dont le pli s'est ouvert ou d'un chéneau dont la soudure a lâché. J'inspecte les jonctions de pans, le tour des souches de cheminée, les rives, les abergements de vélux et le raccord avec les descentes, et je vous montre en photo ce que j'ai trouvé avant de chiffrer quoi que ce soit.",
  },
  {
    titre: 'La préparation et la dépose',
    texte:
      "On protège la zone, on dégage les tuiles ou les ardoises qui recouvrent l'ouvrage, puis on dépose les éléments hors d'usage : zinc percé par la corrosion, mortier de solin éclaté, ancien plomb fatigué. Le support est ensuite nettoyé et contrôlé : un liteau fatigué ou un about de chevron humide sous une noue se traite à ce stade, avant la repose du zinc.",
  },
  {
    titre: 'Le façonnage et la pose du zinc',
    texte:
      "Chaque pièce est tracée et pliée à la mesure du toit : relevés, pattes à tenon, joints debout ou agrafés, soudure à l'étain sur les raccords qui l'exigent. Le zinc est posé avec les jeux de dilatation nécessaires — c'est un métal qui travaille — et les recouvrements sont orientés dans le sens d'écoulement de l'eau. Sur un solin, la bande de zinc est engravée dans une saignée du mur puis scellée : c'est la mise en œuvre traditionnelle, celle qui traverse les décennies.",
  },
  {
    titre: "Le contrôle d'étanchéité et les finitions",
    texte:
      "Les tuiles ou les ardoises sont reposées, les closoirs remis en place, et je passe l'ouvrage à l'eau pour vérifier que tout s'évacue vers la gouttière sans stagner ni déborder en cas de forte pluie. Le chantier est nettoyé, les chutes de zinc emportées, et vous recevez la facture avec l'attestation de garantie décennale.",
  },
];

// ── Bloc 9 : FAQ (6 questions du brief) ─────────────────────────────────
const faq = [
  {
    q: "Qu'est-ce que la zinguerie, exactement ?",
    r: "C'est l'ensemble des ouvrages métalliques qui assurent l'étanchéité du toit là où la tuile et l'ardoise ne suffisent plus : la noue, ce V formé par la rencontre de deux pans ; le chéneau, ce canal encastré ou posé qui collecte l'eau ; le solin, qui ferme le joint entre le toit et un mur ou une souche de cheminée ; l'abergement, qui habille une pénétration comme un vélux ou un conduit ; la bavette et le noquet, ces petites pièces pliées qui conduisent l'eau d'un plan à l'autre. Le métal est le plus souvent du zinc, parfois du plomb sur les raccords qui demandent d'épouser une forme irrégulière.",
  },
  {
    q: 'Quand faut-il faire intervenir un zingueur ?',
    r: "Dès qu'une trace d'humidité apparaît sans que la couverture soit visiblement abîmée. Les signaux classiques : une auréole au plafond près d'une cheminée ou d'un mur mitoyen, des coulures rouille sur une façade sous une rive, une noue où la mousse et les feuilles s'accumulent parce que l'eau ne s'évacue plus, un chéneau qui déborde à chaque orage, du zinc qui se soulève ou se perce au niveau des soudures. En prévention, un simple contrôle visuel des points singuliers tous les deux ou trois ans suffit à prendre les choses à temps.",
  },
  {
    q: 'Peut-on réparer uniquement un solin ou une noue ?',
    r: "Oui, et c'est même le cas le plus fréquent. Un solin se reprend seul : on dégarnit l'ancien joint, on engrave une bande neuve dans la maçonnerie et on rehabille. Une noue peut être refaite sur un linéaire limité en déposant les rangs de tuiles qui la bordent. La seule vraie question est l'état du reste de l'ouvrage : refaire un mètre de noue en zinc neuf au milieu de six mètres de zinc corrodé, c'est repayer l'échafaudage dans deux ans. Je vous le dis franchement au moment du diagnostic, et vous décidez.",
  },
  {
    q: 'Travaillez-vous le zinc en neuf comme en rénovation ?',
    r: "Les deux. En neuf, la zinguerie se pose en même temps que la couverture, ce qui permet de traiter chaque point singulier proprement dès le départ — c'est ce que nous faisons sur les chantiers de réfection complète. En rénovation, il s'agit de remplacer un ouvrage existant fatigué en s'adaptant à ce qui est déjà en place : pente réelle du toit, maçonnerie ancienne, tuile plate ou ardoise, écart de teinte entre un zinc neuf et un zinc patiné. C'est souvent plus exigeant que le neuf.",
  },
  {
    q: 'Quel est le prix moyen de travaux de zinguerie dans le 28 ?',
    r: "Comptez 250 à 600 € pour un solin de cheminée posé ou repris, 80 à 150 €/ml pour une noue en zinc, 100 à 200 €/ml pour un chéneau et 40 à 90 €/ml pour un habillage de rive. Ces montants comprennent la dépose de l'existant, le façonnage, la pose et l'évacuation. Ils varient surtout selon l'accessibilité — un échafaudage change vite l'équation —, le linéaire à traiter, la complexité des raccords et l'état de ce qu'on trouve dessous. Le diagnostic et le devis sont gratuits.",
  },
  {
    q: 'La zinguerie est-elle liée aux gouttières ou à une rénovation de toiture ?',
    r: "Elle est au carrefour des deux. En bas de pente, la zinguerie se raccorde directement aux gouttières et aux descentes : une bavette mal posée fait passer l'eau derrière la gouttière, et c'est la façade qui prend. En haut de chaîne, tout chantier de réfection reprend l'intégralité des ouvrages de zinc, puisque le toit est de toute façon ouvert. Et entre les deux, la plupart des fuites traitées en réparation de toiture ont pour origine un point de zinguerie.",
  },
];

// ── Bloc 8 : les 14 communes — ancres enrichies « zinguerie / zingueur »
// sur les principales, plus techniques ailleurs. ──
const zoneEnrichie = [
  { slug: 'villiers-le-morhier', ancre: 'la zinguerie à Villiers-le-Morhier, notre commune' },
  { slug: 'maintenon', ancre: 'votre couvreur-zingueur à Maintenon' },
  { slug: 'nogent-le-roi', ancre: 'solins et noues à Nogent-le-Roi' },
  { slug: 'epernon', ancre: 'les travaux de zinguerie à Épernon' },
  { slug: 'hanches', ancre: 'chéneaux et rives à Hanches' },
  { slug: 'gallardon', ancre: 'votre zingueur à Gallardon' },
  { slug: 'pierres', ancre: 'habillages en zinc à Pierres' },
  { slug: 'saint-piat', ancre: 'solin de cheminée à Saint-Piat' },
  { slug: 'bouglainval', ancre: 'travaux de zinc à Bouglainval' },
  { slug: 'chartres', ancre: 'la zinguerie à Chartres' },
  { slug: 'dreux', ancre: 'votre couvreur-zingueur à Dreux' },
  { slug: 'auneau', ancre: 'noues et abergements à Auneau' },
  { slug: 'rambouillet', ancre: 'les travaux de zinguerie à Rambouillet' },
  { slug: 'houdan', ancre: 'votre zingueur à Houdan' },
];
const villeParSlug = Object.fromEntries(villes.map((v) => [v.slug, v]));

// ── Schémas : Service rattaché au LocalBusiness + FAQPage ───────────────
const businessId = `${SITE.url}/#localbusiness`;
const schemaService = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${SITE.url}/zinguerie-28/#service`,
  serviceType: 'Zinguerie de toiture',
  name: 'Zinguerie en Eure-et-Loir',
  description:
    "Façonnage et pose de noues, chéneaux, solins de cheminée, abergements, bandes de rive, bavettes et noquets en zinc, par un couvreur-zingueur d'Eure-et-Loir.",
  provider: { '@id': businessId },
  areaServed: {
    '@type': 'AdministrativeArea',
    name: `${SITE.departement} (${SITE.departementNum})`,
  },
  offers: { '@type': 'Offer', priceCurrency: 'EUR', availability: 'https://schema.org/InStock' },
};

const schemaFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.r },
  })),
};
---
<BaseLayout title={title} description={description}
  lcpImage="/images/photos/zinguerie-epi.webp"
  lcpSrcset="/images/photos/zinguerie-epi-640.webp 640w, /images/photos/zinguerie-epi-960.webp 960w, /images/photos/zinguerie-epi.webp 1200w"
  lcpSizes="(min-width: 980px) 46vw, calc(100vw - 2rem)" extraSchemas={[schemaService, schemaFaq]}>
  <!-- ── Bloc 1 · Hero ────────────────────────────────────────────────── -->
  <section class="section section--sans-bas">
    <div class="conteneur">
      <FilAriane items={[{ label: 'Accueil', href: '/' }, { label: 'Zinguerie' }]} />
    </div>
  </section>
  <section class="hx">
    <div class="conteneur hx__grid">
      <div class="hx__head">
        <h1 class="hx__title">Travaux de zinguerie dans le 28&nbsp;: entretien, réparation, rénovation</h1>
        <p class="hx__marque">RENAUD RÉNOV</p>
      </div>

      <div class="hx__right">
        <img
          class="hx__photo"
          src="/images/photos/zinguerie-epi.webp"
          srcset="/images/photos/zinguerie-epi-640.webp 640w, /images/photos/zinguerie-epi-960.webp 960w, /images/photos/zinguerie-epi.webp 1200w"
          sizes="(min-width: 980px) 46vw, calc(100vw - 2rem)"
          alt="Épi de faîtage et arêtier habillés en zinc par Renaud Rénov sur une toiture en ardoise d'Eure-et-Loir"
          fetchpriority="high"
          width="1200"
          height="900"
          decoding="async"
        />
        <div class="hx__note">
          <div class="hx__note-top">
            <LogoGoogle taille={26} />
            <span class="hx__note-stars" aria-label={`${reviews.note} étoiles sur 5`}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg>
            </span>
          </div>
          <p class="hx__note-txt">Noté <strong>{reviews.note.toLocaleString('fr-FR')}/5</strong> sur Google · {reviews.nombre} avis</p>
        </div>
      </div>

      <div class="hx__body">
        <p class="hx__chapo">
          Une tache au plafond près de la cheminée, une noue qui déborde, un chéneau percé par la
          corrosion&nbsp;? Sur une toiture, l'étanchéité se joue surtout aux raccords, là où
          travaillent les ouvrages métalliques. Je suis M.&nbsp;Renaud et, avec mon entreprise Renaud
          Rénov, j'assure l'<strong>entretien, la réparation et la rénovation de vos éléments de
          zinguerie</strong> — noues, chéneaux, solins, abergements, bandes de rive — partout en
          <strong>Eure-et-Loir</strong>, en neuf comme en rénovation.
        </p>

        <ul class="hx__points">
          <li>
            <span class="hx__check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M8 12.5l2.5 2.5 5-6"/></svg></span>
            Couvreur-zingueur depuis plus de 15 ans dans le 28
          </li>
          <li>
            <span class="hx__check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M8 12.5l2.5 2.5 5-6"/></svg></span>
            Zinc façonné sur mesure, à la cote de votre toit
          </li>
          <li>
            <span class="hx__check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M8 12.5l2.5 2.5 5-6"/></svg></span>
            Solins engravés et scellés dans la maçonnerie
          </li>
          <li>
            <span class="hx__check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M8 12.5l2.5 2.5 5-6"/></svg></span>
            Devis détaillé gratuit et garantie décennale
          </li>
        </ul>

        <div class="hx__badges">
          <img src="/images/labels/garantie-decennale-10-ans.webp" alt="Travaux couverts par la garantie décennale" width="240" height="240" loading="lazy" />
          <img src="/images/labels/artisan-cma28.webp" alt="Artisan inscrit à la Chambre de Métiers et de l'Artisanat d'Eure-et-Loir" width="320" height="228" loading="lazy" />
        </div>

        <div class="hx__actions">
          <a href="/devis-gratuit/" class="btn btn--rouge">Devis gratuit<FlecheRonde /></a>
          <a href={SITE.telHref} class="btn btn--bleu">
            <svg class="icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 3.5h-2A1.5 1.5 0 0 0 3 5.2C3.4 13 11 20.6 18.8 21a1.5 1.5 0 0 0 1.7-1.5v-2a1.5 1.5 0 0 0-1.3-1.5l-2.5-.35a1.5 1.5 0 0 0-1.4.6l-.7.95a11.5 11.5 0 0 1-4.9-4.9l.95-.7a1.5 1.5 0 0 0 .6-1.4l-.35-2.5a1.5 1.5 0 0 0-1.5-1.3Z"/><path d="M14.5 3.6a5.5 5.5 0 0 1 4.9 4.9"/><path d="M14 7a2.4 2.4 0 0 1 2 2"/></svg>
            {SITE.tel}
          </a>
        </div>
        <p class="hx__cta-sub">
          L'eau entre déjà chez vous&nbsp;? Passez d'abord par la
          <a href="/reparation-toiture-28/">réparation de toiture</a> et sa ligne urgence.
        </p>
      </div>
    </div>
  </section>

  <!-- ── Bloc 2 · H2 services + 4 H3 techniques ───────────────────────── -->
  <section class="section section--gris">
    <div class="conteneur">
      <div class="section__entete">
        <h2>Le spécialiste de la zinguerie en Eure-et-Loir&nbsp;: noues, chéneaux, solins</h2>
      </div>

      <div class="savoir">
        <!-- 1 · Noues et chéneaux -->
        <article class="savoir-carte">
          <div class="savoir-carte__media">
            <img
              src="/images/photos/zinguerie-aretier.webp"
              alt="Chéneau en zinc courant le long d'un acrotère, réalisé par Renaud Rénov en Eure-et-Loir"
              loading="lazy" width="1200" height="1600"
            />
          </div>
          <div class="savoir-carte__texte">
            <h3>Noues et chéneaux</h3>
            <p>
              La <strong>noue</strong> est le point le plus sollicité d'un toit&nbsp;: c'est là que se
              rejoignent deux pans et que toute leur eau transite d'un coup. Je la réalise ou la
              reprends en zinc, avec des relevés suffisants sous les tuiles et une pente régulière qui
              évite les stagnations. Même exigence pour les <strong>chéneaux</strong>, encastrés
              derrière un mur d'acrotère ou apparents en pied de pente&nbsp;: section calculée pour le
              débit réel du toit, joints de dilatation, soudure propre aux jonctions. Une noue
              ouverte ou un chéneau percé, c'est la cause n°1 des fuites que je traite en
              <a href="/reparation-toiture-28/">réparation de toiture</a>.
            </p>
          </div>
        </article>

        <!-- 2 · Solins et abergements (carte marine, image à droite) -->
        <article class="savoir-carte savoir-carte--inverse savoir-carte--marine">
          <div class="savoir-carte__media">
            <img
              src="/images/photos/couvreur-zingueur-28.webp"
              alt="Arêtier habillé en zinc au contact d'une souche de cheminée en brique, en Eure-et-Loir"
              loading="lazy" width="900" height="1200"
            />
          </div>
          <div class="savoir-carte__texte">
            <h3>Solins et abergements de cheminée</h3>
            <p>
              Le raccord entre un toit et une maçonnerie est un point critique&nbsp;: la souche de
              cheminée, le mur mitoyen, la sortie de VMC, l'abergement de vélux. J'y pose des
              <strong>solins</strong> en zinc, en plomb — plus souple, il épouse une pierre
              irrégulière — ou combinés, toujours <strong>engravés et scellés dans la maçonnerie</strong>,
              comme le veut la mise en œuvre traditionnelle. Autour des souches, un abergement
              complet ceinture le conduit et renvoie l'eau sur la couverture. C'est le soin apporté
              à ces détails qui fait tenir une toiture dans la durée, y compris après une
              <a href="/renovation-toiture-28/">rénovation de toiture</a>.
            </p>
          </div>
        </article>

        <!-- 3 · Rives, bandes de rive et faîtage -->
        <article class="savoir-carte">
          <div class="savoir-carte__media">
            <img
              src="/images/photos/gouttiere-descente.webp"
              alt="Rive de toiture habillée et descente en zinc posées sur un pignon par Renaud Rénov en Eure-et-Loir"
              loading="lazy" width="1600" height="1200"
            />
          </div>
          <div class="savoir-carte__texte">
            <h3>Habillages de rives, bandes de rive et faîtage</h3>
            <p>
              En bord de toit, le vent s'engouffre et la pluie fouette&nbsp;: c'est le rôle de la
              <strong>bande de rive</strong> et de l'habillage de planche de rive de fermer
              proprement l'ouvrage tout en laissant la sous-toiture respirer. Au sommet, les
              <strong>closoirs</strong> ventilés et les pièces de faîtage en zinc — jusqu'à l'épi,
              quand la maison le mérite — assurent la même fonction. Sur les toitures en tuile plate
              petit moule et en ardoise du département, ces finitions se voient depuis la rue&nbsp;:
              elles doivent être aussi nettes qu'étanches.
            </p>
          </div>
        </article>

        <!-- 4 · Raccords, bavettes et évacuations (image à droite) -->
        <article class="savoir-carte savoir-carte--inverse">
          <div class="savoir-carte__media">
            <img
              src="/images/photos/gouttiere-zinc.webp"
              alt="Chéneau métallique recueillant l'eau en pied de toiture, posé par Renaud Rénov en Eure-et-Loir"
              loading="lazy" width="1200" height="1600"
            />
          </div>
          <div class="savoir-carte__texte">
            <h3>Raccords, bavettes et évacuations</h3>
            <p>
              Entre deux ouvrages, il reste toujours des pièces à façonner sur mesure&nbsp;: la
              <strong>bavette</strong> qui renvoie l'eau d'un pan sur l'autre, le
